<% if (typeof activeDeliveries !== 'undefined' && activeDeliveries.length) { %>
<div class="card shadow-sm mb-3">
  <div class="card-body">
    <h6 class="mb-3">📍 Live Deliveries (<%= activeDeliveries.length %>)</h6>
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead class="small text-muted">
          <tr>
            <th>#</th>
            <th>Rider</th>
            <th>Customer</th>
            <th>Status</th>
            <th>Fee</th>
          </tr>
        </thead>
        <tbody class="small">
          <% activeDeliveries.slice(0, 6).forEach(function(d) { %>
            <tr>
              <td><a href="/owner/deliveries/<%= d.id %>">#<%= d.id %></a></td>
              <td><%= d.rider_name || '—' %></td>
              <td class="text-truncate" style="max-width: 120px;"><%= d.customer_name || '—' %></td>
              <td>
                <span class="badge bg-<%= 
                  d.status === 'delivered' ? 'success' : 
                  d.status === 'cancelled' ? 'secondary' : 
                  d.status === 'picked_up' || d.status === 'in_transit' ? 'primary' : 'info'
                %>"><%= d.status %></span>
              </td>
              <td><%= d.final_fee || d.negotiated_fee || d.quoted_fee || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% if (activeDeliveries.length > 6) { %>
      <a href="/owner/deliveries" class="small d-block mt-2 text-center">View all <%= activeDeliveries.length %> →</a>
    <% } %>
  </div>
</div>
<% } %>
