<%- include('../layouts/main') %>

<style>
.page-header {
  background: linear-gradient(135deg, #0c4a6e, #0284c7);
  color: white;
  padding: 25px 0;
  margin-bottom: 30px;
}
.page-header h1 { color: white; font-weight: 800; margin: 0; }
.page-header .sub { color: rgba(255,255,255,0.9); margin-top: 4px; }

.settings-card {
  background: white;
  border-radius: 16px;
  padding: 30px;
  border: 1px solid #e0f2fe;
  box-shadow: 0 4px 15px rgba(2,132,199,0.08);
  margin-bottom: 24px;
}
.settings-card h5 {
  color: #0c4a6e;
  font-weight: 800;
  padding-bottom: 12px;
  border-bottom: 2px solid #e0f2fe;
  margin-bottom: 20px;
}
</style>

<div class="page-header">
  <div class="container">
    <h1><i class="fas fa-cog me-2"></i>Settings</h1>
    <div class="sub">Manage your company information</div>
  </div>
</div>

<div class="container pb-5">
  <%- include('../partials/flash') %>

  <div class="mb-3">
    <a href="/owner" class="btn btn-sm btn-outline-secondary rounded-pill">
      <i class="fas fa-arrow-left me-1"></i>Dashboard
    </a>
  </div>

  <div class="row g-4">
    <div class="col-lg-6">
      <div class="settings-card">
        <h5><i class="fas fa-building me-2"></i>Company Info</h5>
        <form method="POST" action="/owner/settings">
          <div class="mb-3">
            <label class="form-label fw-bold">Company Name</label>
            <input type="text" name="company_name" class="form-control"
                   value="<%= owner.company_name || '' %>" required maxlength="150">
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Contact Name</label>
            <input type="text" name="contact_name" class="form-control"
                   value="<%= owner.contact_name || '' %>" required maxlength="100">
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold">Phone</label>
              <input type="tel" name="phone" class="form-control"
                     value="<%= owner.phone || '' %>" maxlength="20">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">City</label>
              <input type="text" name="city" class="form-control"
                     value="<%= owner.city || 'Nairobi' %>" maxlength="100">
            </div>
          </div>
          <div class="mb-3 mt-3">
            <label class="form-label fw-bold">Address</label>
            <input type="text" name="address" class="form-control"
                   value="<%= owner.address || '' %>" maxlength="255">
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Email (read-only)</label>
            <input type="email" class="form-control" value="<%= owner.email %>" readonly disabled>
          </div>
          <button type="submit" class="ss-btn w-100">
            <i class="fas fa-save me-2"></i>Save Changes
          </button>
        </form>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="settings-card">
        <h5><i class="fas fa-lock me-2"></i>Change Password</h5>
        <form method="POST" action="/owner/settings/password">
          <div class="mb-3">
            <label class="form-label fw-bold">Current Password</label>
            <input type="password" name="current_password" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">New Password</label>
            <input type="password" name="new_password" class="form-control" required minlength="6">
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Confirm New Password</label>
            <input type="password" name="confirm_password" class="form-control" required minlength="6">
          </div>
          <button type="submit" class="ss-btn w-100" style="background:#ef4444;">
            <i class="fas fa-key me-2"></i>Change Password
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>