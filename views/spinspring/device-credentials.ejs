<%- include('../layouts/main') %>
<style>
.ss-nav { background: linear-gradient(135deg, #0284c7, #0ea5e9); padding: 15px 0; }
.ss-nav a { color: white !important; text-decoration: none; }
.ss-card {
  background: white;
  border-radius: 20px;
  padding: 35px;
  box-shadow: 0 10px 40px rgba(2,132,199,0.15);
  border: 1px solid #e0f2fe;
}
.credential-box {
  background: #f0f9ff;
  border: 1px solid #bae6fd;
  border-radius: 10px;
  padding: 15px;
  margin-bottom: 15px;
  font-family: monospace;
  font-size: 0.85rem;
  word-break: break-all;
}
.credential-label {
  font-weight: 700;
  color: #0c4a6e;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 5px;
}
</style>
</head>
<body>
<nav class="ss-nav">
  <div class="container">
    <a href="/spinspg/dashboard"><i class="fas fa-arrow-left me-2"></i> Back to Dashboard</a>
  </div>
</nav>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="ss-card text-center">
        <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
        <h2 style="color:#0c4a6e;">Machine Registered!</h2>
        <p class="text-muted mb-4">Configure your ESP32 with these credentials:</p>

        <div class="text-start">
          <div class="credential-label">Device Name</div>
          <div class="credential-box"><%= device.device_name %></div>

          <div class="credential-label">Device ID</div>
          <div class="credential-box"><%= device.device_id %></div>

          <div class="credential-label">API Key</div>
          <div class="credential-box"><%= device.api_key %></div>

          <div class="credential-label">API Sync URL</div>
          <div class="credential-box">https://ardthonsolutions.com/spinspg/api/sync</div>
        </div>

        <div class="alert alert-warning mt-4 text-start">
          <i class="fas fa-exclamation-triangle me-2"></i>
          <strong>Important:</strong> Save these credentials now. The API Key cannot be viewed again.
        </div>

        <div class="d-flex gap-2 mt-3">
          <button onclick="copyCredentials()" class="btn btn-outline-primary flex-fill rounded-pill" style="border-color:#0284c7;color:#0284c7;">
            <i class="fas fa-copy me-2"></i> Copy All
          </button>
          <a href="/spinspg/dashboard" class="btn btn-primary flex-fill rounded-pill" style="background:#0284c7;border:none;">
            <i class="fas fa-tachometer-alt me-2"></i> Go to Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function copyCredentials() {
  var text = "Device Name: <%= device.device_name %>\nDevice ID: <%= device.device_id %>\nAPI Key: <%= device.api_key %>\nAPI URL: https://ardthonsolutions.com/spinspg/api/sync";
  navigator.clipboard.writeText(text).then(function() {
    alert('Credentials copied to clipboard!');
  }).catch(function() {
    prompt('Copy credentials:', text);
  });
}
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>