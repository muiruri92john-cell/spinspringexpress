<%- include('../layouts/main') %>
<style>
.ss-auth {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  padding: 20px;
}
.ss-auth-card {
  background: white;
  border-radius: 25px;
  padding: 40px;
  box-shadow: 0 25px 60px rgba(245,158,11,0.3);
  max-width: 420px;
  width: 100%;
}
</style>
</head>
<body>
<div class="ss-auth">
  <div class="ss-auth-card">
    <div class="text-center mb-4">
      <i class="fas fa-id-card fa-4x" style="color:#f59e0b;"></i>
      <h3 class="mt-2 fw-bold">Customer Login</h3>
      <p class="text-muted">Enter your Customer ID</p>
    </div>
    <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>
    <form action="/spinspg/customer-login" method="POST">
      <div class="mb-3">
        <label class="form-label fw-bold">Customer ID</label>
        <input type="text" name="customer_id" class="form-control" placeholder="CUST-XXXX-XXXX" required>
      </div>
      <button type="submit" class="btn btn-warning w-100 py-3 fw-bold rounded-pill">
        <i class="fas fa-sign-in-alt me-2"></i> Login
      </button>
    </form>
    <div class="text-center mt-3">
      <a href="/spinspg/login" class="text-muted">Owner Login</a> |
      <a href="/spinspg/attendant-login" class="text-muted">Attendant Login</a>
    </div>
  </div>
</div>
</body>
</html>