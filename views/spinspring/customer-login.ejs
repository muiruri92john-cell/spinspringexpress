<%- include('../layouts/main') %>

<style>
.auth-wrapper {
  min-height: 90vh;
  background: linear-gradient(135deg, #fffbeb, #fef3c7);
  padding: 40px 15px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.auth-card {
  background: white;
  border-radius: 24px;
  padding: 40px;
  max-width: 460px;
  width: 100%;
  box-shadow: 0 25px 60px rgba(245,158,11,0.2);
}
.auth-card h2 { color: #92400e; font-weight: 800; text-align: center; margin-bottom: 8px; }
.auth-card .sub { text-align: center; color: #64748b; margin-bottom: 30px; }
.auth-icon {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  color: white;
  font-size: 2rem;
}
</style>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-icon">
      <i class="fas fa-id-card"></i>
    </div>

    <h2>Customer Login</h2>
    <p class="sub">Track your orders and place new ones</p>

    <%- include('../partials/flash') %>

    <form method="POST" action="/customer-login">
      <div class="mb-3">
        <label class="form-label fw-bold">Email Address</label>
        <input type="email" name="email" class="form-control" required
               placeholder="you@example.com" autocomplete="email">
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Password</label>
        <input type="password" name="password" class="form-control" required
               placeholder="••••••••" autocomplete="current-password">
      </div>

      <button type="submit" class="ss-btn w-100" style="padding:14px; background:#f59e0b;">
        <i class="fas fa-sign-in-alt me-2"></i>Login
      </button>
    </form>

    <div class="text-center mt-4 pt-3" style="border-top:1px solid #f1f5f9;">
      <a href="/login" class="text-muted small me-3">
        <i class="fas fa-store me-1"></i>Owner Login
      </a>
      <a href="/attendant-login" class="text-muted small">
        <i class="fas fa-user-tie me-1"></i>Attendant Login
      </a>
    </div>

    <div class="text-center mt-3">
      <a href="/" class="text-muted small">
        <i class="fas fa-arrow-left me-1"></i>Back to home
      </a>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>