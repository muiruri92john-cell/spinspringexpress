<%- include('../layouts/main') %>

<style>
/* ===== NAVIGATION ===== */
.ss-nav {
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  padding: 15px 0;
}

.ss-nav a {
  color: white !important;
  text-decoration: none;
}

/* ===== CARDS ===== */
.ss-card {
  background: white;
  border-radius: 20px;
  padding: 25px;
  box-shadow: 0 5px 25px rgba(2, 132, 199, 0.1);
  border: 1px solid #e0f2fe;
  margin-bottom: 20px;
}

.ss-card .section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 1.1rem;
  font-weight: 700;
  color: #0c4a6e;
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 2px solid #e0f2fe;
}

/* ===== STATUS BADGES ===== */
.status-badge {
  padding: 5px 15px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 700;
}

.status-idle { background: #e0f2fe; color: #0284c7; }
.status-running { background: #d1fae5; color: #065f46; }
.status-paused { background: #fef3c7; color: #92400e; }
.status-maintenance { background: #fee2e2; color: #991b1b; }
.status-offline { background: #e2e8f0; color: #475569; }

/* ===== WEIGHT INFO BOX ===== */
.weight-info-box {
  background: #f0f9ff;
  border: 1px solid #bae6fd;
  border-radius: 12px;
  padding: 15px;
  margin-top: 15px;
}

/* ===== STAT BOXES ===== */
.ss-stat {
  background: #f0f9ff;
  border-radius: 12px;
  padding: 15px;
  text-align: center;
}

.ss-stat .value {
  font-size: 1.5rem;
  font-weight: 800;
  color: #0284c7;
}

.ss-stat .label {
  font-size: 0.75rem;
  color: #64748b;
  margin-top: 4px;
}

/* ===== TABS ===== */
.nav-tabs .nav-link {
  color: #64748b;
  font-weight: 600;
  border: none;
  border-bottom: 3px solid transparent;
}

.nav-tabs .nav-link.active {
  color: #0284c7;
  border-bottom-color: #0284c7;
  background: transparent;
}

.nav-tabs .nav-link:hover {
  color: #0284c7;
  border-color: transparent;
  border-bottom-color: #bae6fd;
}

/* ===== FORM CONTROLS ===== */
.cp-param {
  font-size: 0.9rem;
}

.form-label.fw-bold {
  font-size: 0.85rem;
  color: #0c4a6e;
}

/* ===== HEARTBEAT BADGE ===== */
#heartbeatBadge {
  font-size: 0.7rem;
  padding: 5px 12px;
  border-radius: 20px;
}

/* ===== PULSE LOG TABLE ===== */
#cpPulseLog td {
  font-size: 0.8rem;
  vertical-align: middle;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
  .ss-card {
    padding: 18px;
  }
  .ss-stat .value {
    font-size: 1.2rem;
  }
}
</style>

<!-- ===== NAVIGATION ===== -->
<nav class="ss-nav">
  <div class="container d-flex justify-content-between align-items-center">
    <a href="/spinspg/dashboard">
      <i class="fas fa-arrow-left me-2"></i> Back
    </a>
    <button class="btn btn-light btn-sm rounded-pill" id="refreshBtn">
      <i class="fas fa-sync-alt me-1"></i> Refresh
    </button>
  </div>
</nav>

<div class="container py-4">
  <%- include('../partials/flash') %>

  <!-- ===== DEVICE HEADER ===== -->
  <div class="mb-4">
    <h2 style="color:#0c4a6e;"><%= device.device_name %></h2>
    <span class="status-badge status-<%= device.status %>"><%= device.status %></span>
    <small class="text-muted ms-2"><%= device.device_id %></small>
  </div>

  <!-- ===== QUICK STATS ===== -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="ss-card text-center mb-0">
        <div class="h3 fw-bold" style="color:#0284c7;"><%= device.cycle_progress || 0 %>%</div>
        <small class="text-muted">Cycle Progress</small>
      </div>
    </div>
    <div class="col-md-3">
      <div class="ss-card text-center mb-0">
        <div class="h3 fw-bold"><%= device.current_cycle || 'N/A' %></div>
        <small class="text-muted">Current Cycle</small>
      </div>
    </div>
    <div class="col-md-3">
      <div class="ss-card text-center mb-0">
        <div class="h3 fw-bold"><%= device.cycles_completed %></div>
        <small class="text-muted">Total Cycles</small>
      </div>
    </div>
    <div class="col-md-3">
      <div class="ss-card text-center mb-0">
        <div class="h3 fw-bold text-success">Ksh <%= device.today_revenue %></div>
        <small class="text-muted">Today Revenue</small>
      </div>
    </div>
  </div>

  <!-- ============ MACHINE CONTROL PANEL ============ -->
  <div class="ss-card" id="machineControlPanel">
    <div class="section-title">
      <span><i class="fas fa-sliders-h me-2"></i>Machine Control Panel</span>
      <span id="heartbeatBadge" class="badge bg-secondary">Checking...</span>
    </div>

    <input type="hidden" id="cpDeviceId" value="<%= device.device_id %>">

    <!-- Machine State Row -->
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="ss-stat">
          <div class="value" id="cpCurrentCredit">0</div>
          <div class="label">Credit (minutes)</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="ss-stat">
          <div class="value" id="cpState">idle</div>
          <div class="label">State</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="ss-stat">
          <div class="value" id="cpBattery">0V</div>
          <div class="label">Battery</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="ss-stat">
          <div class="value" id="cpSignal">-</div>
          <div class="label">Signal</div>
        </div>
      </div>
    </div>

    <!-- Param Tabs -->
    <ul class="nav nav-tabs mb-3" role="tablist">
      <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabPulse">⚡ Pulse</a></li>
      <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabCredit">💰 Credit</a></li>
      <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabTiming">⏱️ Timing</a></li>
      <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabDispense">📤 Dispense</a></li>
      <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabHistory">📜 History</a></li>
    </ul>

    <div class="tab-content">
      <!-- PULSE TAB -->
      <div class="tab-pane fade show active" id="tabPulse">
        <div class="alert alert-info small">
          <i class="fas fa-info-circle me-1"></i>
          Pulse settings control how the relay fires to signal the washing machine.
        </div>
        <form id="paramsPulseForm">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label fw-bold">Pulses per Credit</label>
              <input type="number" name="pulses_per_credit" class="form-control cp-param" min="1" max="10" value="1">
              <small class="text-muted">How many relay pulses = 1 credit unit</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Pulse Width (ms)</label>
              <input type="number" name="pulse_width_ms" class="form-control cp-param" min="20" max="500" value="100">
              <small class="text-muted">How long relay stays ON (50-200ms typical)</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Pulse Gap (ms)</label>
              <input type="number" name="pulse_gap_ms" class="form-control cp-param" min="20" max="500" value="100">
              <small class="text-muted">Delay between pulses (50-300ms typical)</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Start Pulse Duration (ms)</label>
              <input type="number" name="start_pulse_duration_ms" class="form-control cp-param" min="100" max="2000" value="500">
              <small class="text-muted">Separate START signal duration</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Cooldown Period (sec)</label>
              <input type="number" name="cooldown_period_sec" class="form-control cp-param" min="5" max="600" value="30">
              <small class="text-muted">Lockout before next command accepted</small>
            </div>
          </div>
        </form>
      </div>

      <!-- CREDIT TAB -->
      <div class="tab-pane fade" id="tabCredit">
        <form id="paramsCreditForm">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label fw-bold">Run Time per Credit (min)</label>
              <input type="number" name="run_time_per_credit_min" class="form-control cp-param" min="1" max="60" value="15">
              <small class="text-muted">Minutes of wash per credit</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Max Credit Cap (min)</label>
              <input type="number" name="max_credit_minutes" class="form-control cp-param" min="1" max="1440" value="99">
              <small class="text-muted">Upper limit machine will accept</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Min Credit to Start</label>
              <input type="number" name="min_credit_to_start" class="form-control cp-param" min="1" max="100" value="1">
              <small class="text-muted">Required before cycle can begin</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Accumulation Logic</label>
              <select name="accumulate_payments" class="form-select cp-param">
                <option value="1">Stack (multiple payments add time)</option>
                <option value="0">Single (one payment = one cycle)</option>
              </select>
            </div>
          </div>
        </form>
      </div>

      <!-- DISPENSE TAB -->
      <div class="tab-pane fade" id="tabDispense">
        <div class="alert alert-warning small">
          <i class="fas fa-exclamation-triangle me-1"></i>
          Credits will be queued and applied on next device sync.
        </div>
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label fw-bold">Credits to Add</label>
            <input type="number" id="dispenseCredits" class="form-control" min="1" max="99" value="1">
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Reason</label>
            <select id="dispenseReason" class="form-select">
              <option value="manual">Manual (attendant)</option>
              <option value="payment">Payment received</option>
              <option value="refund">Refund</option>
              <option value="test">Test</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Order # (optional)</label>
            <input type="text" id="dispenseOrder" class="form-control" placeholder="SS-XXXX">
          </div>
        </div>
        <button class="btn btn-success rounded-pill mt-3" id="dispenseBtn">
          <i class="fas fa-bolt me-2"></i> Queue Dispense
        </button>
      </div>

      <!-- TIMING TAB -->
      <div class="tab-pane fade" id="tabTiming">
        <div class="alert alert-info small">
          <i class="fas fa-clock me-1"></i>
          Timing settings control cycle duration and heartbeat intervals.
        </div>
        <form id="paramsTimingForm">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label fw-bold">Heartbeat Interval (sec)</label>
              <input type="number" name="heartbeat_interval_sec" class="form-control cp-param" min="10" max="600" value="60">
              <small class="text-muted">How often device reports status</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Cycle Duration (min)</label>
              <input type="number" name="cycle_duration_min" class="form-control cp-param" min="1" max="180" value="45">
              <small class="text-muted">Default wash cycle length</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Rinse Duration (min)</label>
              <input type="number" name="rinse_duration_min" class="form-control cp-param" min="1" max="60" value="10">
              <small class="text-muted">Rinse phase duration</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Spin Duration (min)</label>
              <input type="number" name="spin_duration_min" class="form-control cp-param" min="1" max="30" value="5">
              <small class="text-muted">Spin phase duration</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Drain Duration (sec)</label>
              <input type="number" name="drain_duration_sec" class="form-control cp-param" min="10" max="300" value="60">
              <small class="text-muted">Water drain time</small>
            </div>
          </div>
        </form>
      </div>

      <!-- HISTORY TAB -->
      <div class="tab-pane fade" id="tabHistory">
        <h6>Recent Pulse Log</h6>
        <div class="table-responsive" style="max-height:300px;">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Date</th>
                <th>Pulses</th>
                <th>Credits</th>
                <th>Reason</th>
              </tr>
            </thead>
            <tbody id="cpPulseLog">
              <tr><td colspan="4" class="text-center text-muted">No pulse history yet</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Save button -->
    <div class="mt-3 d-flex gap-2">
      <button class="btn btn-primary rounded-pill" id="saveParamsBtn">
        <i class="fas fa-save me-2"></i> Save All Parameters
      </button>
      <button class="btn btn-outline-secondary rounded-pill" id="reloadParamsBtn">
        <i class="fas fa-sync me-2"></i> Reload
      </button>
    </div>
  </div>

  <!-- ===== WEIGHT PRICING SETTINGS ===== -->
  <div class="ss-card">
    <h5 class="mb-3" style="color:#0c4a6e;">
      <i class="fas fa-weight me-2"></i>Weight Pricing Settings
    </h5>
    <form action="/spinspg/device/<%= device.device_id %>/weight-settings" method="POST">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label fw-bold">Price per Kg (Ksh)</label>
          <input type="number" name="price_per_kg" class="form-control" value="<%= device.price_per_kg || 50 %>" step="0.01" min="1" required>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-bold">Max Capacity (kg)</label>
          <input type="number" name="max_capacity_kg" class="form-control" value="<%= device.max_capacity_kg || 20 %>" step="0.5" min="1" required>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-bold">Min Load (kg)</label>
          <input type="number" name="min_capacity_kg" class="form-control" value="<%= device.min_capacity_kg || 1 %>" step="0.5" min="0.5" required>
        </div>
      </div>
      <button type="submit" class="btn btn-primary rounded-pill mt-3" style="background:#0284c7;border:none;">
        <i class="fas fa-save me-2"></i> Save Weight Settings
      </button>
    </form>

    <div class="weight-info-box">
      <small class="text-muted">Current Pricing:</small>
      <p class="mb-0 fw-bold" style="font-size:1.2rem;">
        Ksh <%= device.price_per_kg || 50 %>/kg × Weight = Total Price
      </p>
      <small class="text-muted">
        Machine accepts <%= device.min_capacity_kg || 1 %>kg - <%= device.max_capacity_kg || 20 %>kg
      </small>
    </div>
  </div>

  <!-- ===== CONTROLS & ORDERS ROW ===== -->
  <div class="row g-4">
    <!-- Machine Controls -->
    <div class="col-lg-5">
      <div class="ss-card">
        <h5 class="mb-3" style="color:#0c4a6e;">Machine Controls</h5>
        <form action="/spinspg/device/<%= device.device_id %>/command" method="POST">
          <div class="mb-3">
            <label class="form-label">Command</label>
            <select name="command_type" class="form-select" required>
              <option value="start_cycle">Start Cycle</option>
              <option value="stop">Stop Machine</option>
              <option value="pause">Pause</option>
              <option value="resume">Resume</option>
              <option value="lock_door">Lock Door</option>
              <option value="unlock_door">Unlock Door</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Value</label>
            <input type="text" name="command_value" class="form-control" placeholder="e.g., normal for cycle">
          </div>
          <button type="submit" class="btn btn-primary w-100 rounded-pill" style="background:#0284c7;border:none;">
            <i class="fas fa-paper-plane me-2"></i> Send Command
          </button>
        </form>
      </div>
    </div>

    <!-- Recent Orders -->
    <div class="col-lg-7">
      <div class="ss-card">
        <h5 class="mb-3" style="color:#0c4a6e;">Recent Orders</h5>
        <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Order #</th>
                  <th>Weight</th>
                  <th>Service</th>
                  <th>Status</th>
                  <th>Price</th>
                </tr>
              </thead>
              <tbody>
                <% orders.forEach(function(o) { %>
                  <tr>
                    <td style="font-size:0.8rem;"><%= o.order_number %></td>
                    <td><%= o.weight_kg ? o.weight_kg + 'kg' : 'N/A' %></td>
                    <td><%= o.service_type %></td>
                    <td><span class="badge bg-info"><%= o.order_status %></span></td>
                    <td>Ksh <%= o.price %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-muted">No orders yet</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- ===== SCRIPTS ===== -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
// ============ MACHINE CONTROL PANEL ============
(function() {
  'use strict';

  const CP_DEVICE_ID = document.getElementById('cpDeviceId')?.value;
  if (!CP_DEVICE_ID) return;

  const DOM = {
    heartbeatBadge: document.getElementById('heartbeatBadge'),
    cpCurrentCredit: document.getElementById('cpCurrentCredit'),
    cpState: document.getElementById('cpState'),
    cpBattery: document.getElementById('cpBattery'),
    cpSignal: document.getElementById('cpSignal'),
    cpPulseLog: document.getElementById('cpPulseLog'),
    dispenseCredits: document.getElementById('dispenseCredits'),
    dispenseReason: document.getElementById('dispenseReason'),
    dispenseOrder: document.getElementById('dispenseOrder'),
    dispenseBtn: document.getElementById('dispenseBtn'),
    saveParamsBtn: document.getElementById('saveParamsBtn'),
    reloadParamsBtn: document.getElementById('reloadParamsBtn')
  };

  // ============ API CALLS ============
  async function fetchHeartbeat() {
    try {
      const res = await fetch(`/api/machine/${CP_DEVICE_ID}/heartbeat`);
      const data = await res.json();
      if (data.success) {
        updateHeartbeat(data);
      }
    } catch (e) {
      console.error('Heartbeat fetch failed:', e);
      if (DOM.heartbeatBadge) {
        DOM.heartbeatBadge.className = 'badge bg-danger';
        DOM.heartbeatBadge.textContent = 'Offline';
      }
    }
  }

  async function loadParams() {
    try {
      const res = await fetch(`/api/machine/${CP_DEVICE_ID}/params`);
      const data = await res.json();
      if (data.success && data.params) {
        document.querySelectorAll('.cp-param').forEach(el => {
          const name = el.name;
          if (data.params[name] !== undefined) {
            if (el.tagName === 'SELECT') {
              el.value = String(data.params[name]);
            } else {
              el.value = data.params[name];
            }
          }
        });
      }
    } catch (e) {
      console.error('Load params failed:', e);
    }
  }

  async function saveParams() {
    const params = {};
    document.querySelectorAll('.cp-param').forEach(el => {
      if (el.name) {
        const val = el.value;
        params[el.name] = isNaN(val) ? val : parseFloat(val);
      }
    });

    try {
      const res = await fetch(`/api/machine/${CP_DEVICE_ID}/params`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ params })
      });
      const data = await res.json();
      if (data.success) {
        showToast('Parameters saved successfully', 'success');
      } else {
        showToast(data.error || 'Failed to save parameters', 'danger');
      }
    } catch (e) {
      console.error('Save params failed:', e);
      showToast('Network error saving parameters', 'danger');
    }
  }

  async function dispenseCredits() {
    const credits = parseInt(DOM.dispenseCredits?.value || 1, 10);
    const reason = DOM.dispenseReason?.value || 'manual';
    const order = DOM.dispenseOrder?.value || null;

    if (credits < 1) {
      showToast('Credits must be at least 1', 'warning');
      return;
    }

    try {
      const res = await fetch(`/api/machine/${CP_DEVICE_ID}/dispense`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ credits, reason, order_number: order })
      });
      const data = await res.json();
      if (data.success) {
        showToast(`Queued ${credits} credit(s) for dispense`, 'success');
        DOM.dispenseCredits.value = 1;
        DOM.dispenseOrder.value = '';
      } else {
        showToast(data.error || 'Dispense failed', 'danger');
      }
    } catch (e) {
      console.error('Dispense failed:', e);
      showToast('Network error during dispense', 'danger');
    }
  }

  async function loadPulseLog() {
    try {
      const res = await fetch(`/api/machine/${CP_DEVICE_ID}/pulse-log`);
      const data = await res.json();
      if (data.success && data.log) {
        renderPulseLog(data.log);
      }
    } catch (e) {
      console.error('Pulse log fetch failed:', e);
    }
  }

  // ============ RENDERING ============
  function updateHeartbeat(data) {
    if (DOM.cpCurrentCredit) DOM.cpCurrentCredit.textContent = data.current_credit || 0;
    if (DOM.cpState) DOM.cpState.textContent = data.state || 'idle';
    if (DOM.cpBattery) DOM.cpBattery.textContent = (data.battery_voltage || 0) + 'V';
    if (DOM.cpSignal) DOM.cpSignal.textContent = data.signal_strength || '-';

    if (DOM.heartbeatBadge) {
      const age = data.seconds_since_heartbeat || 999;
      if (age < 60) {
        DOM.heartbeatBadge.className = 'badge bg-success';
        DOM.heartbeatBadge.textContent = 'Online';
      } else if (age < 300) {
        DOM.heartbeatBadge.className = 'badge bg-warning text-dark';
        DOM.heartbeatBadge.textContent = 'Stale';
      } else {
        DOM.heartbeatBadge.className = 'badge bg-danger';
        DOM.heartbeatBadge.textContent = 'Offline';
      }
    }
  }

  function renderPulseLog(log) {
    if (!DOM.cpPulseLog) return;
    if (!log || log.length === 0) {
      DOM.cpPulseLog.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No pulse history yet</td></tr>';
      return;
    }
    DOM.cpPulseLog.innerHTML = log.map(entry => `
      <tr>
        <td>${new Date(entry.created_at).toLocaleString()}</td>
        <td>${entry.pulses || 0}</td>
        <td>${entry.credits || 0}</td>
        <td>${entry.reason || '-'}</td>
      </tr>
    `).join('');
  }

  function showToast(message, type) {
    // Simple toast fallback
    const toast = document.createElement('div');
    toast.className = `alert alert-${type} position-fixed`;
    toast.style.cssText = 'top:20px;right:20px;z-index:9999;min-width:250px;box-shadow:0 5px 20px rgba(0,0,0,0.2);';
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
  }

  // ============ INITIALIZATION ============
  function init() {
    // Load initial data
    fetchHeartbeat();
    loadParams();
    loadPulseLog();

    // Poll heartbeat every 30 seconds
    setInterval(fetchHeartbeat, 30000);

    // Event listeners
    DOM.saveParamsBtn?.addEventListener('click', saveParams);
    DOM.reloadParamsBtn?.addEventListener('click', loadParams);
    DOM.dispenseBtn?.addEventListener('click', dispenseCredits);

    // Refresh button
    document.getElementById('refreshBtn')?.addEventListener('click', () => location.reload());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

</body>
</html>