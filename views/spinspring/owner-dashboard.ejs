<%- include('../layouts/main') %>
<style>
.ss-nav { background: linear-gradient(135deg, #0284c7, #0ea5e9); padding: 15px 0; }
.ss-nav a { color: white !important; text-decoration: none; }
.ss-card {
  background: white;
  border-radius: 20px;
  padding: 25px;
  box-shadow: 0 5px 25px rgba(2,132,199,0.1);
  border: 1px solid #e0f2fe;
  margin-bottom: 20px;
}
.section-title {
  color: #0c4a6e;
  padding-bottom: 10px;
  border-bottom: 2px solid #e0f2fe;
  margin-bottom: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.table-blue th { background: #e0f2fe; color: #0c4a6e; }
.btn-sm { padding: 5px 15px; border-radius: 20px; font-size: 0.8rem; }
</style>
</head>
<body>
<nav class="ss-nav">
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
    <a href="/spinspg/owner" class="brand text-white text-decoration-none" style="font-size:1.5rem;font-weight:800;">
      <i class="fas fa-soap me-2"></i>SpinSpring
    </a>
    <div class="d-flex flex-wrap gap-1">
      <a href="/spinspg/owner" class="btn btn-light btn-sm rounded-pill">🏠 Owner Panel</a>
      <a href="/spinspg/device-list" class="btn btn-outline-light btn-sm rounded-pill">Machines</a>
      <a href="/spinspg/orders" class="btn btn-outline-light btn-sm rounded-pill">Orders</a>
      <a href="/owner/quotes" class="btn btn-sm btn-outline-light rounded-pill">
      <i class="fas fa-file-invoice-dollar me-1"></i> Quotes
      </a> 
      <a href="/spinspg/reports" class="btn btn-outline-light btn-sm rounded-pill">Reports</a>
      <a href="/spinspg/logout" class="btn btn-danger btn-sm rounded-pill">Logout</a>
    </div>
  </div>
</nav>

<%- include('../partials/flash') %>

<div class="container py-4">
  <h2 class="mb-4" style="color:#0c4a6e;">Owner Panel</h2>
  
  <!-- Stats -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="ss-card text-center">
        <div class="h3 fw-bold" style="color:#0284c7;">Ksh <%= stats.today_rev || 0 %></div>
        <small class="text-muted">Today Revenue</small>
      </div>
    </div>
    <div class="col-md-3">
      <div class="ss-card text-center">
        <div class="h3 fw-bold" style="color:#0284c7;">Ksh <%= stats.total_rev || 0 %></div>
        <small class="text-muted">Total Revenue</small>
      </div>
    </div>
    <div class="col-md-3">
      <div class="ss-card text-center">
        <div class="h3 fw-bold"><%= stats.total_cyc || 0 %></div>
        <small class="text-muted">Total Cycles</small>
      </div>
    </div>
    <div class="col-md-3">
      <div class="ss-card text-center">
        <div class="h3 fw-bold"><%= typeof devices !== 'undefined' ? devices.length : 0 %></div>
        <small class="text-muted">Machines</small>
      </div>
    </div>
  </div>

  <!-- Machines -->
  <div class="ss-card">
    <div class="section-title">
      <span><i class="fas fa-washing-machine me-2"></i>Your Machines</span>
      <a href="/spinspg/register-device" class="btn btn-sm rounded-pill" style="background:#0284c7;color:white;">+ Add Machine</a>
    </div>
    <div class="table-responsive">
      <table class="table table-blue">
        <thead><tr><th>Name</th><th>Type</th><th>Status</th><th>Price</th><th>Cycles</th><th>Revenue</th></tr></thead>
        <tbody>
          <% if (typeof devices !== 'undefined' && devices.length > 0) { %>
            <% devices.forEach(function(d) { %>
              <tr>
                <td><a href="/spinspg/device/<%= d.device_id %>"><%= d.device_name %></a></td>
                <td><%= d.device_type.replace('_', ' ') %></td>
                <td><span class="badge bg-info"><%= d.status %></span></td>
                <td>Ksh <%= d.price_per_cycle %></td>
                <td><%= d.cycles_completed %></td>
                <td>Ksh <%= d.total_revenue %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Attendants -->
  <div class="ss-card">
    <div class="section-title">
      <span><i class="fas fa-users me-2"></i>Attendants</span>
      <button class="btn btn-sm rounded-pill" style="background:#10b981;color:white;" data-bs-toggle="modal" data-bs-target="#addAttendantModal">+ Add Attendant</button>
    </div>
    <div class="table-responsive">
      <table class="table">
        <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          <% if (typeof attendants !== 'undefined' && attendants.length > 0) { %>
            <% attendants.forEach(function(a) { %>
              <tr>
                <td><%= a.full_name %></td>
                <td><%= a.email %></td>
                <td><%= a.phone %></td>
                <td><span class="badge bg-<%= a.is_active ? 'success' : 'danger' %>"><%= a.is_active ? 'Active' : 'Inactive' %></span></td>
                <td>
                  <form action="/spinspg/owner/attendants/<%= a.id %>/toggle" method="POST" style="display:inline;">
                    <button class="btn-sm btn btn-warning"><%= a.is_active ? 'Deactivate' : 'Activate' %></button>
                  </form>
                  <form action="/spinspg/owner/attendants/<%= a.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete?');">
                    <button class="btn-sm btn btn-danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Customers -->
  <div class="ss-card">
    <div class="section-title">
      <span><i class="fas fa-id-card me-2"></i>Customers</span>
      <button class="btn btn-sm rounded-pill" style="background:#f59e0b;color:white;" data-bs-toggle="modal" data-bs-target="#addCustomerModal">+ Add Customer</button>
    </div>
    <div class="table-responsive">
      <table class="table">
        <thead><tr><th>Customer ID</th><th>Name</th><th>Phone</th><th>Cycles</th><th>Spent</th></tr></thead>
        <tbody>
          <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
            <% customers.forEach(function(c) { %>
              <tr>
                <td style="font-family:monospace;font-size:0.8rem;"><%= c.customer_unique_id %></td>
                <td><%= c.full_name %></td>
                <td><%= c.phone %></td>
                <td><%= c.total_cycles %></td>
                <td>Ksh <%= c.total_spent %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Attendant Modal -->
<div class="modal fade" id="addAttendantModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content rounded-4">
      <div class="modal-header" style="background:#0284c7;color:white;">
        <h5>Add Attendant</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/spinspg/owner/attendants" method="POST">
        <div class="modal-body">
          <input type="text" name="full_name" class="form-control mb-2" placeholder="Full Name" required>
          <input type="email" name="email" class="form-control mb-2" placeholder="Email (unique)" required>
          <input type="text" name="phone" class="form-control mb-2" placeholder="Phone">
          <input type="text" name="pin_code" class="form-control mb-2" placeholder="PIN Code (4-6 digits)" maxlength="6" required>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Attendant</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Add Customer Modal -->
<div class="modal fade" id="addCustomerModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content rounded-4">
      <div class="modal-header" style="background:#f59e0b;color:white;">
        <h5>Add Customer</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/spinspg/owner/customers" method="POST">
        <div class="modal-body">
          <input type="text" name="full_name" class="form-control mb-2" placeholder="Full Name" required>
          <input type="text" name="phone" class="form-control mb-2" placeholder="Phone">
          <input type="email" name="email" class="form-control mb-2" placeholder="Email (optional, unique)">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning">Create Customer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
// AJAX Live Refresh - updates without page reload
let refreshInterval;

function startLiveRefresh() {
  refreshInterval = setInterval(() => {
    fetch('/api/live-data')
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          updateDashboardUI(data);
        }
      })
      .catch(err => console.log('Refresh error:', err));
  }, 10000); // Every 10 seconds
}

function updateDashboardUI(data) {
  // Update stats
  if (data.stats) {
    const todayRev = document.getElementById('live-today-rev');
    if (todayRev) todayRev.textContent = 'Ksh ' + data.stats.today_rev;
    
    const totalRev = document.getElementById('live-total-rev');
    if (totalRev) totalRev.textContent = 'Ksh ' + data.stats.total_rev;
  }
  
  // Update device statuses
  if (data.devices) {
    data.devices.forEach(device => {
      const statusEl = document.getElementById('status-' + device.device_id);
      if (statusEl) {
        statusEl.textContent = device.status;
        statusEl.className = 'badge bg-' + (device.status === 'idle' ? 'success' : device.status === 'running' ? 'primary' : 'warning');
      }
      
      const progressEl = document.getElementById('progress-' + device.device_id);
      if (progressEl) {
        progressEl.style.width = device.cycle_progress + '%';
      }
    });
  }
  
  // Update refresh indicator
  const indicator = document.getElementById('refresh-indicator');
  if (indicator) {
    indicator.textContent = 'Last updated: ' + new Date().toLocaleTimeString();
  }
}

// Start on page load
document.addEventListener('DOMContentLoaded', startLiveRefresh);

// Stop when page hidden (save bandwidth)
document.addEventListener('visibilitychange', () => {
  if (document.hidden) clearInterval(refreshInterval);
  else startLiveRefresh();
});
</script>
</body>
</html><%- include('../layouts/main') %>

<style>
.dash-header {
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  color: white;
  padding: 30px 0;
  margin-bottom: 30px;
}
.dash-header h1 { color: white; font-weight: 800; margin: 0 0 4px; font-size: 1.75rem; }
.dash-header .sub { color: rgba(255,255,255,0.9); }
.dash-header .actions { display: flex; gap: 10px; flex-wrap: wrap; }

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
  margin-bottom: 30px;
}
.stat-card {
  background: white;
  border-radius: 16px;
  padding: 20px;
  border: 1px solid #e0f2fe;
  box-shadow: 0 3px 15px rgba(2,132,199,0.08);
  transition: all 0.2s;
}
.stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(2,132,199,0.15); }
.stat-card .icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  color: white;
  margin-bottom: 12px;
}
.stat-card .value { font-size: 1.85rem; font-weight: 800; color: #0c4a6e; line-height: 1.1; }
.stat-card .label { color: #64748b; font-size: 0.85rem; margin-top: 4px; }
.stat-card .sub { color: #10b981; font-size: 0.75rem; margin-top: 6px; font-weight: 600; }

.dash-section {
  background: white;
  border-radius: 16px;
  padding: 24px;
  border: 1px solid #e0f2fe;
  box-shadow: 0 3px 15px rgba(2,132,199,0.08);
  margin-bottom: 24px;
}
.dash-section h5 {
  color: #0c4a6e;
  font-weight: 800;
  padding-bottom: 12px;
  border-bottom: 2px solid #e0f2fe;
  margin-bottom: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.device-row {
  display: flex;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f1f5f9;
  gap: 12px;
}
.device-row:last-child { border-bottom: none; }
.device-row .name { font-weight: 700; color: #0c4a6e; }
.device-row .id { font-size: 0.75rem; color: #64748b; font-family: monospace; }
.device-row .status {
  padding: 3px 10px;
  border-radius: 12px;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
}
.status-online, .status-idle { background: #d1fae5; color: #065f46; }
.status-running { background: #dbeafe; color: #1e40af; }
.status-offline { background: #f1f5f9; color: #64748b; }
.status-maintenance { background: #fee2e2; color: #991b1b; }

.empty-state { text-align: center; padding: 40px 20px; color: #64748b; }
.empty-state i { font-size: 3rem; color: #cbd5e1; margin-bottom: 12px; }
</style>

<div class="dash-header">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h1><i class="fas fa-tachometer-alt me-2"></i><%= owner.company_name %></h1>
        <div class="sub">Welcome back, <%= owner.contact_name %> · <%= owner.email %></div>
      </div>
      <div class="actions">
        <a href="/owner/settings" class="btn btn-light btn-sm rounded-pill">
          <i class="fas fa-cog me-1"></i>Settings
        </a>
        <a href="/owner/reviews" class="btn btn-light btn-sm rounded-pill">
          <i class="fas fa-star me-1"></i>Reviews
        </a>
        <a href="/logout" class="btn btn-outline-light btn-sm rounded-pill">
          <i class="fas fa-sign-out-alt me-1"></i>Logout
        </a>
      </div>
    </div>
  </div>
</div>

<div class="container pb-5">
  <%- include('../partials/flash') %>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="icon" style="background:linear-gradient(135deg,#0284c7,#0ea5e9);">
        <i class="fas fa-server"></i>
      </div>
      <div class="value"><%= stats.devices.total_devices || 0 %></div>
      <div class="label">Total Devices</div>
      <div class="sub"><%= stats.devices.online_devices || 0 %> online</div>
    </div>

    <div class="stat-card">
      <div class="icon" style="background:linear-gradient(135deg,#10b981,#059669);">
        <i class="fas fa-shopping-bag"></i>
      </div>
      <div class="value"><%= stats.orders.total_orders || 0 %></div>
      <div class="label">Total Orders</div>
      <div class="sub"><%= stats.orders.completed || 0 %> completed</div>
    </div>

    <div class="stat-card">
      <div class="icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);">
        <i class="fas fa-money-bill-wave"></i>
      </div>
      <div class="value">KES <%= Number(stats.devices.today_revenue || 0).toLocaleString() %></div>
      <div class="label">Today Revenue</div>
      <div class="sub">Total: KES <%= Number(stats.devices.total_revenue || 0).toLocaleString() %></div>
    </div>

    <div class="stat-card">
      <div class="icon" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);">
        <i class="fas fa-users"></i>
      </div>
      <div class="value"><%= stats.customers.total || 0 %></div>
      <div class="label">Customers</div>
      <div class="sub"><%= stats.attendants.total || 0 %> attendants</div>
    </div>

    <div class="stat-card">
      <div class="icon" style="background:linear-gradient(135deg,#ef4444,#dc2626);">
        <i class="fas fa-star"></i>
      </div>
      <div class="value"><%= stats.reviews.avg_rating || '—' %>★</div>
      <div class="label">Avg Rating</div>
      <div class="sub"><%= stats.reviews.total || 0 %> reviews · <%= stats.reviews.pending || 0 %> pending</div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
      <a href="/owner/locations" class="btn btn-outline-primary w-100 rounded-pill py-3">
        <i class="fas fa-map-marker-alt me-2"></i>Locations
      </a>
    </div>

    <div class="col-md-3 col-6">
  <a href="/owner/invites" class="btn btn-outline-warning w-100 rounded-pill py-3">
    <i class="fas fa-key me-2"></i>Invite Codes
  </a>
</div>
    <div class="col-md-3 col-6">
      <a href="/owner/attendants" class="btn btn-outline-primary w-100 rounded-pill py-3">
        <i class="fas fa-user-tie me-2"></i>Attendants
      </a>
    </div>
    <div class="col-md-3 col-6">
      <a href="/owner/customers" class="btn btn-outline-primary w-100 rounded-pill py-3">
        <i class="fas fa-users me-2"></i>Customers
      </a>
    </div>
    <div class="col-md-3 col-6">
      <a href="/register-device" class="btn btn-outline-primary w-100 rounded-pill py-3">
        <i class="fas fa-plus-circle me-2"></i>Add Device
      </a>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-6">
      <div class="dash-section">
        <h5>
          <span><i class="fas fa-server me-2"></i>Devices (<%= devices.length %>)</span>
          <a href="/owner/locations" class="ss-btn ss-btn-sm ss-btn-outline">Manage</a>
        </h5>

        <% if (devices.length === 0) { %>
          <div class="empty-state">
            <i class="fas fa-server"></i>
            <p>No devices yet</p>
            <a href="/register-device" class="ss-btn ss-btn-sm">Add Device</a>
          </div>
        <% } else { %>
          <% devices.slice(0, 5).forEach(d => { %>
            <div class="device-row">
              <div style="flex:1;">
                <div class="name"><%= d.device_name %></div>
                <div class="id"><%= d.device_id %></div>
              </div>
              <span class="status status-<%= d.status || 'offline' %>">
                <%= d.status || 'offline' %>
              </span>
              <a href="/device/<%= d.device_id %>" class="btn btn-sm btn-outline-primary rounded-pill">
                <i class="fas fa-cog"></i>
              </a>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="dash-section">
        <h5>
          <span><i class="fas fa-shopping-bag me-2"></i>Recent Orders</span>
          <a href="/owner/orders" class="ss-btn ss-btn-sm ss-btn-outline">View All</a>
        </h5>

        <% if (!recentOrders || recentOrders.length === 0) { %>
          <div class="empty-state">
            <i class="fas fa-shopping-bag"></i>
            <p>No orders yet</p>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Order #</th>
                  <th>Customer</th>
                  <th>Status</th>
                  <th class="text-end">Price</th>
                </tr>
              </thead>
              <tbody>
                <% recentOrders.forEach(o => { %>
                  <tr>
                    <td><small><%= o.order_number %></small></td>
                    <td><%= o.customer_name || '—' %></td>
                    <td><span class="status status-<%= o.order_status === 'completed' ? 'online' : (o.order_status === 'in_progress' ? 'running' : 'offline') %>"><%= o.order_status %></span></td>
                    <td class="text-end">KES <%= Number(o.price).toLocaleString() %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="dash-section">
        <h5>
          <span><i class="fas fa-user-tie me-2"></i>Attendants (<%= attendants.length %>)</span>
          <a href="/owner/attendants" class="ss-btn ss-btn-sm ss-btn-outline">Manage</a>
        </h5>

        <% if (attendants.length === 0) { %>
          <div class="empty-state">
            <i class="fas fa-user-tie"></i>
            <p>No attendants yet</p>
            <a href="/owner/attendants" class="ss-btn ss-btn-sm">Add Attendant</a>
          </div>
        <% } else { %>
          <% attendants.slice(0, 5).forEach(a => { %>
            <div class="device-row">
              <div style="flex:1;">
                <div class="name"><%= a.full_name %></div>
                <div class="id"><%= a.email %></div>
              </div>
              <span class="status <%= a.is_active ? 'status-online' : 'status-offline' %>">
                <%= a.is_active ? 'active' : 'inactive' %>
              </span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="dash-section">
        <h5>
          <span><i class="fas fa-users me-2"></i>Recent Customers</span>
          <a href="/owner/customers" class="ss-btn ss-btn-sm ss-btn-outline">View All</a>
        </h5>

        <% if (customers.length === 0) { %>
          <div class="empty-state">
            <i class="fas fa-users"></i>
            <p>No customers yet</p>
          </div>
        <% } else { %>
          <% customers.slice(0, 5).forEach(c => { %>
            <div class="device-row">
              <div style="flex:1;">
                <div class="name"><%= c.full_name %></div>
                <div class="id"><%= c.phone || c.email %></div>
              </div>
              <small class="text-muted"><%= c.total_orders || 0 %> orders</small>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>