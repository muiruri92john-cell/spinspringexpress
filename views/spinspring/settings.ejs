<%- include('../layouts/main') %>
<style>
.ss-nav { background: linear-gradient(135deg, #0284c7, #0ea5e9); padding: 15px 0; }
.ss-nav a { color: white !important; text-decoration: none; }
.ss-nav .brand { font-size: 1.4rem; font-weight: 800; }
.ss-card {
  background: white;
  border-radius: 20px;
  padding: 25px;
  box-shadow: 0 5px 25px rgba(2,132,199,0.1);
  border: 1px solid #e0f2fe;
  margin-bottom: 20px;
}
.settings-section { margin-bottom: 30px; }
.settings-section h5 {
  color: #0c4a6e;
  padding-bottom: 10px;
  border-bottom: 2px solid #e0f2fe;
  margin-bottom: 15px;
}
</style>
</head>
<body>
<nav class="ss-nav">
  <div class="container d-flex justify-content-between align-items-center">
    <a href="/spinspg/dashboard" class="brand"><i class="fas fa-soap me-2"></i>SpinSpring</a>
    <div>
      <a href="/spinspg/dashboard" class="btn btn-outline-light btn-sm rounded-pill">Dashboard</a>
      <a href="/spinspg/orders" class="btn btn-outline-light btn-sm rounded-pill">Orders</a>
      <a href="/spinspg/reports" class="btn btn-outline-light btn-sm rounded-pill">Reports</a>
      <a href="/spinspg/settings" class="btn btn-light btn-sm rounded-pill">Settings</a>
      <a href="/spinspg/logout" class="btn btn-outline-light btn-sm rounded-pill ms-1">Logout</a>
    </div>
  </div>
</nav>

<div class="container py-4">
  <h2 class="mb-4" style="color:#0c4a6e;">Settings</h2>

  <!-- Business Settings -->
  <div class="ss-card">
    <div class="settings-section">
      <h5><i class="fas fa-store me-2"></i>Business Information</h5>
      <form action="/spinspg/settings/business" method="POST">
        <div class="mb-3">
          <label class="form-label fw-bold">Business Name</label>
          <input type="text" name="business_name" class="form-control" value="<%= user.business || '' %>" placeholder="Your laundry business name">
        </div>
        <div class="mb-3">
          <label class="form-label fw-bold">Phone Number</label>
          <input type="text" name="phone" class="form-control" value="<%= user.phone || '' %>" placeholder="+2547...">
        </div>
        <button type="submit" class="btn btn-primary rounded-pill" style="background:#0284c7;border:none;">
          <i class="fas fa-save me-2"></i>Save Business Info
        </button>
      </form>
    </div>

    <div class="settings-section">
      <h5><i class="fas fa-bell me-2"></i>Notification Settings</h5>
      <div class="mb-3">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="emailAlerts" checked>
          <label class="form-check-label" for="emailAlerts">Email alerts when machine finishes cycle</label>
        </div>
      </div>
      <div class="mb-3">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="lowRevenueAlert">
          <label class="form-check-label" for="lowRevenueAlert">Alert when daily revenue below target</label>
        </div>
      </div>
      <div class="mb-3">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="maintenanceAlert" checked>
          <label class="form-check-label" for="maintenanceAlert">Maintenance reminders (every 500 cycles)</label>
        </div>
      </div>
      <button class="btn btn-primary rounded-pill" style="background:#0284c7;border:none;" onclick="saveNotificationSettings()">
        <i class="fas fa-save me-2"></i>Save Notifications
      </button>
    </div>
  </div>

  <!-- Device Defaults -->
  <div class="ss-card">
    <div class="settings-section">
      <h5><i class="fas fa-cog me-2"></i>Default Machine Settings</h5>
      <form action="/spinspg/settings/defaults" method="POST">
        <div class="mb-3">
          <label class="form-label fw-bold">Default Price per Cycle (Ksh)</label>
          <input type="number" name="default_price" class="form-control" value="300" min="50">
        </div>
        <div class="mb-3">
          <label class="form-label fw-bold">Default Cycle Type</label>
          <select name="default_cycle" class="form-select">
            <option value="quick">Quick Wash (15 min)</option>
            <option value="normal" selected>Normal Wash (30 min)</option>
            <option value="heavy">Heavy Duty (60 min)</option>
            <option value="delicate">Delicate (45 min)</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary rounded-pill" style="background:#0284c7;border:none;">
          <i class="fas fa-save me-2"></i>Save Defaults
        </button>
      </form>
    </div>

    <div class="settings-section">
      <h5><i class="fas fa-shield-alt me-2"></i>Security</h5>
      <form action="/spinspg/settings/password" method="POST">
        <div class="mb-3">
          <label class="form-label fw-bold">Current Password</label>
          <input type="password" name="current_password" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label fw-bold">New Password</label>
          <input type="password" name="new_password" class="form-control" required minlength="6">
        </div>
        <div class="mb-3">
          <label class="form-label fw-bold">Confirm New Password</label>
          <input type="password" name="confirm_password" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary rounded-pill" style="background:#0284c7;border:none;">
          <i class="fas fa-key me-2"></i>Change Password
        </button>
      </form>
    </div>
  </div>
</div>

<script src="/js/spinspring.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>