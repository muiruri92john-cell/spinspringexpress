<%- include('../layouts/main') %>
<style>
.ss-nav { background: linear-gradient(135deg, #f59e0b, #d97706); padding: 15px 0; }
.ss-nav a { color: white !important; text-decoration: none; }
.ss-card {
  background: white;
  border-radius: 20px;
  padding: 25px;
  box-shadow: 0 5px 25px rgba(245,158,11,0.1);
  border: 1px solid #fef3c7;
  margin-bottom: 20px;
}
.customer-badge {
  background: #fef3c7;
  color: #92400e;
  padding: 10px 20px;
  border-radius: 15px;
  font-family: monospace;
  font-size: 1.2rem;
  font-weight: 700;
  display: inline-block;
}
.active-order {
  background: #f0f9ff;
  border: 2px solid #bae6fd;
  border-radius: 15px;
  padding: 20px;
  margin-bottom: 15px;
}
.section-title {
  color: #0c4a6e;
  padding-bottom: 10px;
  border-bottom: 2px solid #fef3c7;
  margin-bottom: 20px;
}
.status-badge { padding: 5px 15px; border-radius: 20px; font-size: 0.7rem; font-weight: 700; }
.status-queued { background: #fef3c7; color: #92400e; }
.status-in_progress { background: #dbeafe; color: #1e40af; }
.status-completed { background: #d1fae5; color: #065f46; }
.status-cancelled { background: #fee2e2; color: #991b1b; }
</style>
</head>
<body>
<nav class="ss-nav">
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
    <a href="/spinspg/customer" class="brand text-white text-decoration-none" style="font-size:1.5rem;font-weight:800;">
      <i class="fas fa-soap me-2"></i>SpinSpring
    </a>
    <div class="d-flex align-items-center gap-2">
      <span class="text-white">Welcome, <%= customer.full_name %></span>
      <a href="/spinspg/logout" class="btn btn-danger btn-sm rounded-pill">
        <i class="fas fa-sign-out-alt me-1"></i> Logout
      </a>
    </div>
  </div>
</nav>

<div class="container py-4">
  <!-- Customer Info Card -->
  <div class="ss-card text-center">
    <i class="fas fa-user-circle fa-4x mb-3" style="color:#f59e0b;"></i>
    <h4 style="color:#0c4a6e;margin-bottom:10px;"><%= customer.full_name %></h4>
    <div class="customer-badge"><%= customer.customer_unique_id %></div>
    
    <div class="row mt-4">
      <div class="col-4">
        <div class="h4 fw-bold text-success"><%= customer.total_cycles || 0 %></div>
        <small class="text-muted">Total Cycles</small>
      </div>
      <div class="col-4">
        <div class="h4 fw-bold">Ksh <%= customer.total_spent || 0 %></div>
        <small class="text-muted">Total Spent</small>
      </div>
      <div class="col-4">
        <div class="h4 fw-bold text-warning"><%= customer.loyalty_points || 0 %></div>
        <small class="text-muted">Loyalty Points</small>
      </div>
    </div>
    <div class="mt-3">
      <span class="badge bg-warning text-dark" style="font-size:0.85rem;">Tier: <%= (customer.tier || 'bronze').toUpperCase() %></span>
    </div>
  </div>

  <!-- Active Orders -->
  <div class="ss-card">
    <div class="section-title">
      <i class="fas fa-spinner fa-spin me-2"></i>Active Orders
    </div>
    
    <% if (typeof activeOrders !== 'undefined' && activeOrders.length > 0) { %>
      <% activeOrders.forEach(function(order) { %>
        <div class="active-order">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0 fw-bold" style="color:#0c4a6e;"><%= order.order_number %></h6>
            <span class="status-badge status-<%= order.order_status %>"><%= order.order_status.replace('_', ' ').toUpperCase() %></span>
          </div>
          
          <div class="row mb-2">
            <div class="col-6">
              <small class="text-muted">Service:</small>
              <p class="mb-1 fw-bold"><%= order.service_type.replace('_', ' → ').toUpperCase() %></p>
            </div>
            <div class="col-6">
              <small class="text-muted">Cycle:</small>
              <p class="mb-1 fw-bold"><%= order.cycle_type.toUpperCase() %></p>
            </div>
          </div>
          
          <div class="mb-2">
            <div class="d-flex justify-content-between">
              <small class="text-muted">Progress</small>
              <small class="fw-bold" style="color:#0284c7;">
                <%= order.order_status === 'completed' ? '100%' : (order.order_status === 'in_progress' ? '50%' : '10%') %>
              </small>
            </div>
            <div class="progress" style="height:10px;border-radius:5px;">
              <div class="progress-bar" role="progressbar" 
                   style="width:<%= order.order_status === 'completed' ? '100%' : (order.order_status === 'in_progress' ? '50%' : '10%') %>;background:#0284c7;border-radius:5px;">
              </div>
            </div>
          </div>
          
          <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">
              <i class="far fa-clock me-1"></i><%= new Date(order.created_at).toLocaleString() %>
            </small>
            <span class="fw-bold" style="color:#0284c7;">Ksh <%= order.price %></span>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="text-center py-4">
        <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
        <h6>No Active Orders</h6>
        <p class="text-muted">When you place an order at the laundry, it will appear here with live progress.</p>
      </div>
    <% } %>
  </div>

  <!-- Order History -->
  <div class="ss-card">
    <div class="section-title">
      <i class="fas fa-history me-2"></i>Order History
    </div>
    
    <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr><th>Order #</th><th>Service</th><th>Status</th><th>Price</th><th>Date</th></tr>
          </thead>
          <tbody>
            <% orders.forEach(function(o) { %>
              <tr>
                <td style="font-size:0.8rem;"><%= o.order_number %></td>
                <td><%= o.service_type.replace('_', ' ') %></td>
                <td><span class="status-badge status-<%= o.order_status %>"><%= o.order_status %></span></td>
                <td>Ksh <%= o.price %></td>
                <td style="font-size:0.75rem;"><%= new Date(o.created_at).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-muted">No orders yet. Visit your nearest SpinSpring laundry to place your first order!</p>
    <% } %>
  </div>
</div>

<!-- Auto-refresh for live order tracking -->
<script>
let refreshInterval;
function startOrderRefresh() {
  refreshInterval = setInterval(() => {
    fetch('/spinspg/api/customer-orders')
      .then(res => res.json())
      .then(data => {
        if (data.success && data.activeOrders) {
          // Update active orders section
          location.reload(); // Simple refresh for now
        }
      })
      .catch(() => {});
  }, 30000); // Refresh every 30 seconds
}
document.addEventListener('DOMContentLoaded', startOrderRefresh);
document.addEventListener('visibilitychange', () => {
  if (document.hidden) clearInterval(refreshInterval);
  else startOrderRefresh();
});
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>