<%- include('../layouts/main') %>

<style>
.dash-header {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white;
  padding: 25px 0;
  margin-bottom: 30px;
}
.dash-header h1 { color: white; font-weight: 800; margin: 0; font-size: 1.5rem; }
.dash-header .sub { color: rgba(255,255,255,0.9); }

.stat-box { background: white; border-radius: 12px; padding: 16px; text-align: center; border: 1px solid #e0f2fe; }
.stat-box .v { font-size: 1.75rem; font-weight: 800; color: #f59e0b; }
.stat-box .l { font-size: 0.75rem; color: #64748b; text-transform: uppercase; }

.dash-section {
  background: white;
  border-radius: 16px;
  padding: 24px;
  border: 1px solid #e0f2fe;
  box-shadow: 0 4px 15px rgba(2,132,199,0.08);
  margin-bottom: 24px;
}
.dash-section h5 {
  color: #0c4a6e;
  font-weight: 800;
  padding-bottom: 12px;
  border-bottom: 2px solid #e0f2fe;
  margin-bottom: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.status-pill { padding: 3px 12px; border-radius: 12px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; }
.status-pending { background: #fef3c7; color: #92400e; }
.status-queued { background: #dbeafe; color: #1e40af; }
.status-in_progress { background: #e9d5ff; color: #6b21a8; }
.status-completed { background: #d1fae5; color: #065f46; }
.status-cancelled { background: #fee2e2; color: #991b1b; }
</style>

<div class="dash-header">
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h1><i class="fas fa-id-card me-2"></i>Hello, <%= user.name %></h1>
      <div class="sub">
        <%= user.customerId %> · <%= user.ownerCompany %>
      </div>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-light btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#newOrderModal">
        <i class="fas fa-plus me-1"></i>Place Order
      </button>
      <a href="/customer-logout" class="btn btn-outline-light btn-sm rounded-pill">
        <i class="fas fa-sign-out-alt me-1"></i>Logout
      </a>
    </div>
  </div>
</div>

<div class="container pb-5">
  <%- include('../partials/flash') %>

  <!-- STATS -->
  <div class="row g-3 mb-4">
    <div class="col-md-3 col-6"><div class="stat-box"><div class="v"><%= stats.total_orders || 0 %></div><div class="l">Total Orders</div></div></div>
    <div class="col-md-3 col-6"><div class="stat-box"><div class="v" style="color:#3b82f6;"><%= stats.active || 0 %></div><div class="l">Active</div></div></div>
    <div class="col-md-3 col-6"><div class="stat-box"><div class="v" style="color:#10b981;"><%= stats.completed || 0 %></div><div class="l">Completed</div></div></div>
    <div class="col-md-3 col-6"><div class="stat-box"><div class="v" style="color:#0284c7;">KES <%= Number(stats.total_spent || 0).toLocaleString() %></div><div class="l">Total Spent</div></div></div>
  </div>

  <!-- ACTIVE ORDERS -->
  <% if (activeOrders.length > 0) { %>
    <div class="dash-section">
      <h5><i class="fas fa-clock me-2"></i>Active Orders</h5>
      <div class="row g-3">
        <% activeOrders.forEach(o => { %>
          <div class="col-md-6">
            <div style="background:#f0f9ff;border-radius:12px;padding:16px;border:1px solid #bae6fd;">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <strong style="font-size:0.85rem;"><%= o.order_number %></strong>
                <span class="status-pill status-<%= o.order_status %>"><%= o.order_status %></span>
              </div>
              <div style="font-size:0.85rem;color:#475569;">
                <div><i class="fas fa-tshirt me-2"></i><%= o.service_type %> · <%= o.cycle_type %></div>
                <% if (o.weight_kg) { %><div><i class="fas fa-weight me-2"></i><%= o.weight_kg %> kg</div><% } %>
                <div><i class="fas fa-money-bill me-2"></i>KES <%= Number(o.price).toLocaleString() %></div>
              </div>
              <% if (['pending','queued'].includes(o.order_status)) { %>
                <form method="POST" action="/customer/orders/<%= o.id %>/cancel" class="mt-2"
                      onsubmit="return confirm('Cancel this order?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill w-100">
                    <i class="fas fa-times me-1"></i>Cancel
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- ORDER HISTORY -->
  <div class="dash-section">
    <h5><i class="fas fa-history me-2"></i>Order History</h5>
    <% if (orders.length === 0) { %>
      <div class="text-center py-5">
        <i class="fas fa-shopping-bag fa-3x mb-3" style="color:#bae6fd;"></i>
        <p class="text-muted">No orders yet. Place your first one!</p>
        <button class="ss-btn" data-bs-toggle="modal" data-bs-target="#newOrderModal" style="background:#f59e0b;">
          <i class="fas fa-plus me-2"></i>Place Order
        </button>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Order #</th>
              <th>Service</th>
              <th>Status</th>
              <th>Payment</th>
              <th class="text-end">Price</th>
              <th class="text-end">Date</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(o => { %>
              <tr>
                <td><small><%= o.order_number %></small></td>
                <td><%= o.service_type %></td>
                <td><span class="status-pill status-<%= o.order_status %>"><%= o.order_status %></span></td>
                <td><span class="status-pill <%= o.payment_status === 'paid' ? 'status-completed' : 'status-pending' %>">
                  <%= o.payment_status %>
                </span></td>
                <td class="text-end">KES <%= Number(o.price).toLocaleString() %></td>
                <td class="text-end text-muted" style="font-size:0.8rem;">
                  <%= new Date(o.created_at).toLocaleDateString() %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<!-- NEW ORDER MODAL -->
<div class="modal fade" id="newOrderModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:20px;">
      <form method="POST" action="/customer/orders">
        <div class="modal-header" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:white;border-radius:20px 20px 0 0;">
          <h5 class="modal-title"><i class="fas fa-plus me-2"></i>Place New Order</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-bold">Service Type</label>
            <select name="service_type" class="form-select">
              <option value="wash">Wash & Fold</option>
              <option value="wash_iron">Wash & Iron</option>
              <option value="dry_clean">Dry Clean</option>
              <option value="iron">Iron Only</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Cycle</label>
            <select name="cycle_type" class="form-select">
              <option value="normal">Normal (24hrs)</option>
              <option value="express">Express (same day)</option>
              <option value="delicate">Delicate</option>
            </select>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold">Weight (kg)</label>
              <input type="number" name="weight_kg" class="form-control" step="0.1" min="0" placeholder="e.g., 5">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Price (KES)</label>
              <input type="number" name="price" class="form-control" step="0.01" min="0" required placeholder="e.g., 1000">
            </div>
          </div>
          <div class="mb-3 mt-3">
            <label class="form-label fw-bold">Notes (optional)</label>
            <textarea name="notes" class="form-control" rows="2" maxlength="500"
                      placeholder="Any special instructions"></textarea>
          </div>
          <div class="alert alert-info small mb-0">
            <i class="fas fa-info-circle me-1"></i>
            We'll confirm pickup/delivery via WhatsApp after you place the order.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="ss-btn" style="background:#f59e0b;">Place Order</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>