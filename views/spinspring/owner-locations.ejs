<%- include('../layouts/main') %>

<style>
.page-header {
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  color: white;
  padding: 25px 0;
  margin-bottom: 30px;
}
.page-header h1 { color: white; font-weight: 800; margin: 0; }
.page-header .sub { color: rgba(255,255,255,0.9); margin-top: 4px; }

.loc-card {
  background: white;
  border-radius: 16px;
  padding: 24px;
  border: 1px solid #e0f2fe;
  box-shadow: 0 4px 15px rgba(2,132,199,0.08);
  transition: all 0.2s;
  height: 100%;
}
.loc-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(2,132,199,0.15); }
.loc-card.primary { border: 2px solid #10b981; }

.loc-name { font-weight: 800; color: #0c4a6e; font-size: 1.1rem; margin-bottom: 4px; }
.loc-code { font-family: monospace; font-size: 0.75rem; color: #64748b; }
.loc-info { font-size: 0.9rem; color: #475569; margin: 6px 0; }
.loc-info i { color: #0284c7; width: 18px; }
.loc-stats { display: flex; gap: 12px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #f1f5f9; }
.loc-stat { flex: 1; text-align: center; }
.loc-stat .v { font-weight: 800; color: #0284c7; font-size: 1.2rem; }
.loc-stat .l { font-size: 0.7rem; color: #64748b; text-transform: uppercase; }
.badge-primary-loc { background: #10b981; color: white; padding: 3px 10px; border-radius: 12px; font-size: 0.65rem; font-weight: 800; }
</style>

<div class="page-header">
  <div class="container d-flex justify-content-between align-items-center">
    <div>
      <h1><i class="fas fa-map-marker-alt me-2"></i>Locations</h1>
      <div class="sub">Manage your branch locations</div>
    </div>
    <button class="btn btn-light rounded-pill" data-bs-toggle="modal" data-bs-target="#addLocModal">
      <i class="fas fa-plus me-1"></i>Add Location
    </button>
  </div>
</div>

<div class="container pb-5">
  <%- include('../partials/flash') %>

  <div class="mb-3">
    <a href="/owner" class="btn btn-sm btn-outline-secondary rounded-pill">
      <i class="fas fa-arrow-left me-1"></i>Dashboard
    </a>
  </div>

  <% if (locations.length === 0) { %>
    <div class="text-center py-5">
      <i class="fas fa-map-marked-alt fa-4x mb-3" style="color:#bae6fd;"></i>
      <h4 style="color:#0c4a6e;">No locations yet</h4>
      <p class="text-muted">Add your first branch</p>
      <button class="ss-btn" data-bs-toggle="modal" data-bs-target="#addLocModal">
        <i class="fas fa-plus me-2"></i>Add Location
      </button>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% locations.forEach(loc => { %>
        <div class="col-md-6 col-lg-4">
          <div class="loc-card <%= loc.is_primary ? 'primary' : '' %>">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div>
                <div class="loc-name"><%= loc.location_name %></div>
                <div class="loc-code"><%= loc.location_code %></div>
              </div>
              <% if (loc.is_primary) { %>
                <span class="badge-primary-loc">PRIMARY</span>
              <% } %>
            </div>

            <div class="loc-info"><i class="fas fa-map-pin me-2"></i><%= loc.address_line1 %></div>
            <div class="loc-info"><i class="fas fa-city me-2"></i><%= loc.city %></div>
            <% if (loc.phone) { %>
              <div class="loc-info"><i class="fas fa-phone me-2"></i><%= loc.phone %></div>
            <% } %>

            <div class="loc-stats">
              <div class="loc-stat">
                <div class="v"><%= loc.device_count %></div>
                <div class="l">Devices</div>
              </div>
              <div class="loc-stat">
                <div class="v"><%= loc.attendant_count %></div>
                <div class="l">Attendants</div>
              </div>
            </div>

            <div class="d-flex gap-2 mt-3">
              <% if (!loc.is_primary) { %>
                <form method="POST" action="/owner/locations/<%= loc.id %>/primary" class="flex-fill">
                  <button type="submit" class="btn btn-sm btn-outline-success rounded-pill w-100">
                    <i class="fas fa-star me-1"></i>Set Primary
                  </button>
                </form>
              <% } %>
              <form method="POST" action="/owner/locations/<%= loc.id %>/delete"
                    onsubmit="return confirm('Delete this location?');" class="flex-fill">
                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill w-100">
                  <i class="fas fa-trash me-1"></i>Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<!-- ADD LOCATION MODAL -->
<div class="modal fade" id="addLocModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:20px;">
      <form method="POST" action="/owner/locations">
        <div class="modal-header" style="background:linear-gradient(135deg,#0284c7,#0ea5e9);color:white;border-radius:20px 20px 0 0;">
          <h5 class="modal-title"><i class="fas fa-map-marker-alt me-2"></i>Add Location</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-bold">Location Name *</label>
            <input type="text" name="location_name" class="form-control" required maxlength="100"
                   placeholder="e.g., Westlands Branch">
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Address *</label>
            <input type="text" name="address_line1" class="form-control" required maxlength="255"
                   placeholder="Building, street">
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold">City</label>
              <input type="text" name="city" class="form-control" value="Nairobi" maxlength="100">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Phone</label>
              <input type="tel" name="phone" class="form-control" placeholder="+254...">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Latitude</label>
              <input type="text" name="latitude" class="form-control" placeholder="-1.2921">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Longitude</label>
              <input type="text" name="longitude" class="form-control" placeholder="36.8219">
            </div>
          </div>
          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" name="is_primary" value="1" id="isPrimary">
            <label class="form-check-label" for="isPrimary">Set as primary location</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="ss-btn">Create Location</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/pwa.js" defer></script>
</body>
</html>