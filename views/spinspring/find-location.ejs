<%- include('../layouts/main') %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
#map { height: 500px; border-radius: 20px; }
.loc-result {
  background: white;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 4px 20px rgba(2,132,199,0.08);
  border: 1px solid #e0f2fe;
  margin-bottom: 12px;
  transition: all 0.2s;
  cursor: pointer;
}
.loc-result:hover { border-color: #0284c7; box-shadow: 0 6px 25px rgba(2,132,199,0.15); }
.loc-result .distance { color: #10b981; font-weight: 800; }
.loc-result .open-badge { background: #d1fae5; color: #065f46; padding: 2px 10px; border-radius: 12px; font-size: 0.7rem; }
.loc-result .closed-badge { background: #fee2e2; color: #991b1b; padding: 2px 10px; border-radius: 12px; font-size: 0.7rem; }
</style>

<div class="container py-4">
  <div class="text-center mb-4">
    <h2 style="color:#0c4a6e;"><i class="fas fa-map-marked-alt me-2"></i>Find Your Nearest Branch</h2>
    <p class="text-muted">Click the button below or enter your address</p>

    <button id="findMe" class="btn btn-primary btn-lg rounded-pill px-4"
            style="background:#0284c7;border:none;">
      <i class="fas fa-location-arrow me-2"></i>Find Nearest to Me
    </button>
  </div>

  <div class="row g-4">
    <div class="col-lg-5">
      <h5 style="color:#0c4a6e;">Nearest Locations</h5>
      <div id="results">
        <p class="text-muted">Click "Find Nearest to Me" to see branches sorted by distance</p>
      </div>
    </div>
    <div class="col-lg-7">
      <div id="map"></div>
    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function() {
  const map = L.map('map').setView([-1.2921, 36.8219], 11);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap'
  }).addTo(map);

  let userMarker = null;
  let locationMarkers = [];

  document.getElementById('findMe').addEventListener('click', () => {
    if (!navigator.geolocation) return alert('Geolocation not supported');

    const btn = event.target;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Locating...';

    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;

        if (userMarker) map.removeLayer(userMarker);
        userMarker = L.marker([lat, lng], { 
          icon: L.divIcon({
            html: '<div style="background:#0284c7;width:20px;height:20px;border-radius:50%;border:4px solid white;box-shadow:0 2px 8px rgba(0,0,0,0.3)"></div>',
            iconSize: [20, 20]
          })
        }).addTo(map).bindPopup('You are here').openPopup();

        map.setView([lat, lng], 13);

        fetch(`/api/locations/nearest?lat=${lat}&lng=${lng}`)
          .then(r => r.json())
          .then(data => {
            renderResults(data.locations || []);
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-location-arrow me-2"></i>Find Nearest to Me';
          })
          .catch(err => {
            console.error(err);
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-location-arrow me-2"></i>Find Nearest to Me';
          });
      },
      (err) => {
        alert('Could not get location: ' + err.message);
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-location-arrow me-2"></i>Find Nearest to Me';
      },
      { enableHighAccuracy: true, timeout: 10000 }
    );
  });

  function renderResults(locations) {
    const container = document.getElementById('results');

    // Clear old markers
    locationMarkers.forEach(m => map.removeLayer(m));
    locationMarkers = [];

    if (locations.length === 0) {
      container.innerHTML = '<p class="text-muted">No locations found</p>';
      return;
    }

    container.innerHTML = locations.map(loc => `
      <div class="loc-result" data-lat="${loc.latitude}" data-lng="${loc.longitude}">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <h6 class="mb-0" style="color:#0c4a6e;">${loc.location_name}</h6>
          <span class="${loc.is_open_now ? 'open-badge' : 'closed-badge'}">
            ${loc.is_open_now ? 'OPEN NOW' : 'CLOSED'}
          </span>
        </div>
        <div class="text-muted small mb-1">
          <i class="fas fa-map-pin me-1"></i>${loc.address_line1}, ${loc.city}
        </div>
        ${loc.phone ? `<div class="text-muted small mb-1"><i class="fas fa-phone me-1"></i>${loc.phone}</div>` : ''}
        <div class="d-flex justify-content-between align-items-center mt-2">
          <span class="distance"><i class="fas fa-route me-1"></i>${loc.distance_km} km away</span>
          <a href="https://www.google.com/maps/dir/?api=1&destination=${loc.latitude},${loc.longitude}"
             target="_blank" class="btn btn-sm btn-outline-primary rounded-pill">
            <i class="fas fa-directions me-1"></i>Directions
          </a>
        </div>
      </div>
    `).join('');

    // Add markers to map
    locations.forEach(loc => {
      const marker = L.marker([loc.latitude, loc.longitude])
        .addTo(map)
        .bindPopup(`
          <strong>${loc.location_name}</strong><br>
          ${loc.address_line1}<br>
          <span style="color:#10b981;font-weight:700">${loc.distance_km} km away</span>
        `);
      locationMarkers.push(marker);
    });

    // Fit map to show all markers
    if (locationMarkers.length > 0) {
      const group = L.featureGroup([userMarker, ...locationMarkers]);
      map.fitBounds(group.getBounds().pad(0.15));
    }

    // Click to center
    container.querySelectorAll('.loc-result').forEach(el => {
      el.addEventListener('click', () => {
        const lat = parseFloat(el.dataset.lat);
        const lng = parseFloat(el.dataset.lng);
        map.setView([lat, lng], 16);
      });
    });
  }
})();
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>