<%- include('../layouts/main') %>

<style>
.page-header {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white;
  padding: 25px 0;
  margin-bottom: 30px;
}
.page-header h1 { color: white; font-weight: 800; margin: 0; }
.page-header .sub { color: rgba(255,255,255,0.9); margin-top: 4px; }

.stat-box { background: white; border-radius: 12px; padding: 16px; text-align: center; border: 1px solid #e0f2fe; }
.stat-box .v { font-size: 1.75rem; font-weight: 800; color: #f59e0b; }
.stat-box .l { font-size: 0.75rem; color: #64748b; text-transform: uppercase; }

.orders-table { background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 15px rgba(2,132,199,0.08); }
.orders-table table { margin: 0; }
.orders-table thead { background: #f0f9ff; }
.orders-table thead th { font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: 700; border: none; padding: 14px; }
.orders-table tbody td { padding: 14px; border-color: #f1f5f9; vertical-align: middle; }

.status-pill { padding: 3px 12px; border-radius: 12px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; }
.status-pending { background: #fef3c7; color: #92400e; }
.status-queued { background: #dbeafe; color: #1e40af; }
.status-in_progress { background: #e9d5ff; color: #6b21a8; }
.status-completed { background: #d1fae5; color: #065f46; }
.status-cancelled { background: #fee2e2; color: #991b1b; }
</style>

<div class="page-header">
  <div class="container">
    <h1><i class="fas fa-shopping-bag me-2"></i>Orders</h1>
    <div class="sub">All orders from your company</div>
  </div>
</div>

<div class="container pb-5">
  <%- include('../partials/flash') %>

  <div class="mb-3">
    <a href="/owner" class="btn btn-sm btn-outline-secondary rounded-pill">
      <i class="fas fa-arrow-left me-1"></i>Dashboard
    </a>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-2 col-6"><div class="stat-box"><div class="v"><%= stats.total || 0 %></div><div class="l">Total</div></div></div>
    <div class="col-md-2 col-6"><div class="stat-box"><div class="v" style="color:#f59e0b;"><%= stats.pending || 0 %></div><div class="l">Pending</div></div></div>
    <div class="col-md-2 col-6"><div class="stat-box"><div class="v" style="color:#3b82f6;"><%= stats.queued || 0 %></div><div class="l">Queued</div></div></div>
    <div class="col-md-2 col-6"><div class="stat-box"><div class="v" style="color:#8b5cf6;"><%= stats.in_progress || 0 %></div><div class="l">In Progress</div></div></div>
    <div class="col-md-2 col-6"><div class="stat-box"><div class="v" style="color:#10b981;"><%= stats.completed || 0 %></div><div class="l">Completed</div></div></div>
    <div class="col-md-2 col-6"><div class="stat-box"><div class="v" style="color:#0284c7;">KES <%= Number(stats.total_paid || 0).toLocaleString() %></div><div class="l">Paid</div></div></div>
  </div>

  <% if (orders.length === 0) { %>
    <div class="text-center py-5">
      <i class="fas fa-shopping-bag fa-4x mb-3" style="color:#bae6fd;"></i>
      <h4 style="color:#0c4a6e;">No orders yet</h4>
      <p class="text-muted">Orders will appear here when customers place them</p>
    </div>
  <% } else { %>
    <div class="orders-table">
      <table class="table">
        <thead>
          <tr>
            <th>Order #</th>
            <th>Customer</th>
            <th>Service</th>
            <th>Status</th>
            <th>Payment</th>
            <th class="text-end">Price</th>
            <th class="text-end">Date</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(o => { %>
            <tr>
              <td><strong style="font-size:0.85rem;"><%= o.order_number %></strong></td>
              <td><%= o.customer_name || o.customer_name || '—' %></td>
              <td><%= o.service_type %></td>
              <td><span class="status-pill status-<%= o.order_status %>"><%= o.order_status %></span></td>
              <td><span class="status-pill <%= o.payment_status === 'paid' ? 'status-completed' : 'status-pending' %>">
                <%= o.payment_status %>
              </span></td>
              <td class="text-end">KES <%= Number(o.price).toLocaleString() %></td>
              <td class="text-end text-muted" style="font-size:0.8rem;">
                <%= new Date(o.created_at).toLocaleDateString() %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>