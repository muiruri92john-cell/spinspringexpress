<%- include('../layouts/main') %>
<style>
.ss-auth {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #10b981, #059669);
  padding: 20px;
}
.ss-auth-card {
  background: white;
  border-radius: 25px;
  padding: 40px;
  box-shadow: 0 25px 60px rgba(16,185,129,0.3);
  max-width: 420px;
  width: 100%;
}
</style>
</head>
<body>
<div class="ss-auth">
  <div class="ss-auth-card">
    <div class="text-center mb-4">
      <i class="fas fa-user-tie fa-4x" style="color:#10b981;"></i>
      <h3 class="mt-2 fw-bold">Attendant Login</h3>
      <p class="text-muted">SpinSpring Staff Access</p>
    </div>
    <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>
    <form action="/spinspg/attendant-login" method="POST">
      <div class="mb-3">
        <label class="form-label fw-bold">Email</label>
        <input type="email" name="email" class="form-control" required>
      </div>
      <div class="mb-3">
        <label class="form-label fw-bold">PIN Code</label>
        <input type="password" name="pin_code" class="form-control" maxlength="6" required>
      </div>
      <button type="submit" class="btn btn-success w-100 py-3 fw-bold rounded-pill">
        <i class="fas fa-sign-in-alt me-2"></i> Login
      </button>
    </form>
    <div class="text-center mt-3">
      <a href="/spinspg/login" class="text-muted">Owner Login</a>
    </div>
  </div>
</div>
</body>
</html>