<%- include('../layouts/main') %>
<style>
.ss-auth { background: linear-gradient(135deg, #10b981, #059669); }
</style>
</head>
<body>
<div class="ss-auth">
  <div class="ss-auth-card">
    <div class="text-center mb-4">
      <i class="fas fa-user-tie fa-4x" style="color:#10b981;"></i>
      <h3 class="mt-2 fw-bold">Attendant Login</h3>
      <p class="text-muted">Staff Access</p>
    </div>
    <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>
    <form action="/attendant-login" method="POST">
      <div class="mb-3">
        <label class="form-label fw-bold">Email</label>
        <input type="email" name="email" class="form-control" required>
      </div>
      <div class="mb-3">
        <label class="form-label fw-bold">PIN Code</label>
        <input type="password" name="pin_code" class="form-control" maxlength="6" required>
      </div>
      <button type="submit" class="btn w-100 py-3 fw-bold rounded-pill" style="background:#10b981;border:none;color:white;">
        <i class="fas fa-sign-in-alt me-2"></i> Login
      </button>
    </form>
    <div class="text-center mt-3">
      <a href="/login">Owner Login</a> |
      <a href="/">Home</a>
    </div>
  </div>
</div>
</body>
</html>