<%- include('../layouts/main') %>

<style>
.auth-wrapper {
  min-height: 90vh;
  background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
  padding: 40px 15px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.auth-card {
  background: white;
  border-radius: 24px;
  padding: 40px;
  max-width: 520px;
  width: 100%;
  box-shadow: 0 25px 60px rgba(2,132,199,0.2);
}
.auth-card h2 { color: #0c4a6e; font-weight: 800; text-align: center; margin-bottom: 8px; }
.auth-card .sub { text-align: center; color: #64748b; margin-bottom: 30px; }
.auth-icon {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  color: white;
  font-size: 2rem;
}
.invite-banner {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border: 2px solid #f59e0b;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.invite-banner i { color: #d97706; font-size: 1.5rem; }
.invite-banner strong { color: #92400e; }
.invite-banner small { color: #78350f; display: block; }
</style>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-icon">
      <i class="fas fa-building"></i>
    </div>

    <h2>Register Your Company</h2>
    <p class="sub">You need an invite code from an existing partner</p>

    <%- include('../partials/flash') %>

    <% if (requiresInvite && !inviteCode) { %>
      <div class="invite-banner">
        <i class="fas fa-lock"></i>
        <div>
          <strong>Invite Required</strong>
          <small>Contact an existing partner to get an invite code</small>
        </div>
      </div>
    <% } %>

    <form method="POST" action="/register">
      <div class="mb-3">
        <label class="form-label fw-bold">
          <i class="fas fa-key me-1" style="color:#f59e0b;"></i>
          Invite Code *
        </label>
        <input type="text" name="invite_code" class="form-control" required
               value="<%= inviteCode || '' %>"
               placeholder="e.g., OWN-XXXXXXXX" maxlength="32"
               style="font-family:monospace;font-weight:700;letter-spacing:1px;">
        <small class="text-muted">Required — get this from an existing partner</small>
      </div>

      <hr class="my-3">

      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label fw-bold">Company Name *</label>
          <input type="text" name="company_name" class="form-control" required
                 placeholder="e.g., Sparkle Laundry" maxlength="150">
        </div>
        <div class="col-md-6">
          <label class="form-label fw-bold">Your Full Name *</label>
          <input type="text" name="contact_name" class="form-control" required
                 placeholder="John Doe" maxlength="100">
        </div>
        <div class="col-md-6">
          <label class="form-label fw-bold">Email *</label>
          <input type="email" name="email" class="form-control" required
                 placeholder="you@company.com">
        </div>
        <div class="col-md-6">
          <label class="form-label fw-bold">Phone</label>
          <input type="tel" name="phone" class="form-control"
                 placeholder="+254..." maxlength="20">
        </div>
        <div class="col-12">
          <label class="form-label fw-bold">Address</label>
          <input type="text" name="address" class="form-control"
                 placeholder="Building, street" maxlength="255">
        </div>
        <div class="col-md-6">
          <label class="form-label fw-bold">City</label>
          <input type="text" name="city" class="form-control" value="Nairobi" maxlength="100">
        </div>
        <div class="col-md-6"></div>
        <div class="col-md-6">
          <label class="form-label fw-bold">Password *</label>
          <input type="password" name="password" class="form-control" required
                 placeholder="Min 6 characters" minlength="6">
        </div>
        <div class="col-md-6">
          <label class="form-label fw-bold">Confirm Password *</label>
          <input type="password" name="password2" class="form-control" required
                 placeholder="Repeat password">
        </div>
      </div>

      <button type="submit" class="ss-btn w-100 mt-4" style="padding:14px;">
        <i class="fas fa-check-circle me-2"></i>Create Account
      </button>
    </form>

    <div class="text-center mt-4">
      <p class="text-muted mb-2">Already have an account?</p>
      <a href="/login" class="ss-btn ss-btn-outline">
        <i class="fas fa-sign-in-alt me-2"></i>Login
      </a>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/pwa.js" defer></script>
</body>
</html>