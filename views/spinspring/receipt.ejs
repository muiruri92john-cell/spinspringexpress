<%- include('../layouts/main') %>
<style>
.receipt-container {
  max-width: 400px;
  margin: 20px auto;
  background: white;
  border-radius: 15px;
  padding: 30px;
  box-shadow: 0 5px 25px rgba(0,0,0,0.1);
  font-family: 'Courier New', monospace;
}
.receipt-header {
  text-align: center;
  border-bottom: 2px dashed #0284c7;
  padding-bottom: 15px;
  margin-bottom: 15px;
}
.receipt-header h3 {
  color: #0284c7;
  margin: 0;
  font-weight: 800;
}
.receipt-header p {
  margin: 5px 0;
  color: #64748b;
  font-size: 0.85rem;
}
.receipt-row {
  display: flex;
  justify-content: space-between;
  padding: 5px 0;
  font-size: 0.9rem;
}
.receipt-total {
  border-top: 2px dashed #0284c7;
  margin-top: 15px;
  padding-top: 15px;
  font-weight: 800;
  font-size: 1.2rem;
}
.receipt-footer {
  text-align: center;
  margin-top: 20px;
  font-size: 0.75rem;
  color: #94a3b8;
}
.print-btn {
  display: block;
  width: 100%;
  background: #0284c7;
  color: white;
  border: none;
  padding: 12px;
  border-radius: 50px;
  font-weight: 700;
  cursor: pointer;
  margin-top: 15px;
}
.qr-section {
  text-align: center;
  margin: 20px 0;
  padding: 15px;
  background: #f8fafc;
  border-radius: 10px;
}
.qr-section img {
  width: 150px;
  height: 150px;
}
.qr-section p {
  font-family: monospace;
  font-size: 0.7rem;
  margin-top: 5px;
  color: #64748b;
}
@media print {
  .no-print { display: none !important; }
  body { background: white; }
  .receipt-container {
    box-shadow: none;
    margin: 0;
    padding: 20px;
    max-width: 100%;
  }
}
</style>
</head>
<body>
<div class="container py-4">
  <div class="receipt-container" id="receiptContent">
    <!-- Header -->
    <div class="receipt-header">
      <h3>SpinSpring Express</h3>
      <p>Smart Laundry Automation</p>
      <p>Receipt: <%= receipt.receipt_number %></p>
      <p><%= new Date(receipt.date).toLocaleString() %></p>
    </div>

    <!-- Order Info -->
    <div class="receipt-row">
      <span>Order #</span>
      <span><%= receipt.order_number %></span>
    </div>
    <div class="receipt-row">
      <span>Customer</span>
      <span><%= receipt.customer_name %></span>
    </div>
    <% if (receipt.customer_phone) { %>
    <div class="receipt-row">
      <span>Phone</span>
      <span><%= receipt.customer_phone %></span>
    </div>
    <% } %>

    <div style="border-top:1px dashed #e2e8f0;margin:10px 0;"></div>

    <!-- Billing Details -->
    <div class="receipt-row">
      <span>Billing Type</span>
      <span><%= receipt.billing_type.replace('_', ' ').toUpperCase() %></span>
    </div>

    <% if (receipt.billing_type === 'per_weight') { %>
      <div class="receipt-row">
        <span>Weight</span>
        <span><%= receipt.weight_kg %> kg</span>
      </div>
      <div class="receipt-row">
        <span>Rate</span>
        <span>Ksh <%= receipt.rate_per_kg %>/kg</span>
      </div>
    <% } else { %>
      <div class="receipt-row">
        <span>Price/Cycle</span>
        <span>Ksh <%= receipt.cycle_price %></span>
      </div>
      <div class="receipt-row">
        <span>Quantity</span>
        <span><%= receipt.quantity %></span>
      </div>
    <% } %>

    <div class="receipt-row">
      <span>Subtotal</span>
      <span>Ksh <%= receipt.subtotal %></span>
    </div>
    <% if (receipt.discount > 0) { %>
    <div class="receipt-row">
      <span>Discount</span>
      <span>-Ksh <%= receipt.discount %></span>
    </div>
    <% } %>

    <!-- Total -->
    <div class="receipt-total receipt-row">
      <span>TOTAL</span>
      <span>Ksh <%= receipt.total %></span>
    </div>

    <!-- Payment Info -->
    <div class="receipt-row">
      <span>Payment</span>
      <span><%= receipt.payment_method.toUpperCase() %></span>
    </div>
    <div class="receipt-row">
      <span>Attendant</span>
      <span><%= receipt.attendant %></span>
    </div>

    <!-- QR Code Section -->
    <div class="qr-section">
      <p class="text-muted mb-2">Scan to verify receipt</p>
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= encodeURIComponent('https://spinspringexpress.co.ke/verify?receipt=' + receipt.receipt_number + '&order=' + receipt.order_number) %>" 
           alt="QR Code">
      <p><%= receipt.receipt_number %></p>
    </div>

    <!-- Footer -->
    <div class="receipt-footer">
      <p>Thank you for choosing SpinSpring Express!</p>
      <p>Keep this receipt for reference</p>
    </div>
  </div>

  <!-- Buttons (hidden when printing) -->
  <div class="text-center mt-3 no-print">
    <button class="print-btn" onclick="window.print()" style="max-width:400px;margin:0 auto 10px;">
      <i class="fas fa-print me-2"></i> Print Receipt
    </button>
    <br>
    <a href="/attendant" class="btn btn-outline-primary rounded-pill">
      <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
    </a>
  </div>
</div>

<script>
// Auto-print on load (only once)
window.onload = function() {
  if (!window.location.search.includes('noprint')) {
    setTimeout(function() {
      window.print();
    }, 1500);
  }
};
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>