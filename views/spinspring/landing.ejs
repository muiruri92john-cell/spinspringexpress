<%- include('../layouts/main') %>
<style>
:root {
  --ss-primary: #0284c7;
  --ss-secondary: #38bdf8;
  --ss-accent: #0ea5e9;
  --ss-light: #f0f9ff;
  --ss-white: #ffffff;
  --ss-dark: #0c4a6e;
  --ss-bg: #f8fafc;
}
body { background: var(--ss-bg); padding-top: 0 !important; }

/* ===== NAV BAR ===== */
.ss-nav {
  background: white;
  box-shadow: 0 2px 15px rgba(2,132,199,0.15);
  padding: 15px 0;
  position: sticky;
  top: 0;
  z-index: 9999;
  display: block !important;
  visibility: visible !important;
}
.ss-nav .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}
.ss-nav .brand {
  font-size: 1.5rem;
  font-weight: 800;
  color: #0284c7;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 8px;
}
.ss-nav .nav-menu {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
  list-style: none;
  margin: 0;
  padding: 0;
}
.ss-nav .nav-link {
  color: #0c4a6e;
  font-weight: 600;
  padding: 10px 18px;
  border-radius: 50px;
  transition: all 0.3s;
  text-decoration: none;
  font-size: 0.95rem;
  display: inline-block;
}
.ss-nav .nav-link:hover {
  background: #f0f9ff;
  color: #0284c7;
}
.ss-nav .nav-btn {
  padding: 10px 22px;
  border-radius: 50px;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.3s;
  font-size: 0.9rem;
  color: white;
  display: inline-block;
}
.ss-nav .nav-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(0,0,0,0.15);
  color: white;
}

/* Mobile toggle */
.nav-toggle {
  display: none;
  background: #0284c7;
  color: white;
  border: none;
  padding: 10px 15px;
  border-radius: 8px;
  font-size: 1.2rem;
  cursor: pointer;
}
@media (max-width: 991px) {
  .nav-toggle { display: block; }
  .ss-nav .nav-menu {
    display: none;
    width: 100%;
    flex-direction: column;
    align-items: stretch;
  }
  .ss-nav .nav-menu.show { display: flex; }
  .ss-nav .nav-link, .ss-nav .nav-btn { width: 100%; text-align: center; }
}

/* ===== HERO ===== */
.ss-hero {
  background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 50%, #38bdf8 100%);
  padding: 80px 0 100px;
  position: relative;
  overflow: hidden;
}
.ss-hero::before {
  content: '';
  position: absolute;
  top: -50%; right: -20%;
  width: 500px; height: 500px;
  background: rgba(255,255,255,0.05);
  border-radius: 50%;
}
.ss-hero-content { position: relative; z-index: 2; }
.ss-hero h1 {
  color: white;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 800;
  margin-bottom: 15px;
}
.ss-hero .tagline {
  color: rgba(255,255,255,0.95);
  font-size: clamp(1rem, 2vw, 1.3rem);
  margin-bottom: 25px;
}
.ss-hero .badge-light {
  background: white;
  color: #0284c7;
  padding: 8px 20px;
  border-radius: 50px;
  font-weight: 700;
  display: inline-block;
  margin-bottom: 20px;
  font-size: 0.9rem;
}

/* ===== SECTION COMMON ===== */
.ss-section {
  padding: 70px 0;
  display: block !important;
  visibility: visible !important;
}
.ss-section-title {
  text-align: center;
  margin-bottom: 50px;
}
.ss-section-title h2 {
  color: #0c4a6e;
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  font-weight: 800;
  margin-bottom: 10px;
}
.ss-section-title p {
  color: #64748b;
  font-size: 1.05rem;
}

/* ===== PRICING CARDS ===== */
.pricing-card {
  background: white;
  border-radius: 20px;
  padding: 30px;
  box-shadow: 0 5px 25px rgba(2,132,199,0.1);
  border: 1px solid #e0f2fe;
  height: 100%;
  transition: all 0.3s;
}
.pricing-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 40px rgba(2,132,199,0.2);
}
.pricing-card h4 {
  color: #0284c7;
  font-weight: 800;
  border-bottom: 2px solid #e0f2fe;
  padding-bottom: 15px;
  margin-bottom: 20px;
  font-size: 1.2rem;
}
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f1f5f9;
  font-size: 0.95rem;
}
.price-row:last-child { border-bottom: none; }
.price-row .price {
  font-weight: 700;
  color: #0284c7;
  font-size: 1rem;
  white-space: nowrap;
}

/* ===== SERVICE / SPECIAL ITEM CARDS ===== */
.service-card {
  background: white;
  border-radius: 20px;
  padding: 30px 20px;
  text-align: center;
  box-shadow: 0 3px 15px rgba(0,0,0,0.05);
  transition: all 0.3s;
  height: 100%;
}
.service-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}
.service-card .icon-wrap {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: #f0f9ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
}
.service-card .icon-wrap i {
  font-size: 2rem;
  color: #0284c7;
}
.service-card h5 {
  color: #0c4a6e;
  font-weight: 700;
  margin-bottom: 10px;
}
.service-card p {
  color: #64748b;
  font-size: 0.9rem;
  margin: 0;
}

/* ===== PROCESS STEPS ===== */
.process-card {
  background: white;
  border-radius: 20px;
  padding: 35px 25px;
  text-align: center;
  box-shadow: 0 5px 20px rgba(0,0,0,0.05);
  height: 100%;
  position: relative;
}
.step-num {
  width: 60px;
  height: 60px;
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 1.5rem;
  margin: 0 auto 20px;
  box-shadow: 0 5px 15px rgba(2,132,199,0.3);
}
.process-card h5 {
  color: #0c4a6e;
  font-weight: 700;
  margin-bottom: 10px;
}
.process-card p {
  color: #64748b;
  font-size: 0.9rem;
}

/* ===== TESTIMONIALS ===== */
.testimonial-card {
  background: white;
  border-radius: 20px;
  padding: 30px;
  box-shadow: 0 5px 20px rgba(0,0,0,0.05);
  height: 100%;
}
.testimonial-card .stars {
  color: #f59e0b;
  font-size: 1.1rem;
  margin-bottom: 15px;
}
.testimonial-card p {
  color: #64748b;
  font-style: italic;
  margin-bottom: 15px;
}
.testimonial-card strong {
  color: #0c4a6e;
}

/* ===== STATS ===== */
.stat-box {
  text-align: center;
  padding: 20px;
}
.stat-box .num {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  color: #0284c7;
}
.stat-box .lbl {
  color: #64748b;
  font-size: 0.9rem;
  margin-top: 5px;
}

/* ===== CTA ===== */
.cta-section {
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  padding: 70px 0;
  text-align: center;
  color: white;
}

/* ===== WHATSAPP FLOAT ===== */
.wa-float {
  position: fixed;
  bottom: 30px;
  right: 30px;
  width: 60px;
  height: 60px;
  background: #25D366;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  box-shadow: 0 5px 25px rgba(37,211,102,0.5);
  z-index: 9998;
  text-decoration: none;
  animation: waBounce 2s infinite;
}
.wa-float:hover { color: white; transform: scale(1.1); }
@keyframes waBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
  .ss-hero { padding: 50px 0 70px; }
  .ss-section { padding: 50px 0; }
  .wa-float { width: 50px; height: 50px; font-size: 26px; bottom: 20px; right: 20px; }
}
</style>
</head>
