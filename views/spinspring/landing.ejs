<%- include('../layouts/main') %>

<style>
/* ===== CSS VARIABLES ===== */
:root {
  --ss-primary: #0284c7;
  --ss-secondary: #38bdf8;
  --ss-accent: #0ea5e9;
  --ss-light: #f0f9ff;
  --ss-white: #ffffff;
  --ss-dark: #0c4a6e;
  --ss-success: #10b981;
  --ss-bg: #f8fafc;
}

/* ===== GLOBAL OVERRIDES ===== */
body {
  padding-top: 0 !important;
  margin-top: 0 !important;
  background: var(--ss-bg);
}

/* ===== NAVIGATION ===== */
nav.ss-nav,
.ss-nav {
  background: var(--ss-white) !important;
  background-image: none !important;
  padding: 15px 0 !important;
  box-shadow: 0 2px 15px rgba(2, 132, 199, 0.15) !important;
  display: block !important;
  position: sticky !important;
  top: 0 !important;
  z-index: 9999 !important;
  width: 100% !important;
}

.ss-nav .container {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  flex-wrap: wrap !important;
  gap: 15px !important;
  max-width: 1200px !important;
  margin: 0 auto !important;
  padding: 0 20px !important;
}

.ss-nav a.brand,
.ss-nav .brand {
  color: var(--ss-primary) !important;
  font-size: 1.5rem !important;
  font-weight: 800 !important;
  text-decoration: none !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
}

.ss-nav ul.nav-menu {
  display: flex !important;
  gap: 8px !important;
  list-style: none !important;
  margin: 0 !important;
  padding: 0 !important;
  align-items: center !important;
  flex-wrap: wrap !important;
}

.ss-nav ul.nav-menu li {
  display: inline-block !important;
  list-style: none !important;
}

.ss-nav a.nav-link {
  color: var(--ss-dark) !important;
  font-weight: 600 !important;
  padding: 10px 18px !important;
  border-radius: 50px !important;
  text-decoration: none !important;
  font-size: 0.95rem !important;
  display: inline-block !important;
  transition: all 0.3s !important;
}

.ss-nav a.nav-link:hover {
  background: var(--ss-light) !important;
  color: var(--ss-primary) !important;
}

.ss-nav a.nav-btn {
  padding: 10px 22px !important;
  border-radius: 50px !important;
  font-weight: 700 !important;
  text-decoration: none !important;
  font-size: 0.9rem !important;
  color: white !important;
  display: inline-block !important;
  transition: all 0.3s !important;
  border: none !important;
}

.ss-nav a.nav-btn:hover {
  transform: translateY(-2px) !important;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15) !important;
  color: white !important;
}

.ss-nav .nav-toggle {
  display: none;
  background: var(--ss-primary);
  color: white;
  border: none;
  padding: 10px 15px;
  border-radius: 8px;
  font-size: 1.2rem;
  cursor: pointer;
}

/* ===== HERO SECTION ===== */
.ss-hero {
  background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 50%, #38bdf8 100%);
  padding: 80px 0 100px;
  position: relative;
  overflow: hidden;
}

.ss-hero::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 500px;
  height: 500px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.ss-hero-content {
  position: relative;
  z-index: 2;
}

.ss-hero h1 {
  color: white;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 800;
  margin-bottom: 15px;
}

.ss-hero .tagline {
  color: rgba(255, 255, 255, 0.95);
  font-size: clamp(1rem, 2vw, 1.3rem);
  margin-bottom: 25px;
}

.ss-hero .badge-light {
  background: white;
  color: var(--ss-primary);
  padding: 8px 20px;
  border-radius: 50px;
  font-weight: 700;
  display: inline-block;
  margin-bottom: 20px;
  font-size: 0.9rem;
}

.hero-image-box {
  background: white;
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

.hero-image-box img {
  width: 100%;
  border-radius: 15px;
  display: block;
}

/* ===== SECTIONS ===== */
.ss-section {
  padding: 70px 0;
  display: block !important;
  visibility: visible !important;
}

.ss-section-title {
  text-align: center;
  margin-bottom: 50px;
}

.ss-section-title h2 {
  color: var(--ss-dark);
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  font-weight: 800;
  margin-bottom: 10px;
}

.ss-section-title p {
  color: #64748b;
  font-size: 1.05rem;
}

/* ===== LOCATION CARDS (NEW) ===== */
.location-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 24px;
}

.location-card {
  background: white;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 5px 25px rgba(2, 132, 199, 0.1);
  border: 1px solid #e0f2fe;
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
}

.location-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 40px rgba(2, 132, 199, 0.2);
}

.location-card .loc-header {
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  color: white;
  padding: 20px 24px;
  position: relative;
}

.location-card .loc-header h5 {
  color: white;
  margin: 0 0 4px;
  font-weight: 800;
  font-size: 1.15rem;
}

.location-card .loc-header .loc-code {
  font-size: 0.75rem;
  opacity: 0.85;
  font-family: monospace;
}

.location-card .loc-badge-primary {
  position: absolute;
  top: 16px;
  right: 16px;
  background: white;
  color: #10b981;
  padding: 3px 10px;
  border-radius: 12px;
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.5px;
}

.location-card .loc-badge-open {
  position: absolute;
  top: 16px;
  right: 16px;
  background: rgba(255,255,255,0.95);
  color: #065f46;
  padding: 3px 10px;
  border-radius: 12px;
  font-size: 0.65rem;
  font-weight: 800;
}
.location-card .loc-badge-closed {
  position: absolute;
  top: 16px;
  right: 16px;
  background: rgba(254,226,226,0.95);
  color: #991b1b;
  padding: 3px 10px;
  border-radius: 12px;
  font-size: 0.65rem;
  font-weight: 800;
}

.location-card .loc-body {
  padding: 20px 24px;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.location-card .loc-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.9rem;
  color: #475569;
}

.location-card .loc-row i {
  color: #0284c7;
  width: 18px;
  flex-shrink: 0;
  margin-top: 2px;
}

.location-card .loc-actions {
  display: flex;
  gap: 8px;
  padding: 0 24px 20px;
}

.location-card .loc-actions a,
.location-card .loc-actions button {
  flex: 1;
  padding: 9px 12px;
  border-radius: 50px;
  font-size: 0.85rem;
  font-weight: 700;
  text-align: center;
  text-decoration: none;
  transition: all 0.2s;
  border: none;
  cursor: pointer;
}

.location-card .btn-map {
  background: var(--ss-primary);
  color: white;
}
.location-card .btn-map:hover { background: #026aa1; color: white; }

.location-card .btn-wa {
  background: #25D366;
  color: white;
}
.location-card .btn-wa:hover { background: #1eab52; color: white; }

/* Distance badge (appears after GPS) */
.location-card .distance-badge {
  display: none;
  margin-top: 4px;
  font-size: 0.8rem;
  color: #10b981;
  font-weight: 800;
}
.location-card .distance-badge.show { display: block; }

/* ===== NEAREST BANNER (NEW) ===== */
.nearest-banner {
  background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
  border: 2px solid #bae6fd;
  border-radius: 20px;
  padding: 24px;
  margin-bottom: 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
}
.nearest-banner h4 {
  color: #0c4a6e;
  margin: 0 0 4px;
  font-weight: 800;
}
.nearest-banner p {
  color: #64748b;
  margin: 0;
  font-size: 0.95rem;
}
.nearest-banner button {
  background: var(--ss-primary);
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 50px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  font-size: 0.95rem;
}
.nearest-banner button:hover {
  background: #026aa1;
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(2, 132, 199, 0.3);
}
.nearest-banner button:disabled {
  opacity: 0.6;
  cursor: wait;
}

/* ===== PRICING CARDS ===== */
.pricing-card {
  background: white;
  border-radius: 20px;
  padding: 30px;
  box-shadow: 0 5px 25px rgba(2, 132, 199, 0.1);
  border: 1px solid #e0f2fe;
  height: 100%;
  transition: all 0.3s;
}

.pricing-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 40px rgba(2, 132, 199, 0.2);
}

.pricing-card h4 {
  color: var(--ss-primary);
  font-weight: 800;
  border-bottom: 2px solid #e0f2fe;
  padding-bottom: 15px;
  margin-bottom: 20px;
  font-size: 1.2rem;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f1f5f9;
  font-size: 0.95rem;
}

.price-row:last-child {
  border-bottom: none;
}

.price-row .price {
  font-weight: 700;
  color: var(--ss-primary);
  font-size: 1rem;
  white-space: nowrap;
}

/* ===== SERVICE CARDS ===== */
.service-card {
  background: white;
  border-radius: 20px;
  padding: 30px 20px;
  text-align: center;
  box-shadow: 0 3px 15px rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
  height: 100%;
}

.service-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.service-card .icon-wrap {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: var(--ss-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
}

.service-card .icon-wrap i {
  font-size: 2rem;
  color: var(--ss-primary);
}

.service-card h5 {
  color: var(--ss-dark);
  font-weight: 700;
  margin-bottom: 10px;
}

.service-card p {
  color: #64748b;
  font-size: 0.9rem;
  margin: 0;
}

/* ===== PROCESS CARDS ===== */
.process-card {
  background: white;
  border-radius: 20px;
  padding: 35px 25px;
  text-align: center;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
  height: 100%;
}

.step-num {
  width: 60px;
  height: 60px;
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 1.5rem;
  margin: 0 auto 20px;
  box-shadow: 0 5px 15px rgba(2, 132, 199, 0.3);
}

.process-card h5 {
  color: var(--ss-dark);
  font-weight: 700;
  margin-bottom: 10px;
}

.process-card p {
  color: #64748b;
  font-size: 0.9rem;
}

/* ===== GALLERY ===== */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 20px;
}

.gallery-item {
  position: relative;
  border-radius: 15px;
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--ss-light);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s;
}

.gallery-item:hover img {
  transform: scale(1.05);
}

.gallery-item .placeholder-icon {
  font-size: 4rem;
  color: #bae6fd;
}

.gallery-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(12, 74, 110, 0.95));
  color: white;
  padding: 20px;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.gallery-item:hover .gallery-overlay {
  transform: translateY(0);
}

/* ===== TESTIMONIALS ===== */
.testimonial-card {
  background: white;
  border-radius: 20px;
  padding: 30px;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
  height: 100%;
}

.testimonial-card .stars {
  color: #f59e0b;
  font-size: 1.1rem;
  margin-bottom: 15px;
}

.testimonial-card p {
  color: #64748b;
  font-style: italic;
  margin-bottom: 15px;
}

.testimonial-card strong {
  color: var(--ss-dark);
}

/* ===== STATS ===== */
.stat-box {
  text-align: center;
  padding: 20px;
}

.stat-box .num {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  color: var(--ss-primary);
}

.stat-box .lbl {
  color: #64748b;
  font-size: 0.9rem;
  margin-top: 5px;
}

/* ===== CTA SECTION ===== */
.cta-section {
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  padding: 70px 0;
  text-align: center;
  color: white;
}

/* ===== WHATSAPP FLOAT ===== */
.wa-float {
  position: fixed;
  bottom: 30px;
  right: 30px;
  width: 60px;
  height: 60px;
  background: #25D366;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  box-shadow: 0 5px 25px rgba(37, 211, 102, 0.5);
  z-index: 9998;
  text-decoration: none;
  animation: waBounce 2s infinite;
}

.wa-float:hover {
  color: white;
  transform: scale(1.1);
}

@keyframes waBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 991px) {
  .ss-nav .nav-toggle {
    display: block !important;
  }

  .ss-nav ul.nav-menu {
    display: none !important;
    width: 100%;
    flex-direction: column;
    align-items: stretch;
  }

  .ss-nav ul.nav-menu.show {
    display: flex !important;
  }

  .ss-nav a.nav-link,
  .ss-nav a.nav-btn {
    width: 100%;
    text-align: center;
  }
}

@media (max-width: 768px) {
  .ss-hero {
    padding: 50px 0 70px;
  }

  .ss-section {
    padding: 50px 0;
  }

  .wa-float {
    width: 50px;
    height: 50px;
    font-size: 26px;
    bottom: 20px;
    right: 20px;
  }

  .nearest-banner {
    flex-direction: column;
    text-align: center;
  }
}
</style>

