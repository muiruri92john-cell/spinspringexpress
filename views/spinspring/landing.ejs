        <i class="fas fa-washing-machine placeholder-icon" style="display:none;"></i>
        <div class="gallery-overlay">
          <h6>Industrial Washers</h6>
          <small>Modern equipment</small>
        </div>
      </div>
      <div class="gallery-item">
        <img src="/images/spinspring/lounge.jpg" alt="Lounge"
             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
        <i class="fas fa-couch placeholder-icon" style="display:none;"></i>
        <div class="gallery-overlay">
          <h6>Lounge & Waiting Area</h6>
          <small>Comfortable space</small>
        </div>
      </div>
      <div class="gallery-item">
        <img src="/images/spinspring/lcd.jpg" alt="LCD Display"
             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
        <i class="fas fa-tv placeholder-icon" style="display:none;"></i>
