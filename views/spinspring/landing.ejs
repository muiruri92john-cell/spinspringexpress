<!-- ===== GALLERY ===== -->
<section id="gallery" class="ss-section" style="background:#f8fafc;">
  <div class="container">
    <div class="ss-section-title">
      <h2>Our Facilities</h2>
      <p>Modern, clean, and designed for your comfort</p>
    </div>
