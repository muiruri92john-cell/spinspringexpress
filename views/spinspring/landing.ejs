<%- include('../layouts/main') %>
<style>
:root {
  --ss-primary: #0284c7;
  --ss-secondary: #38bdf8;
  --ss-accent: #0ea5e9;
  --ss-light: #f0f9ff;
  --ss-white: #ffffff;
  --ss-dark: #0c4a6e;
  --ss-bg: #f8fafc;
}

body { background: var(--ss-bg); }

/* Navigation */
.ss-nav {
  background: rgba(255,255,255,0.98);
  backdrop-filter: blur(10px);
  box-shadow: 0 2px 15px rgba(2,132,199,0.1);
  padding: 12px 0;
  position: sticky;
  top: 0;
  z-index: 1000;
}
.ss-nav .brand {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--ss-primary);
  text-decoration: none;
}
.ss-nav .brand i { margin-right: 8px; }
.ss-nav .nav-link {
  color: var(--ss-dark);
  font-weight: 600;
  padding: 8px 16px;
  border-radius: 50px;
  transition: all 0.3s;
  text-decoration: none;
}
.ss-nav .nav-link:hover {
  background: var(--ss-light);
  color: var(--ss-primary);
}
.ss-nav .nav-btn {
  padding: 8px 20px;
  border-radius: 50px;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.3s;
  font-size: 0.9rem;
}

/* Hero */
.ss-hero {
  background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 50%, #38bdf8 100%);
  padding: 60px 0 100px;
  position: relative;
  overflow: hidden;
}
.ss-hero::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 500px;
  height: 500px;
  background: rgba(255,255,255,0.05);
  border-radius: 50%;
}
.ss-hero h1 {
  color: white;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 800;
  margin-bottom: 15px;
}
.ss-hero .tagline {
  color: rgba(255,255,255,0.9);
  font-size: clamp(1rem, 2vw, 1.3rem);
  margin-bottom: 25px;
}
.ss-hero .hero-image {
  border-radius: 20px;
  box-shadow: 0 25px 60px rgba(0,0,0,0.3);
  overflow: hidden;
  min-height: 250px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
}
.ss-hero .hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.ss-hero .hero-image .placeholder-icon {
  font-size: clamp(3rem, 8vw, 8rem);
  color: var(--ss-primary);
  opacity: 0.3;
}

/* Role Cards */
.role-section { margin-top: -50px; position: relative; z-index: 10; }
.role-card {
  background: white;
  border-radius: 25px;
  padding: 30px 20px;
  text-align: center;
  box-shadow: 0 15px 40px rgba(2,132,199,0.15);
  transition: all 0.3s;
  border: 2px solid transparent;
  height: 100%;
}
.role-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 25px 60px rgba(2,132,199,0.25);
}
.role-card.owner { border-color: #0284c7; }
.role-card.attendant { border-color: #10b981; }
.role-card.customer { border-color: #f59e0b; }
.role-card .role-icon {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 15px;
  font-size: 2rem;
  color: white;
}
.role-card.owner .role-icon { background: linear-gradient(135deg, #0284c7, #0ea5e9); }
.role-card.attendant .role-icon { background: linear-gradient(135deg, #10b981, #059669); }
.role-card.customer .role-icon { background: linear-gradient(135deg, #f59e0b, #d97706); }
.role-card h4 { color: var(--ss-dark); font-weight: 700; font-size: 1.1rem; }
.role-card p { color: #64748b; font-size: 0.85rem; }

/* Features */
.feature-card {
  background: white;
  border-radius: 20px;
  padding: 25px 15px;
  text-align: center;
  box-shadow: 0 5px 20px rgba(0,0,0,0.05);
  transition: all 0.3s;
  height: 100%;
}
.feature-card:hover { transform: translateY(-5px); box-shadow: 0 15px 40px rgba(0,0,0,0.1); }
.feature-card i { font-size: 2.5rem; color: var(--ss-primary); margin-bottom: 12px; }
.feature-card h5 { color: var(--ss-dark); font-weight: 700; font-size: 1rem; }
.feature-card p { font-size: 0.8rem; }

/* Gallery */
.gallery-section { background: white; }
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 15px;
}
.gallery-item {
  position: relative;
  border-radius: 15px;
  overflow: hidden;
  cursor: pointer;
  min-height: 200px;
  background: var(--ss-light);
  border: 2px dashed #bae6fd;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  min-height: 200px;
}
.gallery-item .placeholder-icon { font-size: 3rem; color: #bae6fd; }
.gallery-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(12,74,110,0.9));
  color: white;
  padding: 15px;
  opacity: 0;
  transition: opacity 0.3s;
}
.gallery-item:hover .gallery-overlay { opacity: 1; }

/* Stats */
.stat-number { font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 800; color: var(--ss-primary); }
.stat-label { color: #64748b; font-size: 0.8rem; }

/* CTA */
.cta-section {
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  padding: 50px 0;
  text-align: center;
  color: white;
}
.cta-section h2 { font-size: clamp(1.3rem, 3vw, 2rem); }

/* Section Titles */
.section-title { font-size: clamp(1.3rem, 3vw, 2rem); }
.section-subtitle { font-size: clamp(0.9rem, 1.5vw, 1.1rem); }

/* Responsive Breakpoints */
@media (max-width: 991px) {
  .ss-hero { padding: 50px 0 80px; }
  .role-section { margin-top: -35px; }
}

@media (max-width: 768px) {
  .ss-hero { padding: 40px 0 70px; }
  .ss-hero h1 { font-size: 2rem; }
  .role-card { padding: 20px 15px; }
  .role-card .role-icon { width: 55px; height: 55px; font-size: 1.5rem; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .gallery-item { min-height: 150px; }
  .gallery-item img { min-height: 150px; }
  .cta-section .btn { display: block; width: 100%; margin-bottom: 8px; }
}

@media (max-width: 480px) {
  .ss-hero { padding: 30px 0 60px; }
  .gallery-grid { grid-template-columns: 1fr; }
  .feature-card { padding: 20px 10px; }
}
</style>
</head>
<body>

<!-- Navigation Bar -->
<nav class="ss-nav">
  <div class="container d-flex justify-content-between align-items-center">
    <a href="/spinspg" class="brand">
      <i class="fas fa-soap"></i>SpinSpring
    </a>
    <button class="navbar-toggler d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#ssNav" style="border:none;font-size:1.5rem;color:var(--ss-primary);">
      ☰
    </button>
    <div class="d-none d-md-flex align-items-center gap-2">
      <a href="/spinspg" class="nav-link">Home</a>
      <a href="#features" class="nav-link">Features</a>
      <a href="#gallery" class="nav-link">Gallery</a>
      <a href="#roles" class="nav-link">Portals</a>
      <a href="/spinspg/login" class="nav-btn" style="background:#0284c7;color:white;">Owner Login</a>
      <a href="/spinspg/attendant-login" class="nav-btn" style="background:#10b981;color:white;">Attendant</a>
      <a href="/spinspg/customer-login" class="nav-btn" style="background:#f59e0b;color:white;">Customer</a>
    </div>
  </div>
  <!-- Mobile Nav -->
  <div class="collapse d-md-none" id="ssNav">
    <div class="container py-2 d-flex flex-column gap-2">
      <a href="/spinspg" class="nav-link">Home</a>
      <a href="#features" class="nav-link">Features</a>
      <a href="#gallery" class="nav-link">Gallery</a>
      <a href="#roles" class="nav-link">Portals</a>
      <a href="/spinspg/login" class="nav-btn text-center" style="background:#0284c7;color:white;">Owner Login</a>
      <a href="/spinspg/attendant-login" class="nav-btn text-center" style="background:#10b981;color:white;">Attendant Login</a>
      <a href="/spinspg/customer-login" class="nav-btn text-center" style="background:#f59e0b;color:white;">Customer Login</a>
    </div>
  </div>
</nav>

<!-- Hero Section -->
<section class="ss-hero">
  <div class="container position-relative">
    <div class="row align-items-center">
      <div class="col-lg-6 mb-4 mb-lg-0 text-center text-lg-start">
