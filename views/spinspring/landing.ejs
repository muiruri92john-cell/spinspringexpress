<script>
// ============ NAVIGATION ============
(function() {
  'use strict';
  const navToggle = document.getElementById('navToggle');
  const navMenu = document.getElementById('navMenu');
  if (navToggle && navMenu) {
    navToggle.addEventListener('click', () => navMenu.classList.toggle('show'));
  }
  document.querySelectorAll('a[href^="#"]').forEach(function(link) {
    link.addEventListener('click', function(e) {
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        navMenu?.classList.remove('show');
      }
    });
  });
})();

// ============ LOCATIONS (NEW) ============
(function() {
  'use strict';

  const GRID = document.getElementById('locationsGrid');
  const FIND_BTN = document.getElementById('findNearestBtn');
  const STAT_COUNT = document.getElementById('statLocationCount');

  if (!GRID) return;

  // Fallback owner id (change if you support multiple owners)
  const OWNER_ID = 5;

  let allLocations = [];

  function formatTime(t) {
    if (!t) return '08:00';
    return String(t).slice(0, 5);
  }

  function renderLocations(locations, withDistance) {
    if (!locations || locations.length === 0) {
      GRID.innerHTML = `
        <div class="text-center py-5" style="grid-column:1/-1;">
          <i class="fas fa-map-marked-alt fa-3x mb-3" style="color:#bae6fd;"></i>
          <h5 style="color:#0c4a6e;">No locations available</h5>
          <p class="text-muted">Check back soon!</p>
        </div>
      `;
      return;
    }

    GRID.innerHTML = locations.map(loc => {
      const badge = loc.is_primary
        ? '<span class="loc-badge-primary">PRIMARY</span>'
        : (loc.is_open_now
            ? '<span class="loc-badge-open">OPEN</span>'
            : '<span class="loc-badge-closed">CLOSED</span>');

      const distanceBlock = (withDistance && loc.distance_km !== undefined)
        ? `<span class="distance-badge show"><i class="fas fa-route me-1"></i>${loc.distance_km} km away</span>`
        : '';

      const phone = loc.phone || loc.whatsapp || '';
      const waLink = phone ? `https://wa.me/${phone.replace(/\D/g, '')}` : '';

      return `
        <div class="location-card">
          <div class="loc-header">
            ${badge}
            <h5><i class="fas fa-store me-2"></i>${loc.location_name}</h5>
            <div class="loc-code">${loc.location_code || ''}</div>
            ${distanceBlock}
          </div>
          <div class="loc-body">
            <div class="loc-row">
              <i class="fas fa-map-pin"></i>
              <div>
                ${loc.address_line1 || ''}
                ${loc.address_line2 ? '<br>' + loc.address_line2 : ''}
                <br>${loc.city || 'Nairobi'}${loc.county ? ', ' + loc.county : ''}
              </div>
            </div>
            ${phone ? `<div class="loc-row"><i class="fas fa-phone"></i><div>${phone}</div></div>` : ''}
            <div class="loc-row">
              <i class="fas fa-clock"></i>
              <div>${formatTime(loc.opening_time)} - ${formatTime(loc.closing_time)}</div>
            </div>
            <div class="loc-row">
              <i class="fas fa-truck"></i>
              <div>Pickup: ${Number(loc.pickup_fee_kes || 0) === 0 ? '<strong style="color:#10b981;">FREE</strong>' : 'KES ' + Number(loc.pickup_fee_kes).toLocaleString()}</div>
            </div>
          </div>
          <div class="loc-actions">
            <a class="btn-map" 
               href="https://www.google.com/maps/dir/?api=1&destination=${loc.latitude},${loc.longitude}"
               target="_blank" rel="noopener">
              <i class="fas fa-directions me-1"></i>Directions
            </a>
            ${waLink ? `<a class="btn-wa" href="${waLink}" target="_blank" rel="noopener">
              <i class="fab fa-whatsapp me-1"></i>WhatsApp
            </a>` : ''}
          </div>
        </div>
      `;
    }).join('');
  }

  function loadLocations() {
    fetch(`/api/public/locations?owner_id=${OWNER_ID}`)
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          allLocations = data.locations || [];
          renderLocations(allLocations, false);
          if (STAT_COUNT) STAT_COUNT.textContent = allLocations.length;
          populateQuoteLocationDropdown(allLocations);
        } else {
          throw new Error(data.error || 'Failed');
        }
      })
      .catch(err => {
        console.error('Load locations failed:', err);
        GRID.innerHTML = `
          <div class="text-center py-5" style="grid-column:1/-1;">
            <i class="fas fa-exclamation-triangle fa-3x mb-3" style="color:#f59e0b;"></i>
            <h5 style="color:#0c4a6e;">Could not load locations</h5>
            <p class="text-muted">Please refresh the page or try again</p>
          </div>
        `;
      });
  }

  function populateQuoteLocationDropdown(locations) {
    const sel = document.getElementById('qLocation');
    if (!sel) return;
    sel.innerHTML = '<option value="">— Select a branch —</option>' +
      locations.map(l => `<option value="${l.id}">${l.location_name} (${l.city})</option>`).join('');
  }

  function findNearest() {
    if (!navigator.geolocation) {
      alert('Geolocation not supported by your browser');
      return;
    }

    FIND_BTN.disabled = true;
    FIND_BTN.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Locating...';

    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        fetch(`/api/public/locations/nearest?lat=${latitude}&lng=${longitude}&owner_id=${OWNER_ID}&limit=10`)
          .then(r => r.json())
          .then(data => {
            if (data.success) {
              renderLocations(data.locations || [], true);
              FIND_BTN.disabled = false;
              FIND_BTN.innerHTML = '<i class="fas fa-check me-2"></i>Sorted by Distance';
              setTimeout(() => {
                FIND_BTN.innerHTML = '<i class="fas fa-crosshairs me-2"></i>Find Nearest to Me';
                FIND_BTN.disabled = false;
              }, 3000);
            } else {
              throw new Error(data.error || 'Failed');
            }
          })
          .catch(err => {
            console.error(err);
            alert('Could not sort by distance: ' + err.message);
            FIND_BTN.disabled = false;
            FIND_BTN.innerHTML = '<i class="fas fa-crosshairs me-2"></i>Find Nearest to Me';
          });
      },
      (err) => {
        alert('Location access denied or unavailable: ' + err.message);
        FIND_BTN.disabled = false;
        FIND_BTN.innerHTML = '<i class="fas fa-crosshairs me-2"></i>Find Nearest to Me';
      },
      { enableHighAccuracy: true, timeout: 10000 }
    );
  }

  FIND_BTN?.addEventListener('click', findNearest);

  // Initialize
  loadLocations();

  // Expose for auto-detect in quote
  window.__spinLocations = {
    all: () => allLocations,
    reload: loadLocations
  };
})();

// ============ QUOTE CALCULATOR ============
(function() {
  'use strict';

  const quoteState = {
    services: [],
    addons: [],
    pricing: {},
    addonPricing: {},
    current: null
  };

  const DOM = {
    quoteItems: document.getElementById('quoteItems'),
    addQuoteItem: document.getElementById('addQuoteItem'),
    quoteBreakdown: document.getElementById('quoteBreakdown'),
    qSubtotal: document.getElementById('qSubtotal'),
    qAddons: document.getElementById('qAddons'),
    qExpressCost: document.getElementById('qExpressCost'),
    qPickupCost: document.getElementById('qPickupCost'),
    qTotal: document.getElementById('qTotal'),
    qWhatsApp: document.getElementById('qWhatsApp'),
    qSave: document.getElementById('qSave'),
    qSaved: document.getElementById('qSaved'),
    qRef: document.getElementById('qRef'),
    qExpress: document.getElementById('qExpress'),
    qPickup: document.getElementById('qPickup'),
    qLocation: document.getElementById('qLocation'),
    detectLocationBtn: document.getElementById('detectLocationBtn'),
    detectedInfo: document.getElementById('detectedInfo'),
    detectedText: document.getElementById('detectedText'),
    qName: document.getElementById('qName'),
    qPhone: document.getElementById('qPhone'),
    qEmail: document.getElementById('qEmail')
  };

  // ─── API ───
  async function loadPricing() {
    try {
      const res = await fetch('/api/pricing');
      const data = await res.json();
      if (data.success) {
        quoteState.services = data.services;
        quoteState.addons = data.addons;
        data.services.forEach(s => { quoteState.pricing[s.service_key] = s; });
        data.addons.forEach(a => { quoteState.addonPricing[a.addon_key] = a; });
        populateServiceSelects();
        recalculate();
      }
    } catch (err) {
      console.error('Pricing load failed:', err);
    }
  }

  async function calculateQuote(items, addons, express, pickup) {
    const res = await fetch('/api/quote/calculate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items, addons, express, pickup })
    });
    return res.json();
  }

  async function saveQuote(payload) {
    const res = await fetch('/api/quote/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    return res.json();
  }

  // ─── Helpers ───
  function populateServiceSelects() {
    document.querySelectorAll('.q-service').forEach(sel => {
      sel.innerHTML = '<option value="">-- Select Service --</option>';
      quoteState.services.forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.service_key;
        opt.textContent = `${s.service_name} (KES ${s.price}/${s.unit})`;
        opt.dataset.unit = s.unit;
        opt.dataset.price = s.price;
        sel.appendChild(opt);
      });
    });
  }

  function createItemRow() {
    const row = document.createElement('div');
    row.className = 'quote-item-row';
    row.style.cssText = 'display:flex;gap:8px;margin-bottom:10px;align-items:end;';
    row.innerHTML = `
      <div style="flex:2;">
        <label class="form-label small mb-1">Service</label>
        <select class="form-select form-select-sm q-service">
          <option value="">-- Select --</option>
        </select>
      </div>
      <div style="flex:1;">
        <label class="form-label small mb-1">Qty</label>
        <input type="number" class="form-control form-control-sm q-qty" value="1" min="0.1" step="0.1">
      </div>
      <div style="flex:1;">
        <label class="form-label small mb-1">Unit</label>
        <input type="text" class="form-control form-control-sm q-unit" readonly>
      </div>
      <div>
        <button type="button" class="btn btn-sm btn-outline-danger q-remove" title="Remove">
          <i class="fas fa-trash"></i>
        </button>
      </div>
    `;
    return row;
  }

  function attachRowHandlers(row) {
    const sel = row.querySelector('.q-service');
    const qty = row.querySelector('.q-qty');
    const unit = row.querySelector('.q-unit');
    const rm = row.querySelector('.q-remove');

    sel.addEventListener('change', () => {
      const opt = sel.options[sel.selectedIndex];
      unit.value = opt.dataset.unit || '';
      recalculate();
    });
    qty.addEventListener('input', recalculate);
    rm.addEventListener('click', () => {
      row.remove();
      recalculate();
    });
  }

  function addItemRow() {
    const row = createItemRow();
    DOM.quoteItems.appendChild(row);
    populateServiceSelects();
    attachRowHandlers(row);
  }

  function getItems() {
    const items = [];
    document.querySelectorAll('.quote-item-row').forEach(row => {
      const sel = row.querySelector('.q-service');
      const qty = row.querySelector('.q-qty');
      if (sel.value && parseFloat(qty.value) > 0) {
        items.push({ service_key: sel.value, quantity: parseFloat(qty.value) });
      }
    });
    return items;
  }

  function getAddons() {
    return Array.from(document.querySelectorAll('.q-addon:checked')).map(c => c.value);
  }

  function formatCurrency(n) {
    return 'KES ' + (Math.round((parseFloat(n) || 0) * 100) / 100).toLocaleString();
  }

  function renderQuote(data) {
    DOM.qSubtotal.textContent = formatCurrency(data.subtotal);
    DOM.qAddons.textContent = formatCurrency(data.addons_total);
    DOM.qExpressCost.textContent = formatCurrency(data.express_cost);
    DOM.qPickupCost.textContent = formatCurrency(data.pickup_cost);
    DOM.qTotal.textContent = formatCurrency(data.total);

    if (!data.breakdown || data.breakdown.length === 0) {
      DOM.quoteBreakdown.innerHTML = '<p class="text-muted text-center py-3">Add items to see pricing</p>';
    } else {
      DOM.quoteBreakdown.innerHTML = data.breakdown.map(b => `
        <div class="price-row">
          <span>
            ${b.item}
            ${b.quantity ? ` <small class="text-muted">(${b.quantity}${b.unit || ''})</small>` : ''}
            ${b.note ? `<br><small class="text-muted">${b.note}</small>` : ''}
          </span>
          <span class="price">${formatCurrency(b.line_total || 0)}</span>
        </div>
      `).join('');
    }

    const enabled = data.total > 0;
    DOM.qWhatsApp.disabled = !enabled;
    DOM.qSave.disabled = !enabled;
    quoteState.current = data;
  }

  async function recalculate() {
    const items = getItems();
    const addons = getAddons();
    const express = DOM.qExpress?.checked || false;
    const pickup = DOM.qPickup?.value || 'none';

    if (items.length === 0) {
      renderQuote({ subtotal: 0, addons_total: 0, express_cost: 0, pickup_cost: 0, total: 0, breakdown: [] });
      return;
    }

    try {
      const data = await calculateQuote(items, addons, express, pickup);
      if (data.success) renderQuote(data);
      else console.error('Quote error:', data.error);
    } catch (err) {
      console.error('Quote fetch error:', err);
    }
  }

  function getSelectedLocationName() {
    const sel = DOM.qLocation;
    if (!sel || !sel.value) return '';
    const opt = sel.options[sel.selectedIndex];
    return opt ? opt.textContent : '';
  }

  function sendViaWhatsApp() {
    const d = quoteState.current;
    if (!d) return;

    const loc = getSelectedLocationName();
    const lines = [
      'Hi SpinSpring Express,',
      'I would like a quote:',
      ''
    ];
    if (loc) lines.push(`📍 Branch: ${loc}`, '');

    d.breakdown.forEach(b => {
      lines.push(`• ${b.item}${b.quantity ? ` (${b.quantity}${b.unit || ''})` : ''} — KES ${b.line_total}`);
    });

    lines.push('');
    lines.push(`TOTAL: KES ${d.total}`);
    lines.push('');
    lines.push('Name: ' + (DOM.qName?.value || ''));
    lines.push('Phone: ' + (DOM.qPhone?.value || ''));

    const text = encodeURIComponent(lines.join('\n'));
    window.open('https://wa.me/254793972143?text=' + text, '_blank');
  }

  async function handleSaveQuote() {
    const d = quoteState.current;
    if (!d) return;

    try {
      const r = await saveQuote({
        items: getItems(),
        addons: getAddons(),
        express: DOM.qExpress?.checked || false,
        pickup: DOM.qPickup?.value || 'none',
        total: d.total,
        location_id: DOM.qLocation?.value || null,
        customer_name: DOM.qName?.value || null,
        customer_phone: DOM.qPhone?.value || null,
        customer_email: DOM.qEmail?.value || null
      });

      if (r.success) {
        DOM.qRef.textContent = r.quote_ref;
        DOM.qSaved.style.display = 'block';
      }
    } catch (err) {
      console.error('Save failed:', err);
    }
  }

  // ─── Auto-detect location for quote ───
  function detectLocation() {
    if (!navigator.geolocation) {
      alert('Geolocation not supported');
      return;
    }
    if (!DOM.detectLocationBtn) return;

    DOM.detectLocationBtn.disabled = true;
    DOM.detectLocationBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        fetch(`/api/public/locations/nearest?lat=${latitude}&lng=${longitude}&owner_id=5&limit=1`)
          .then(r => r.json())
          .then(data => {
            if (data.success && data.locations && data.locations.length > 0) {
              const nearest = data.locations[0];
              if (DOM.qLocation) DOM.qLocation.value = nearest.id;
              if (DOM.detectedText) {
                DOM.detectedText.textContent = `Nearest: ${nearest.location_name} — ${nearest.distance_km} km away`;
              }
              if (DOM.detectedInfo) DOM.detectedInfo.style.display = 'block';
            } else {
              alert('No locations found nearby');
            }
            DOM.detectLocationBtn.disabled = false;
            DOM.detectLocationBtn.innerHTML = '<i class="fas fa-crosshairs me-1"></i> Auto-detect';
          })
          .catch(err => {
            console.error(err);
            alert('Could not detect location');
            DOM.detectLocationBtn.disabled = false;
            DOM.detectLocationBtn.innerHTML = '<i class="fas fa-crosshairs me-1"></i> Auto-detect';
          });
      },
      (err) => {
        alert('Location access denied: ' + err.message);
        DOM.detectLocationBtn.disabled = false;
        DOM.detectLocationBtn.innerHTML = '<i class="fas fa-crosshairs me-1"></i> Auto-detect';
      },
      { enableHighAccuracy: true, timeout: 10000 }
    );
  }

  // ─── Init ───
  function init() {
    addItemRow();

    DOM.addQuoteItem?.addEventListener('click', addItemRow);
    DOM.qExpress?.addEventListener('change', recalculate);
    DOM.qPickup?.addEventListener('change', recalculate);
    document.querySelectorAll('.q-addon').forEach(cb => cb.addEventListener('change', recalculate));
    DOM.qWhatsApp?.addEventListener('click', sendViaWhatsApp);
    DOM.qSave?.addEventListener('click', handleSaveQuote);
    DOM.detectLocationBtn?.addEventListener('click', detectLocation);

    loadPricing();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

</body>
</html>