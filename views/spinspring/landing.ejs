<%- include('../layouts/main') %>
<style>
.ss-auth { background: linear-gradient(135deg, #0284c7, #0ea5e9); }
</style>
</head>
<body>
<div class="ss-auth">
  <div class="ss-auth-card">
    <div class="text-center mb-4">
      <i class="fas fa-soap fa-4x" style="color:#0284c7;"></i>
      <h3 class="mt-2 fw-bold">SpinSpring Express</h3>
      <p class="text-muted">Owner Login</p>
    </div>
    <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg %></div>
    <% } %>
    <form action="/login" method="POST">
      <div class="mb-3">
        <label class="form-label fw-bold">Email</label>
        <input type="email" name="email" class="form-control" required>
      </div>
      <div class="mb-3">
        <label class="form-label fw-bold">Password</label>
        <input type="password" name="password" class="form-control" required>
      </div>
      <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-pill" style="background:#0284c7;border:none;">
        <i class="fas fa-sign-in-alt me-2"></i> Login
      </button>
    </form>
    <div class="text-center mt-3">
      <a href="/register">Register</a> |
      <a href="/attendant-login">Attendant Login</a> |
      <a href="/customer-login">Customer Login</a>
    </div>
  </div>
</div>
</body>
</html>