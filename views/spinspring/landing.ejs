<%- include('../layouts/main') %>
<style>
:root {
  --ss-primary: #0284c7;
  --ss-secondary: #38bdf8;
  --ss-accent: #0ea5e9;
  --ss-light: #f0f9ff;
  --ss-white: #ffffff;
  --ss-dark: #0c4a6e;
  --ss-bg: #f8fafc;
}
body { background: var(--ss-bg); }

/* Navigation */
.ss-nav {
  background: rgba(255,255,255,0.98);
  backdrop-filter: blur(10px);
  box-shadow: 0 2px 15px rgba(2,132,199,0.1);
  padding: 12px 0;
  position: sticky;
  top: 0;
  z-index: 1000;
}
.ss-nav .brand { font-size: 1.5rem; font-weight: 800; color: var(--ss-primary); text-decoration: none; }
.ss-nav .nav-link { color: var(--ss-dark); font-weight: 600; padding: 8px 16px; border-radius: 50px; transition: all 0.3s; text-decoration: none; }
.ss-nav .nav-link:hover { background: var(--ss-light); color: var(--ss-primary); }
.ss-nav .nav-btn { padding: 8px 20px; border-radius: 50px; font-weight: 700; text-decoration: none; transition: all 0.3s; font-size: 0.9rem; }

/* Hero */
.ss-hero {
  background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 50%, #38bdf8 100%);
  padding: 60px 0 100px;
  position: relative;
  overflow: hidden;
}
.ss-hero::before { content: ''; position: absolute; top: -50%; right: -20%; width: 500px; height: 500px; background: rgba(255,255,255,0.05); border-radius: 50%; }
.ss-hero h1 { color: white; font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; margin-bottom: 15px; }
.ss-hero .tagline { color: rgba(255,255,255,0.9); font-size: clamp(1rem, 2vw, 1.3rem); margin-bottom: 25px; }

/* Pricing */
.pricing-card {
  background: white;
  border-radius: 20px;
  padding: 25px;
  box-shadow: 0 5px 25px rgba(2,132,199,0.1);
  border: 1px solid #e0f2fe;
  height: 100%;
}
.pricing-card h4 { color: var(--ss-primary); font-weight: 800; border-bottom: 2px solid #e0f2fe; padding-bottom: 10px; }
.price-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f1f5f9; }
.price-row:last-child { border-bottom: none; }
.price-row .price { font-weight: 700; color: var(--ss-primary); }

/* Special Items */
.special-item {
  background: white;
  border-radius: 15px;
  padding: 20px;
  text-align: center;
  box-shadow: 0 3px 15px rgba(0,0,0,0.05);
  transition: all 0.3s;
}
.special-item:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
.special-item i { font-size: 2.5rem; color: var(--ss-primary); margin-bottom: 10px; }

/* Process Steps */
.process-step {
  background: white;
  border-radius: 20px;
  padding: 30px;
  text-align: center;
  box-shadow: 0 5px 20px rgba(0,0,0,0.05);
  position: relative;
  height: 100%;
}
.step-number {
  width: 50px; height: 50px; background: var(--ss-primary); color: white;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 1.3rem; margin: 0 auto 15px;
}

/* Features */
.feature-card {
  background: white; border-radius: 20px; padding: 25px;
  box-shadow: 0 5px 20px rgba(0,0,0,0.05); height: 100%;
}
.feature-card i { font-size: 2.5rem; color: var(--ss-primary); margin-bottom: 15px; }

/* Testimonials */
.testimonial-card {
  background: white; border-radius: 20px; padding: 25px;
  box-shadow: 0 5px 20px rgba(0,0,0,0.05);
}
.testimonial-card .stars { color: #f59e0b; margin-bottom: 10px; }

/* Stats */
.stat-number { font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 800; color: var(--ss-primary); }
.stat-label { color: #64748b; font-size: 0.85rem; }

/* CTA */
.cta-section { background: linear-gradient(135deg, #0284c7, #0ea5e9); padding: 60px 0; text-align: center; color: white; }

/* Responsive */
@media (max-width: 768px) { .ss-hero { padding: 40px 0 70px; } }
</style>
</head>
