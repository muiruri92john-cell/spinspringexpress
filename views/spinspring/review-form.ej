<%- include('../layouts/main') %>

<style>
.review-wrapper {
  min-height: 90vh;
  background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
  padding: 40px 15px;
}
.review-card {
  background: white;
  border-radius: 24px;
  padding: 40px;
  max-width: 620px;
  margin: 0 auto;
  box-shadow: 0 25px 60px rgba(2,132,199,0.2);
}
.review-card h2 {
  color: #0c4a6e;
  font-weight: 800;
  text-align: center;
  margin-bottom: 8px;
}
.review-card .sub {
  text-align: center;
  color: #64748b;
  margin-bottom: 30px;
}

/* Star rating */
.star-picker {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin: 20px 0 30px;
  font-size: 3rem;
  cursor: pointer;
  user-select: none;
}
.star-picker i {
  color: #cbd5e1;
  transition: all 0.2s;
}
.star-picker i.active,
.star-picker i.hover {
  color: #f59e0b;
  transform: scale(1.1);
}
.rating-label {
  text-align: center;
  font-weight: 700;
  color: #0284c7;
  margin-top: -20px;
  margin-bottom: 20px;
  font-size: 1.05rem;
  min-height: 1.5rem;
}
</style>

<div class="review-wrapper">
  <div class="review-card">
    <div class="text-center mb-3">
      <i class="fas fa-soap fa-3x" style="color:#0284c7;"></i>
    </div>

    <% if (request) { %>
      <h2>How was your experience?</h2>
      <p class="sub">Hi <%= request.customer_name || 'there' %>, we'd love your feedback</p>
    <% } else { %>
      <h2>Leave a Review</h2>
      <p class="sub">Share your experience with SpinSpring Express</p>
    <% } %>

    <% if (order) { %>
      <div class="alert alert-info small mb-4">
        <i class="fas fa-receipt me-1"></i>
        Order <strong><%= order.order_number %></strong>
        <% if (order.device_name) { %> · <%= order.device_name %><% } %>
      </div>
    <% } %>

    <form id="reviewForm">
      <input type="hidden" name="rating" id="ratingInput" value="0">

      <label class="form-label text-center d-block mb-2" style="font-weight:700;color:#0c4a6e;">
        Tap to rate
      </label>

      <div class="star-picker" id="starPicker">
        <i class="far fa-star" data-value="1"></i>
        <i class="far fa-star" data-value="2"></i>
        <i class="far fa-star" data-value="3"></i>
        <i class="far fa-star" data-value="4"></i>
        <i class="far fa-star" data-value="5"></i>
      </div>
      <div class="rating-label" id="ratingLabel"></div>

      <div class="mb-3">
        <label class="form-label fw-bold">Your Name</label>
        <input type="text" name="customer_name" class="form-control"
               value="<%= request ? (request.customer_name || '') : '' %>"
               placeholder="Your name" required maxlength="100">
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Title <small class="text-muted">(optional)</small></label>
        <input type="text" name="title" class="form-control"
               placeholder="e.g., Fast and clean!" maxlength="200">
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Your Review <small class="text-muted">(optional)</small></label>
        <textarea name="comment" class="form-control" rows="5" maxlength="2000"
                  placeholder="Tell us what you liked or how we can improve..."></textarea>
      </div>

      <button type="submit" class="ss-btn w-100" id="submitBtn" style="padding:14px;font-size:1rem;">
        <i class="fas fa-paper-plane me-2"></i> Submit Review
      </button>
    </form>

    <div class="text-center mt-4">
      <a href="/" class="text-muted small">
        <i class="fas fa-arrow-left me-1"></i>Back to home
      </a>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';

  const picker = document.getElementById('starPicker');
  const ratingInput = document.getElementById('ratingInput');
  const ratingLabel = document.getElementById('ratingLabel');
  const stars = picker.querySelectorAll('i');

  const labels = {
    1: '😞 Very poor',
    2: '😐 Not great',
    3: '🙂 Okay',
    4: '😀 Good',
    5: '🤩 Excellent!'
  };

  function setRating(val) {
    ratingInput.value = val;
    stars.forEach((s, idx) => {
      const on = idx < val;
      s.className = (on ? 'fas' : 'far') + ' fa-star' + (on ? ' active' : '');
    });
    ratingLabel.textContent = labels[val] || '';
  }

  stars.forEach((star, i) => {
    star.addEventListener('mouseenter', () => {
      stars.forEach((s, idx) => {
        if (idx <= i) s.classList.add('hover');
      });
    });
    star.addEventListener('mouseleave', () => {
      stars.forEach(s => s.classList.remove('hover'));
    });
    star.addEventListener('click', () => {
      setRating(i + 1);
    });
  });

  // Form submit
  const form = document.getElementById('reviewForm');
  const btn = document.getElementById('submitBtn');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const rating = parseInt(ratingInput.value, 10);
    if (!rating || rating < 1) {
      alert('Please select a star rating');
      return;
    }

    const code = '<%= code || "" %>';
    const url = code ? `/review/${code}` : `/reviews/submit`;

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Submitting...';

    const data = Object.fromEntries(new FormData(form));

    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(data)
      });
      const json = await res.json();

      if (json.success) {
        window.location.href = '/review/thanks?code=' + (json.review_code || code);
      } else {
        alert(json.error || 'Submission failed');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i> Submit Review';
      }
    } catch (err) {
      alert('Network error: ' + err.message);
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i> Submit Review';
    }
  });
})();
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>