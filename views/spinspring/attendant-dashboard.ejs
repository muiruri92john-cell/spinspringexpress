<%- include('../layouts/main') %>

<style>
.dash-header {
  background: linear-gradient(135deg, #10b981, #059669);
  color: white;
  padding: 25px 0;
  margin-bottom: 30px;
}
.dash-header h1 { color: white; font-weight: 800; margin: 0; font-size: 1.5rem; }
.dash-header .sub { color: rgba(255,255,255,0.9); }

.stat-box { background: white; border-radius: 12px; padding: 16px; text-align: center; border: 1px solid #e0f2fe; }
.stat-box .v { font-size: 1.75rem; font-weight: 800; color: #10b981; }
.stat-box .l { font-size: 0.75rem; color: #64748b; text-transform: uppercase; }

.dash-section {
  background: white;
  border-radius: 16px;
  padding: 24px;
  border: 1px solid #e0f2fe;
  box-shadow: 0 4px 15px rgba(2,132,199,0.08);
  margin-bottom: 24px;
}
.dash-section h5 {
  color: #0c4a6e;
  font-weight: 800;
  padding-bottom: 12px;
  border-bottom: 2px solid #e0f2fe;
  margin-bottom: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-pill { padding: 3px 12px; border-radius: 12px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; }
.status-pending { background: #fef3c7; color: #92400e; }
.status-queued { background: #dbeafe; color: #1e40af; }
.status-in_progress { background: #e9d5ff; color: #6b21a8; }
.status-completed { background: #d1fae5; color: #065f46; }
.status-cancelled { background: #fee2e2; color: #991b1b; }
</style>

<div class="dash-header">
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h1><i class="fas fa-user-tie me-2"></i>Attendant Dashboard</h1>
      <div class="sub"><%= user.ownerCompany %> · Welcome, <%= user.name %></div>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-light btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#addCustModal">
        <i class="fas fa-user-plus me-1"></i>Add Customer
      </button>
      <button class="btn btn-light btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#newOrderModal">
        <i class="fas fa-plus me-1"></i>New Order
      </button>
      <a href="/attendant-logout" class="btn btn-outline-light btn-sm rounded-pill">
        <i class="fas fa-sign-out-alt me-1"></i>Logout
      </a>
    </div>
  </div>
</div>

<div class="container pb-5">
  <%- include('../partials/flash') %>

  <!-- STATS -->
  <div class="row g-3 mb-4">
    <div class="col-md-3 col-6"><div class="stat-box"><div class="v"><%= stats.total_orders || 0 %></div><div class="l">Today's Orders</div></div></div>
    <div class="col-md-3 col-6"><div class="stat-box"><div class="v" style="color:#f59e0b;"><%= stats.active_orders || 0 %></div><div class="l">Active</div></div></div>
    <div class="col-md-3 col-6"><div class="stat-box"><div class="v" style="color:#3b82f6;"><%= stats.completed_orders || 0 %></div><div class="l">Completed</div></div></div>
    <div class="col-md-3 col-6"><div class="stat-box"><div class="v" style="color:#10b981;">KES <%= Number(stats.today_revenue || 0).toLocaleString() %></div><div class="l">Today Revenue</div></div></div>
  </div>

  <div class="row g-4">
    <!-- ACTIVE ORDERS -->
    <div class="col-lg-7">
      <div class="dash-section">
        <h5><i class="fas fa-clock me-2"></i>Active Orders (<%= activeOrders.length %>)</h5>
        <% if (activeOrders.length === 0) { %>
          <p class="text-muted text-center py-3">No active orders</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm align-middle">
              <thead>
                <tr>
                  <th>Order #</th>
                  <th>Customer</th>
                  <th>Status</th>
                  <th class="text-end">Price</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% activeOrders.forEach(o => { %>
                  <tr>
                    <td><small><%= o.order_number %></strong></small></td>
                    <td><%= o.customer_name || '—' %></td>
                    <td>
                      <form method="POST" action="/attendant/orders/<%= o.id %>/status" class="d-inline">
                        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()" style="width:130px;">
                          <option value="pending" <%= o.order_status === 'pending' ? 'selected' : '' %>>Pending</option>
                          <option value="queued" <%= o.order_status === 'queued' ? 'selected' : '' %>>Queued</option>
                          <option value="in_progress" <%= o.order_status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                          <option value="completed" <%= o.order_status === 'completed' ? 'selected' : '' %>>Completed</option>
                          <option value="cancelled" <%= o.order_status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                        </select>
                      </form>
                    </td>
                    <td class="text-end">KES <%= Number(o.price).toLocaleString() %></td>
                    <td class="text-end">
                      <% if (o.payment_status !== 'paid') { %>
                        <form method="POST" action="/attendant/orders/<%= o.id %>/payment" class="d-inline">
                          <input type="hidden" name="status" value="paid">
                          <button type="submit" class="btn btn-sm btn-outline-success rounded-pill" title="Mark paid">
                            <i class="fas fa-money-bill"></i>
                          </button>
                        </form>
                      <% } else { %>
                        <span class="badge bg-success"><i class="fas fa-check"></i> Paid</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <!-- DEVICES -->
    <div class="col-lg-5">
      <div class="dash-section">
        <h5><i class="fas fa-server me-2"></i>Devices (<%= devices.length %>)</h5>
        <% devices.forEach(d => { %>
          <div class="d-flex align-items-center py-2 border-bottom" style="gap:12px;">
            <div style="flex:1;">
              <div style="font-weight:700;color:#0c4a6e;"><%= d.device_name %></div>
              <div style="font-size:0.7rem;color:#64748b;font-family:monospace;"><%= d.device_id %></div>
            </div>
            <span class="status-pill status-<%= d.status || 'pending' %>"><%= d.status || 'offline' %></span>
          </div>
        <% }); %>
        <% if (devices.length === 0) { %>
          <p class="text-muted text-center py-3">No devices</p>
        <% } %>
      </div>

      <div class="dash-section">
        <h5><i class="fas fa-users me-2"></i>Customers (<%= customers.length %>)</h5>
        <% customers.slice(0, 5).forEach(c => { %>
          <div class="d-flex align-items-center py-2 border-bottom">
            <div style="flex:1;">
              <div style="font-weight:700;color:#0c4a6e;font-size:0.9rem;"><%= c.full_name %></div>
              <div style="font-size:0.75rem;color:#64748b;"><%= c.phone %></div>
            </div>
            <small class="text-muted" style="font-family:monospace;"><%= c.customer_unique_id %></small>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<!-- ADD CUSTOMER MODAL -->
<div class="modal fade" id="addCustModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:20px;">
      <form method="POST" action="/attendant/customers">
        <div class="modal-header" style="background:linear-gradient(135deg,#10b981,#059669);color:white;border-radius:20px 20px 0 0;">
          <h5 class="modal-title"><i class="fas fa-user-plus me-2"></i>Add Customer</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-bold">Full Name *</label>
            <input type="text" name="full_name" class="form-control" required maxlength="100">
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold">Phone *</label>
              <input type="tel" name="phone" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Email *</label>
              <input type="email" name="email" class="form-control" required>
            </div>
          </div>
          <div class="mt-3">
            <label class="form-label fw-bold">Address</label>
            <input type="text" name="address" class="form-control">
          </div>
          <div class="mt-3">
            <label class="form-label fw-bold">Password (optional)</label>
            <input type="text" name="password" class="form-control" minlength="6"
                   placeholder="Leave blank to auto-generate">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="ss-btn ss-btn-success">Create Customer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- NEW ORDER MODAL -->
<div class="modal fade" id="newOrderModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:20px;">
      <form method="POST" action="/attendant/orders">
        <div class="modal-header" style="background:linear-gradient(135deg,#0284c7,#0ea5e9);color:white;border-radius:20px 20px 0 0;">
          <h5 class="modal-title"><i class="fas fa-plus me-2"></i>New Order</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-bold">Customer *</label>
            <select name="customer_id" class="form-select" required>
              <option value="">— Select customer —</option>
              <% customers.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.full_name %> · <%= c.phone %></option>
              <% }); %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Device (optional)</label>
            <select name="device_id" class="form-select">
              <option value="">— Auto-assign —</option>
              <% devices.forEach(d => { %>
                <option value="<%= d.device_id %>"><%= d.device_name %></option>
              <% }); %>
            </select>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold">Service</label>
              <select name="service_type" class="form-select">
                <option value="wash">Wash</option>
                <option value="dry_clean">Dry Clean</option>
                <option value="iron">Iron Only</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Cycle</label>
              <select name="cycle_type" class="form-select">
                <option value="normal">Normal</option>
                <option value="express">Express</option>
                <option value="delicate">Delicate</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Weight (kg)</label>
              <input type="number" name="weight_kg" class="form-control" step="0.1" min="0">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Price (KES) *</label>
              <input type="number" name="price" class="form-control" step="0.01" min="0" required>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="ss-btn">Create Order</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/pwa.js" defer></script>
</body>
</html>