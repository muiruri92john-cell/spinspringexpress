<%- include('../layouts/main') %>
<style>
.ss-nav { background: linear-gradient(135deg, #10b981, #059669); padding: 15px 0; }
.ss-nav a { color: white !important; text-decoration: none; }
.ss-card {
  background: white;
  border-radius: 20px;
  padding: 25px;
  box-shadow: 0 5px 25px rgba(16,185,129,0.1);
  border: 1px solid #d1fae5;
  margin-bottom: 20px;
}
.section-title {
  color: #0c4a6e;
  padding-bottom: 10px;
  border-bottom: 2px solid #d1fae5;
  margin-bottom: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.status-badge { padding: 5px 15px; border-radius: 20px; font-size: 0.7rem; font-weight: 700; }
.status-queued { background: #fef3c7; color: #92400e; }
.status-in_progress { background: #dbeafe; color: #1e40af; }
.status-completed { background: #d1fae5; color: #065f46; }
.status-cancelled { background: #fee2e2; color: #991b1b; }
.machine-card {
  border: 1px solid #d1fae5;
  border-radius: 15px;
  padding: 20px;
  text-align: center;
  transition: all 0.3s;
}
.machine-card:hover { border-color: #10b981; box-shadow: 0 5px 20px rgba(16,185,129,0.2); }
.price-display {
  background: #f0f9ff;
  border: 1px solid #bae6fd;
  border-radius: 10px;
  padding: 15px;
  margin-top: 15px;
}
</style>
</head>
<body>
<nav class="ss-nav">
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
    <a href="/attendant" class="brand text-white text-decoration-none" style="font-size:1.5rem;font-weight:800;">
      <i class="fas fa-soap me-2"></i>SpinSpring
    </a>
    <div class="d-flex align-items-center gap-2">
      <span class="text-white">Attendant: <%= user.name %></span>
      <a href="/logout" class="btn btn-danger btn-sm rounded-pill">
        <i class="fas fa-sign-out-alt me-1"></i> Logout
      </a>
    </div>
  </div>
</nav>

<div class="container py-4">
  <h3 class="mb-4" style="color:#0c4a6e;">
    <i class="fas fa-user-tie me-2"></i>Attendant Panel
  </h3>

  <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
    <div class="alert alert-success"><%= success_msg %></div>
  <% } %>
  <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
    <div class="alert alert-danger"><%= error_msg %></div>
  <% } %>

  <!-- Machines -->
  <div class="ss-card">
    <div class="section-title">
      <span><i class="fas fa-washing-machine me-2"></i>Machines Under Your Care</span>
    </div>
    <div class="row g-3">
      <% if (typeof devices !== 'undefined' && devices.length > 0) { %>
        <% devices.forEach(function(d) { %>
          <div class="col-md-4 col-6">
            <div class="machine-card">
              <i class="fas fa-washing-machine fa-3x mb-2" style="color:#10b981;"></i>
              <h6><%= d.device_name %></h6>
              <span class="badge bg-<%= d.status === 'idle' ? 'success' : d.status === 'running' ? 'primary' : 'warning' %>">
                <%= d.status %>
              </span>
              <p class="mt-2 mb-0">
                <strong>Ksh <%= d.price_per_cycle || 300 %>/cycle</strong>
              </p>
              <a href="/device-detail/<%= d.device_id %>" class="btn btn-sm btn-outline-success rounded-pill mt-2">Control</a>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-muted">No machines assigned to you.</p>
      <% } %>
    </div>
  </div>

  <!-- Billing Type Selection -->
  <div class="ss-card">
    <div class="section-title">
      <span><i class="fas fa-receipt me-2"></i>Generate Receipt / Bill</span>
    </div>
    
    <!-- Billing Type Toggle -->
    <div class="mb-3">
      <label class="form-label fw-bold">Select Billing Type</label>
      <div class="btn-group w-100" role="group">
        <button type="button" class="btn btn-success" id="btnCycle" onclick="showCycleBilling()">
          <i class="fas fa-cog me-1"></i> Per Cycle
        </button>
        <button type="button" class="btn btn-outline-success" id="btnWeight" onclick="showWeightBilling()">
          <i class="fas fa-weight me-1"></i> Per Weight (kg)
        </button>
      </div>
    </div>

    <!-- Per Cycle Billing -->
    <div id="cycleBilling">
      <form action="/attendant/generate-receipt" method="POST">
        <input type="hidden" name="billing_type" value="per_cycle">
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label fw-bold">Machine *</label>
            <select name="device_id" class="form-select" required>
              <option value="">-- Select --</option>
              <% devices.forEach(function(d) { %>
                <option value="<%= d.device_id %>"><%= d.device_name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Customer *</label>
            <select name="customer_id" class="form-select" required>
              <option value="walk-in">Walk-in</option>
              <% if (typeof customers !== 'undefined') { %>
                <% customers.forEach(function(c) { %>
                  <option value="<%= c.customer_unique_id %>"><%= c.full_name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label fw-bold">Price/Cycle (Ksh)</label>
            <input type="number" name="cycle_price" class="form-control" value="300" required>
          </div>
          <div class="col-md-2">
            <label class="form-label fw-bold">Quantity</label>
            <input type="number" name="quantity" class="form-control" value="1" min="1" required>
          </div>
          <div class="col-md-2">
            <label class="form-label fw-bold">Payment</label>
            <select name="payment_method" class="form-select">
              <option value="cash">Cash</option>
              <option value="mpesa">M-PESA</option>
              <option value="card">Card</option>
            </select>
          </div>
        </div>
        <button type="submit" class="btn btn-success rounded-pill mt-3 px-4">
          <i class="fas fa-receipt me-2"></i> Generate Receipt
        </button>
      </form>
    </div>

    <!-- Per Weight Billing -->
    <div id="weightBilling" style="display:none;">
      <form action="/attendant/generate-receipt" method="POST">
        <input type="hidden" name="billing_type" value="per_weight">
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label fw-bold">Machine *</label>
            <select name="device_id" class="form-select" required>
              <option value="">-- Select --</option>
              <% devices.forEach(function(d) { %>
                <option value="<%= d.device_id %>"><%= d.device_name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Customer *</label>
            <select name="customer_id" class="form-select" required>
              <option value="walk-in">Walk-in</option>
              <% if (typeof customers !== 'undefined') { %>
                <% customers.forEach(function(c) { %>
                  <option value="<%= c.customer_unique_id %>"><%= c.full_name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label fw-bold">Weight (kg) *</label>
            <input type="number" name="weight_kg" class="form-control" step="0.01" min="0.1" required>
          </div>
          <div class="col-md-2">
            <label class="form-label fw-bold">Rate/Kg (Ksh)</label>
            <input type="number" name="rate_per_kg" class="form-control" value="50" required>
          </div>
          <div class="col-md-2">
            <label class="form-label fw-bold">Payment</label>
            <select name="payment_method" class="form-select">
              <option value="cash">Cash</option>
              <option value="mpesa">M-PESA</option>
              <option value="card">Card</option>
            </select>
          </div>
        </div>
        <button type="submit" class="btn btn-success rounded-pill mt-3 px-4">
          <i class="fas fa-receipt me-2"></i> Generate Receipt
        </button>
      </form>
    </div>
  </div>

  <!-- Active Orders -->
  <div class="ss-card">
    <div class="section-title">
      <span><i class="fas fa-list me-2"></i>Active Orders</span>
    </div>
    <% if (typeof activeOrders !== 'undefined' && activeOrders.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr><th>Order #</th><th>Customer</th><th>Service</th><th>Status</th><th>Price</th></tr>
          </thead>
          <tbody>
            <% activeOrders.forEach(function(o) { %>
              <tr>
                <td style="font-size:0.8rem;"><%= o.order_number %></td>
                <td><%= o.customer_name === 'walk-in' ? 'Walk-in' : o.customer_name %></td>
                <td><%= o.service_type.replace('_', ' ') %></td>
                <td><span class="status-badge status-<%= o.order_status %>"><%= o.order_status %></span></td>
                <td>Ksh <%= o.price %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-3">
        <p class="text-muted">No active orders</p>
      </div>
    <% } %>
  </div>
</div>

<script>
function showCycleBilling() {
  document.getElementById('cycleBilling').style.display = 'block';
  document.getElementById('weightBilling').style.display = 'none';
  document.getElementById('btnCycle').className = 'btn btn-success';
  document.getElementById('btnWeight').className = 'btn btn-outline-success';
}

function showWeightBilling() {
  document.getElementById('cycleBilling').style.display = 'none';
  document.getElementById('weightBilling').style.display = 'block';
  document.getElementById('btnCycle').className = 'btn btn-outline-success';
  document.getElementById('btnWeight').className = 'btn btn-success';
}

// Auto-refresh every 60 seconds
setInterval(() => { location.reload(); }, 60000);
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
// AJAX Live Refresh - updates without page reload
let refreshInterval;

function startLiveRefresh() {
  refreshInterval = setInterval(() => {
    fetch('/api/live-data')
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          updateDashboardUI(data);
        }
      })
      .catch(err => console.log('Refresh error:', err));
  }, 10000); // Every 10 seconds
}

function updateDashboardUI(data) {
  // Update stats
  if (data.stats) {
    const todayRev = document.getElementById('live-today-rev');
    if (todayRev) todayRev.textContent = 'Ksh ' + data.stats.today_rev;
    
    const totalRev = document.getElementById('live-total-rev');
    if (totalRev) totalRev.textContent = 'Ksh ' + data.stats.total_rev;
  }
  
  // Update device statuses
  if (data.devices) {
    data.devices.forEach(device => {
      const statusEl = document.getElementById('status-' + device.device_id);
      if (statusEl) {
        statusEl.textContent = device.status;
        statusEl.className = 'badge bg-' + (device.status === 'idle' ? 'success' : device.status === 'running' ? 'primary' : 'warning');
      }
      
      const progressEl = document.getElementById('progress-' + device.device_id);
      if (progressEl) {
        progressEl.style.width = device.cycle_progress + '%';
      }
    });
  }
  
  // Update refresh indicator
  const indicator = document.getElementById('refresh-indicator');
  if (indicator) {
    indicator.textContent = 'Last updated: ' + new Date().toLocaleTimeString();
  }
}

// Start on page load
document.addEventListener('DOMContentLoaded', startLiveRefresh);

// Stop when page hidden (save bandwidth)
document.addEventListener('visibilitychange', () => {
  if (document.hidden) clearInterval(refreshInterval);
  else startLiveRefresh();
});
</script>
</body>
</html>