<%- include('../layouts/main') %>

<style>
.thanks-wrapper {
  min-height: 80vh;
  background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
  padding: 60px 15px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.thanks-card {
  background: white;
  border-radius: 24px;
  padding: 50px 40px;
  max-width: 560px;
  width: 100%;
  text-align: center;
  box-shadow: 0 25px 60px rgba(2,132,199,0.2);
}
.thanks-icon {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: linear-gradient(135deg, #10b981, #059669);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 25px;
  color: white;
  font-size: 2.5rem;
  animation: popIn 0.5s ease;
}
@keyframes popIn {
  0% { transform: scale(0); }
  50% { transform: scale(1.15); }
  100% { transform: scale(1); }
}
.thanks-card h2 {
  color: #0c4a6e;
  font-weight: 800;
  margin-bottom: 12px;
}
.thanks-card p {
  color: #64748b;
  font-size: 1.05rem;
  margin-bottom: 25px;
}
</style>

<div class="thanks-wrapper">
  <div class="thanks-card">
    <div class="thanks-icon">
      <i class="fas fa-check"></i>
    </div>

    <% if (alreadyDone) { %>
      <h2><%= title %></h2>
      <p><%= message %></p>
    <% } else { %>
      <h2>Thank you! 🎉</h2>
      <p>
        Your review has been submitted.
        Our team will review it shortly and it'll appear on our website.
      </p>
    <% } %>

    <div class="d-flex gap-2 justify-content-center flex-wrap">
      <a href="/" class="ss-btn">
        <i class="fas fa-home me-2"></i>Back to Home
      </a>
      <a href="/reviews" class="ss-btn ss-btn-outline">
        <i class="fas fa-star me-2"></i>See All Reviews
      </a>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>