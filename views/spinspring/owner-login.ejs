<%- include('../layouts/main') %>

<style>
.auth-wrapper {
  min-height: 90vh;
  background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
  padding: 40px 15px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.auth-card {
  background: white;
  border-radius: 24px;
  padding: 40px;
  max-width: 460px;
  width: 100%;
  box-shadow: 0 25px 60px rgba(2,132,199,0.2);
}
.auth-card h2 {
  color: #0c4a6e;
  font-weight: 800;
  text-align: center;
  margin-bottom: 8px;
}
.auth-card .sub {
  text-align: center;
  color: #64748b;
  margin-bottom: 30px;
}
.auth-icon {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  color: white;
  font-size: 2rem;
}
</style>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-icon">
      <i class="fas fa-store"></i>
    </div>

    <h2>Owner Login</h2>
    <p class="sub">Manage your laundry business</p>

    <%- include('../partials/flash') %>

    <form method="POST" action="/login">
      <div class="mb-3">
        <label class="form-label fw-bold">Email Address</label>
        <input type="email" name="email" class="form-control" required
               placeholder="you@company.com" autocomplete="email">
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Password</label>
        <input type="password" name="password" class="form-control" required
               placeholder="••••••••" autocomplete="current-password">
      </div>

      <button type="submit" class="ss-btn w-100" style="padding:14px;">
        <i class="fas fa-sign-in-alt me-2"></i>Login
      </button>
    </form>

    <div class="text-center mt-4">
      <p class="text-muted mb-2">Don't have an account?</p>
      <a href="/register" class="ss-btn ss-btn-outline">
        <i class="fas fa-building me-2"></i>Register Company
      </a>
    </div>

    <div class="text-center mt-4 pt-3" style="border-top:1px solid #f1f5f9;">
      <a href="/attendant-login" class="text-muted small me-3">
        <i class="fas fa-user-tie me-1"></i>Attendant Login
      </a>
      <a href="/customer-login" class="text-muted small">
        <i class="fas fa-id-card me-1"></i>Customer Login
      </a>
    </div>

    <div class="text-center mt-3">
      <a href="/" class="text-muted small">
        <i class="fas fa-arrow-left me-1"></i>Back to home
      </a>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/pwa.js" defer></script>
</body>
</html>