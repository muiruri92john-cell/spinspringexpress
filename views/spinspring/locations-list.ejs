<%- include('../layouts/main') %>

<style>
.loc-card {
  background: white;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 4px 20px rgba(2, 132, 199, 0.08);
  border: 1px solid #e0f2fe;
  transition: all 0.3s;
  height: 100%;
}
.loc-card:hover {
  box-shadow: 0 8px 30px rgba(2, 132, 199, 0.15);
  transform: translateY(-2px);
}
.loc-card.primary { border: 2px solid #10b981; }
.loc-card.inactive { opacity: 0.6; }

.loc-badge {
  padding: 3px 10px;
  border-radius: 12px;
  font-size: 0.7rem;
  font-weight: 700;
}
.badge-primary-loc { background: #10b981; color: white; }
.badge-inactive { background: #e2e8f0; color: #64748b; }

.loc-meta { font-size: 0.85rem; color: #64748b; }
.loc-meta i { width: 20px; color: #0284c7; }

.loc-stats {
  display: flex;
  gap: 12px;
  padding-top: 12px;
  margin-top: 12px;
  border-top: 1px solid #f1f5f9;
}
.loc-stat { flex: 1; text-align: center; }
.loc-stat .v { font-weight: 800; color: #0284c7; font-size: 1.1rem; }
.loc-stat .l { font-size: 0.7rem; color: #64748b; text-transform: uppercase; }

.header-actions { display: flex; gap: 10px; align-items: center; }
</style>

<!-- NAV -->
<nav style="background:linear-gradient(135deg,#0284c7,#0ea5e9);padding:15px 0;">
  <div class="container d-flex justify-content-between align-items-center">
    <a href="/owner" style="color:white;text-decoration:none;">
      <i class="fas fa-arrow-left me-2"></i>Owner Dashboard
    </a>
    <a href="/owner/locations/new" class="btn btn-light btn-sm rounded-pill">
      <i class="fas fa-plus me-1"></i>New Location
    </a>
  </div>
</nav>

<div class="container py-4">
  <%- include('../partials/flash') %>

  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
    <div>
      <h2 style="color:#0c4a6e;">
        <i class="fas fa-map-marker-alt me-2"></i>Locations
      </h2>
      <p class="text-muted mb-0">Manage all your business branches</p>
    </div>
    <div class="header-actions">
      <a href="/owner" class="btn btn-outline-secondary rounded-pill">
        <i class="fas fa-tachometer-alt me-1"></i>Dashboard
      </a>
      <a href="/owner/locations/new" class="btn btn-primary rounded-pill px-4"
         style="background:#0284c7;border:none;">
        <i class="fas fa-plus me-2"></i>Add Location
      </a>
    </div>
  </div>

  <% if (locations.length === 0) { %>
    <div class="text-center py-5">
      <i class="fas fa-map-marked-alt fa-4x mb-3" style="color:#bae6fd;"></i>
      <h4 style="color:#0c4a6e;">No locations yet</h4>
      <p class="text-muted">Add your first branch to get started</p>
      <a href="/owner/locations/new" class="btn btn-primary rounded-pill px-4 mt-2"
         style="background:#0284c7;border:none;">
        <i class="fas fa-plus me-2"></i>Add First Location
      </a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% locations.forEach(loc => { %>
        <div class="col-md-6 col-lg-4">
          <div class="loc-card <%= loc.is_primary ? 'primary' : '' %> <%= !loc.is_active ? 'inactive' : '' %>">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div>
                <a href="/owner/locations/<%= loc.id %>" style="text-decoration:none;">
                  <h5 class="mb-1" style="color:#0c4a6e;"><%= loc.location_name %></h5>
                </a>
                <code style="font-size:0.75rem;color:#64748b;"><%= loc.location_code %></code>
              </div>
              <div class="d-flex flex-column gap-1">
                <% if (loc.is_primary) { %>
                  <span class="loc-badge badge-primary-loc">PRIMARY</span>
                <% } %>
                <% if (!loc.is_active) { %>
                  <span class="loc-badge badge-inactive">INACTIVE</span>
                <% } %>
              </div>
            </div>

            <div class="loc-meta mb-2">
              <div class="mb-1">
                <i class="fas fa-map-pin"></i> <%= loc.address_line1 %>
              </div>
              <% if (loc.address_line2) { %>
                <div class="mb-1"><i class="fas fa-map-pin"></i> <%= loc.address_line2 %></div>
              <% } %>
              <div class="mb-1"><i class="fas fa-city"></i> <%= loc.city %></div>
              <% if (loc.phone) { %>
                <div class="mb-1"><i class="fas fa-phone"></i> <%= loc.phone %></div>
              <% } %>
              <div class="mb-1">
                <i class="fas fa-clock"></i>
                <%= String(loc.opening_time || '08:00').slice(0, 5) %> -
                <%= String(loc.closing_time || '20:00').slice(0, 5) %>
              </div>
            </div>

            <div class="loc-stats">
              <div class="loc-stat">
                <div class="v"><%= loc.stats.device_count %></div>
                <div class="l">Devices</div>
              </div>
              <div class="loc-stat">
                <div class="v">Ksh <%= Number(loc.stats.today_revenue || 0).toLocaleString() %></div>
                <div class="l">Today</div>
              </div>
              <div class="loc-stat">
                <div class="v"><%= loc.stats.total_cycles %></div>
                <div class="l">Cycles</div>
              </div>
            </div>

            <div class="d-flex gap-2 mt-3 flex-wrap">
              <a href="/owner/locations/<%= loc.id %>"
                 class="btn btn-sm btn-primary rounded-pill flex-fill"
                 style="background:#0284c7;border:none;">
                <i class="fas fa-eye me-1"></i>View
              </a>
              <a href="/owner/locations/<%= loc.id %>/edit"
                 class="btn btn-sm btn-outline-primary rounded-pill flex-fill">
                <i class="fas fa-edit me-1"></i>Edit
              </a>
              <% if (!loc.is_primary) { %>
                <form method="POST" action="/owner/locations/<%= loc.id %>/primary">
                  <button type="submit" class="btn btn-sm btn-outline-success rounded-pill"
                          title="Set as primary">
                    <i class="fas fa-star"></i>
                  </button>
                </form>
              <% } %>
              <% if (loc.is_active) { %>
                <form method="POST" action="/owner/locations/<%= loc.id %>/delete"
                      onsubmit="return confirm('Deactivate this location?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill"
                          title="Deactivate">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>