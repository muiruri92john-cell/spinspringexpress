<%- include('../layouts/main') %>
<style>
.ss-error-wrap { min-height: 70vh; display:flex; align-items:center; justify-content:center; padding: 40px 15px; }
.ss-error-card { background:#fff; border-radius:24px; padding:40px; max-width:640px; width:100%; box-shadow:0 20px 60px rgba(2,132,199,.18); border:1px solid #e0f2fe; text-align:center; }
.ss-error-code { font-size:4rem; font-weight:800; color:#0284c7; line-height:1; }
.ss-error-detail { background:#0c4a6e; color:#e0f2fe; border-radius:12px; padding:15px; text-align:left; font-family:monospace; font-size:.8rem; white-space:pre-wrap; word-break:break-word; max-height:260px; overflow:auto; margin-top:15px; }
</style>
</head>
<body>
<div class="ss-error-wrap">
  <div class="ss-error-card">
    <div class="ss-error-code"><%= typeof status !== 'undefined' ? status : 500 %></div>
    <h3 class="mt-2" style="color:#0c4a6e;"><%= typeof title !== 'undefined' ? title : 'Something went wrong' %></h3>
    <p class="text-muted"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></p>
    <% if (typeof requestId !== 'undefined' && requestId) { %>
      <p><span class="badge bg-secondary">Ref: <%= requestId %></span></p>
    <% } %>
    <% if (typeof detail !== 'undefined' && detail) { %>
      <div class="ss-error-detail"><%= detail %></div>
    <% } %>
    <div class="d-flex gap-2 justify-content-center mt-4 flex-wrap">
      <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill">Go Back</a>
      <a href="/" class="btn btn-primary rounded-pill" style="background:#0284c7;border:none;">Home</a>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
