<%- include('../layouts/main') %>
<style>
.ss-nav { background: linear-gradient(135deg, #0284c7, #0ea5e9); padding: 15px 0; }
.ss-nav a { color: white !important; text-decoration: none; }
.ss-card {
  background: white;
  border-radius: 20px;
  padding: 30px;
  box-shadow: 0 5px 25px rgba(2,132,199,0.1);
  border: 1px solid #e0f2fe;
  margin-bottom: 20px;
}
.status-badge { padding: 5px 15px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; }
.status-queued { background: #fef3c7; color: #92400e; }
.status-in_progress { background: #dbeafe; color: #1e40af; }
.status-completed { background: #d1fae5; color: #065f46; }
.status-cancelled { background: #fee2e2; color: #991b1b; }
.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid #f1f5f9;
}
.detail-row:last-child { border-bottom: none; }
.detail-label { color: #64748b; font-weight: 500; }
.detail-value { font-weight: 600; color: #0c4a6e; }
.weight-highlight {
  background: #f0f9ff;
  border: 2px solid #bae6fd;
  border-radius: 12px;
  padding: 15px;
  text-align: center;
  margin: 15px 0;
}
.timeline {
  position: relative;
  padding-left: 25px;
}
.timeline::before {
  content: '';
  position: absolute;
  left: 8px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #e0f2fe;
}
.timeline-item {
  position: relative;
  margin-bottom: 20px;
}
.timeline-item::before {
  content: '';
  position: absolute;
  left: -22px;
  top: 5px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #0284c7;
  border: 2px solid white;
}
.timeline-item.completed::before { background: #10b981; }
.timeline-time { font-size: 0.75rem; color: #94a3b8; }
.timeline-title { font-weight: 600; color: #0c4a6e; }
</style>
</head>
<body>
<nav class="ss-nav">
  <div class="container">
    <a href="/spinspg/orders"><i class="fas fa-arrow-left me-2"></i> Back to Orders</a>
  </div>
</nav>

<div class="container py-4">
  <h2 class="mb-4" style="color:#0c4a6e;">Order Details</h2>

  <div class="row g-4">
    <div class="col-lg-6">
      <div class="ss-card">
        <h5 class="mb-3" style="color:#0c4a6e;">Order Information</h5>
        <div class="detail-row">
          <span class="detail-label">Order Number</span>
          <span class="detail-value"><%= order.order_number %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Machine</span>
          <span class="detail-value"><%= order.device_name || order.device_id %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Service Type</span>
          <span class="detail-value"><%= order.service_type.replace('_', ' → ').toUpperCase() %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Cycle Type</span>
          <span class="detail-value"><%= order.cycle_type.toUpperCase() %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Order Status</span>
          <span class="status-badge status-<%= order.order_status %>"><%= order.order_status %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Payment Status</span>
          <span class="status-badge payment-<%= order.payment_status %>"><%= order.payment_status %></span>
        </div>
      </div>

      <!-- Weight Pricing Breakdown -->
      <div class="ss-card">
        <h5 class="mb-3" style="color:#0c4a6e;">
          <i class="fas fa-weight me-2"></i>Weight Pricing Breakdown
        </h5>
        <div class="weight-highlight">
          <div style="font-size:2rem;font-weight:800;color:#0284c7;">
            <%= order.weight_kg ? order.weight_kg + ' kg' : 'N/A' %>
          </div>
          <small class="text-muted">Laundry Weight</small>
        </div>
        <div class="detail-row">
          <span class="detail-label">Weight</span>
          <span class="detail-value"><%= order.weight_kg ? order.weight_kg + ' kg' : 'N/A' %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Price per Kg</span>
          <span class="detail-value"><%= order.price_per_kg ? 'Ksh ' + order.price_per_kg : 'N/A' %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Weight Price</span>
          <span class="detail-value fw-bold" style="color:#0284c7;font-size:1.2rem;">
            Ksh <%= order.total_weight_price || order.price %>
          </span>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="ss-card">
        <h5 class="mb-3" style="color:#0c4a6e;">Customer Information</h5>
        <div class="detail-row">
          <span class="detail-label">Customer ID</span>
          <span class="detail-value"><%= order.customer_name || 'Walk-in' %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Order Created</span>
          <span class="detail-value"><%= new Date(order.created_at).toLocaleString() %></span>
        </div>
        <% if (order.start_time) { %>
        <div class="detail-row">
          <span class="detail-label">Started</span>
          <span class="detail-value"><%= new Date(order.start_time).toLocaleString() %></span>
        </div>
        <% } %>
        <% if (order.end_time) { %>
        <div class="detail-row">
          <span class="detail-label">Completed</span>
          <span class="detail-value"><%= new Date(order.end_time).toLocaleString() %></span>
        </div>
        <% } %>
      </div>

      <div class="ss-card">
        <h5 class="mb-3" style="color:#0c4a6e;">Order Progress</h5>
        <div class="timeline">
          <div class="timeline-item completed">
            <div class="timeline-time"><%= new Date(order.created_at).toLocaleTimeString() %></div>
            <div class="timeline-title">Order Created</div>
          </div>
          <% if (order.start_time) { %>
            <div class="timeline-item completed">
              <div class="timeline-time"><%= new Date(order.start_time).toLocaleTimeString() %></div>
              <div class="timeline-title">Cycle Started</div>
            </div>
          <% } %>
          <% if (order.order_status === 'completed') { %>
            <div class="timeline-item completed">
              <div class="timeline-time"><%= new Date(order.end_time).toLocaleTimeString() %></div>
              <div class="timeline-title">Cycle Completed</div>
            </div>
          <% } else { %>
            <div class="timeline-item">
              <div class="timeline-time">Pending...</div>
              <div class="timeline-title">Cycle In Progress</div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>