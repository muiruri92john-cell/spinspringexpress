<%- include('_header', { title: 'Order ready' }) %>

<h2 style="margin-top:0;color:#0f172a;">Your laundry is ready!</h2>

<p>Hi <%= customer.full_name %>,</p>

<p>Order <strong><%= order.order_number %></strong> from <strong><%= owner.company_name %></strong> is ready for pickup.</p>

<table cellpadding="10" cellspacing="0" style="border-collapse:collapse;margin:20px 0;background:#ecfdf5;border-radius:8px;width:100%;border-left:4px solid #10b981;">
  <tr>
    <td style="color:#065f46;font-size:13px;">Order Number</td>
    <td style="font-weight:700;font-family:monospace;color:#065f46;"><%= order.order_number %></td>
  </tr>
  <tr>
    <td style="color:#065f46;font-size:13px;">Status</td>
    <td style="font-weight:600;color:#10b981;">READY</td>
  </tr>
  <tr>
    <td style="color:#065f46;font-size:13px;">Amount Due</td>
    <td style="font-weight:700;color:#065f46;">KES <%= order.price %></td>
  </tr>
</table>

<p style="text-align:center;margin:32px 0;">
  <a href="<%= appUrl %>/customer" style="background:#10b981;color:#ffffff;padding:12px 28px;border-radius:8px;text-decoration:none;font-weight:600;display:inline-block;">View Order</a>
</p>

<%- include('_footer') %>
