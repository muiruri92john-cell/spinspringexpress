<%- include('_header', { title: 'Your new password' }) %>

<h2 style="margin-top:0;color:#0f172a;">Your password was reset</h2>

<p>Hi <%= customer.full_name %>,</p>

<p><strong><%= owner.contact_name %></strong> from <%= owner.company_name %> has reset your account password.</p>

<div style="background:#f0f9ff;border-left:4px solid #0ea5e9;padding:16px 20px;margin:24px 0;border-radius:6px;">
  <p style="margin:0;font-size:13px;color:#0369a1;text-transform:uppercase;letter-spacing:0.5px;">New Password</p>
  <p style="margin:8px 0 0;font-size:20px;font-weight:700;font-family:monospace;color:#0f172a;"><%= newPassword %></p>
</div>

<p style="text-align:center;margin:32px 0;">
  <a href="<%= appUrl %>/customer-login"
     style="background:#0ea5e9;color:#ffffff;padding:12px 28px;border-radius:8px;text-decoration:none;font-weight:600;display:inline-block;">
    Login Now
  </a>
</p>

<p style="color:#6b7280;font-size:13px;">
  Please change your password after logging in for the first time.
</p>

<%- include('_footer') %>