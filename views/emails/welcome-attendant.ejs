<%- include('_header', { title: 'Welcome to the team' }) %>

<h2 style="margin-top:0;color:#0f172a;">Welcome to the team, <%= attendant.full_name %>!</h2>

<p><strong><%= owner.contact_name %></strong> from <strong><%= owner.company_name %></strong> has added you as an attendant on <%= appName %>.</p>

<p>Your login details:</p>

<table cellpadding="8" cellspacing="0" style="border-collapse:collapse;margin:16px 0;background:#f9fafb;border-radius:8px;width:100%;">
  <tr>
    <td style="color:#6b7280;font-size:13px;">Email</td>
    <td style="font-weight:600;font-family:monospace;"><%= attendant.email %></td>
  </tr>
  <tr>
    <td style="color:#6b7280;font-size:13px;">PIN Code</td>
    <td style="font-weight:700;font-family:monospace;font-size:18px;color:#0ea5e9;"><%= attendant.pin_code %></td>
  </tr>
</table>

<p style="text-align:center;margin:32px 0;">
  <a href="<%= appUrl %>/attendant-login" style="background:#0ea5e9;color:#ffffff;padding:12px 28px;border-radius:8px;text-decoration:none;font-weight:600;display:inline-block;">Attendant Login</a>
</p>

<p style="color:#6b7280;font-size:13px;">Keep your PIN private.</p>

<%- include('_footer') %>
