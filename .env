# cPanel "Setup Node.js App" opens .env to show/edit environment
# variables, so keep a valid dotenv file here. Passenger ALSO injects the
# same variables at runtime — the two must match. (dotenv never overrides
# variables Passenger already injected; do NOT hard-code PORT here.)
DB_HOST=127.0.0.1
DB_USER=buxbtreu_spinspringuser
DB_PASSWORD=spinspring@2026
DB_NAME=buxbtreu_spinspringwebappdb
DB_PORT=3306
NODE_ENV=production
# Generate a long random secret and paste it here (same value must be set
# in cPanel >> Setup Node.js App >> Environment variables):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=45b51611583fbf1bf8c034f413fc75a950693e02771daf2115b5c4e702fa0440980a0f52acd898d07485c8d024d5ba36

