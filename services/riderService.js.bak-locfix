// services/riderService.js — Higher-level rider operations

const RiderModel = require('../models/rider');
const DeliveryRequestModel = require('../models/deliveryRequest');
const { haversineKm, calculateFee, DEFAULT_CONFIG } = require('./pricingService');
const pushSvc = require('./pushService');

/**
 * Create a pickup request and auto-assign the closest rider.
 * @returns {Object} { request_id, auto_assigned, rider_id, quoted_fee, distance_km }
 */
async function createPickupRequest(db, { ownerId, customerId, from, to, weight_kg, notes }) {
  const drModel = new DeliveryRequestModel(db);

  // 1. Calculate distance + fee (straight-line)
  let distance = null;
  let quoted = null;

  if (from.lat && from.lng && to.lat && to.lng) {
    const calc = calculateFee(from.lat, from.lng, to.lat, to.lng);
    distance = calc.distance;
    quoted = calc.fee;
  }

  // 2. Create the request
  const { id: requestId } = await drModel.create({
    owner_id: ownerId,
    customer_id: customerId,
    request_type: 'pickup',
    from_location_id: from.location_id || null,
    from_address: from.address || null,
    from_lat: from.lat || null,
    from_lng: from.lng || null,
    to_location_id: to.location_id || null,
    to_address: to.address || null,
    to_lat: to.lat || null,
    to_lng: to.lng || null,
    distance_km: distance,
    quoted_fee: quoted,
    weight_kg: weight_kg || null,
    notes: notes || null,
  });

  // 3. Auto-assign (only if we have a pickup point)
  let assignResult = { assigned: false };
  if (from.lat && from.lng) {
    const { autoAssign } = require('./deliveryService');
    assignResult = await autoAssign(db, requestId);
  }

  // 4. Notify customer (fire and forget)
  try {
    if (customerId) {
      // Look up customer email for email notification
      const [cust] = await db.query(
        'SELECT id, full_name, email FROM ss_customers WHERE id = ? LIMIT 1',
        [customerId]
      );
      if (cust.length && cust[0].email) {
        const { sendEmail } = require('./emailService');
        sendEmail({
          to: cust[0].email,
          subject: `Pickup request received — ${assignResult.assigned ? 'rider assigned' : 'finding rider'}`,
          template: 'pickup-requested',
          data: {
            customer: cust[0],
            request: { id: requestId, distance_km: distance, quoted_fee: quoted },
            rider_assigned: assignResult.assigned,
          },
          db,
        }).catch(e => console.error('pickup email failed:', e.message));
      }
    }
  } catch (e) {
    console.error('customer notify failed:', e.message);
  }

  return {
    request_id: requestId,
    distance_km: distance,
    quoted_fee: quoted,
    auto_assigned: assignResult.assigned,
    rider_id: assignResult.rider_id || null,
    reason: assignResult.reason || null,
  };
}

/**
 * Create a delivery request (return trip) after order is completed.
 */
async function createDeliveryRequest(db, { ownerId, customerId, orderId, from, to, fee }) {
  const drModel = new DeliveryRequestModel(db);

  let distance = null;
  if (from.lat && from.lng && to.lat && to.lng) {
    distance = haversineKm(from.lat, from.lng, to.lat, to.lng);
  }

  const { id: requestId } = await drModel.create({
    owner_id: ownerId,
    customer_id: customerId,
    order_id: orderId,
    request_type: 'delivery',
    from_location_id: from.location_id || null,
    from_address: from.address || null,
    from_lat: from.lat || null,
    from_lng: from.lng || null,
    to_location_id: to.location_id || null,
    to_address: to.address || null,
    to_lat: to.lat || null,
    to_lng: to.lng || null,
    distance_km: distance,
    quoted_fee: fee || null,
  });

  // Auto-assign
  let assignResult = { assigned: false };
  if (from.lat && from.lng) {
    const { autoAssign } = require('./deliveryService');
    assignResult = await autoAssign(db, requestId);
  }

  return {
    request_id: requestId,
    distance_km: distance,
    quoted_fee: fee,
    auto_assigned: assignResult.assigned,
    rider_id: assignResult.rider_id || null,
  };
}


/**
 * Dispatch a delivery for a completed order.
 * Auto-creates a delivery_request + auto-assigns the nearest rider.
 * @returns {Object} { ok, delivery_id, assigned, rider_id, reason }
 */
async function dispatchDeliveryForOrder(db, { orderId, ownerId }) {
  // 1. Load order + customer
  const [orderRows] = await db.query(
    `SELECT o.*, c.id AS cust_id, c.full_name AS cust_name, c.email AS cust_email,
            c.phone AS cust_phone, c.prefer_delivery, c.default_address,
            c.default_lat, c.default_lng
     FROM ss_orders o
     LEFT JOIN ss_customers c ON c.id = o.customer_id
     WHERE o.id = ? AND o.owner_id = ? LIMIT 1`,
    [orderId, ownerId]
  );
  if (!orderRows.length) return { ok: false, error: 'Order not found' };
  const order = orderRows[0];

  // 2. Check if delivery already exists
  if (order.delivery_request_id) {
    return { ok: false, error: 'Delivery already exists', delivery_id: order.delivery_request_id };
  }

  // 3. Check customer has required data
  if (!order.cust_id) return { ok: false, error: 'No customer on order' };
  if (!order.default_lat || !order.default_lng) {
    return { ok: false, error: 'Customer has no default delivery address / GPS' };
  }

  // 4. Load source branch (where the laundry is now)
  const [branchRows] = await db.query(
    `SELECT id, location_name, address_line1, latitude, longitude
     FROM ss_locations WHERE id = ? LIMIT 1`,
    [order.location_id]
  );
  if (!branchRows.length || !branchRows[0].latitude) {
    return { ok: false, error: 'Branch has no GPS coordinates' };
  }
  const branch = branchRows[0];

  // 5. Create the delivery request
  const { createDeliveryRequest } = module.exports;
  const result = await createDeliveryRequest(db, {
    ownerId,
    customerId: order.cust_id,
    orderId: order.id,
    from: {
      location_id: branch.id,
      address: branch.address_line1 || branch.location_name,
      lat: branch.latitude,
      lng: branch.longitude,
    },
    to: {
      address: order.default_address || 'Customer location',
      lat: order.default_lat,
      lng: order.default_lng,
    },
    fee: order.delivery_fee || null,
  });

  // 6. Link back to order
  try {
    await db.query(
      'UPDATE ss_orders SET delivery_request_id = ? WHERE id = ?',
      [result.request_id, order.id]
    );
  } catch (e) { console.error('link delivery failed:', e.message); }

  // 7. Notify customer
  try {
    const drModel = new DeliveryRequestModel(db);
    const deliveryReq = await drModel.findById(result.request_id);

    // Push to customer
    const pushSvc = require('./pushService');
    pushSvc.notifyCustomer(order.cust_id, {
      title: '🚴 Out for delivery',
      body: `Order ${order.order_number} on the way`,
      tag: `delivery-${order.order_number}`,
      data: { url: '/customer/pickups/' + result.request_id },
    }, db).catch(e => console.error('push delivery customer failed:', e.message));

    // Email to customer
    if (order.cust_email) {
      const { sendEmail } = require('./emailService');
      const rider = deliveryReq?.rider_id ? await db.query(
        'SELECT full_name, phone, vehicle_plate FROM ss_riders WHERE id = ? LIMIT 1',
        [deliveryReq.rider_id]
      ).then(r => r[0][0]) : null;

      sendEmail({
        to: order.cust_email,
        subject: `Your order ${order.order_number} is on the way`,
        template: 'order-out-for-delivery',
        data: {
          customer: { full_name: order.cust_name, email: order.cust_email },
          order: { order_number: order.order_number, price: order.price },
          owner: { company_name: 'SpinSpring Express' },
          rider: rider || null,
          eta_minutes: 20,
        },
        db,
      }).catch(e => console.error('delivery email failed:', e.message));
    }
  } catch (e) {
    console.error('delivery notify failed:', e.message);
  }

  return {
    ok: true,
    delivery_id: result.request_id,
    assigned: result.auto_assigned,
    rider_id: result.rider_id || null,
    distance_km: result.distance_km,
    reason: result.reason || null,
  };
}

/**
 * Dispatch a delivery for a completed order.
 * Auto-creates delivery_request + auto-assigns nearest rider.
 */
async function dispatchDeliveryForOrder(db, { orderId, ownerId }) {
  // 1. Load order + customer
  const [orderRows] = await db.query(
    `SELECT o.*, c.id AS cust_id, c.full_name AS cust_name, c.email AS cust_email,
            c.phone AS cust_phone, c.prefer_delivery, c.default_address,
            c.default_lat, c.default_lng
     FROM ss_orders o
     LEFT JOIN ss_customers c ON c.id = o.customer_id
     WHERE o.id = ? AND o.owner_id = ? LIMIT 1`,
    [orderId, ownerId]
  );
  if (!orderRows.length) return { ok: false, error: 'Order not found' };
  const order = orderRows[0];

  if (order.delivery_request_id) {
    return { ok: false, error: 'Delivery already exists', delivery_id: order.delivery_request_id };
  }
  if (!order.cust_id) return { ok: false, error: 'No customer on order' };
  if (!order.default_lat || !order.default_lng) {
    return { ok: false, error: 'Customer has no default GPS address' };
  }

  // 2. Load source branch
  const [branchRows] = await db.query(
    `SELECT id, location_name, address_line1, latitude, longitude
     FROM ss_locations WHERE id = ? LIMIT 1`,
    [order.location_id]
  );
  if (!branchRows.length || !branchRows[0].latitude) {
    return { ok: false, error: 'Branch has no GPS coordinates' };
  }
  const branch = branchRows[0];

  // 3. Create delivery request
  const result = await createDeliveryRequest(db, {
    ownerId,
    customerId: order.cust_id,
    orderId: order.id,
    from: {
      location_id: branch.id,
      address: branch.address_line1 || branch.location_name,
      lat: branch.latitude,
      lng: branch.longitude,
    },
    to: {
      address: order.default_address || 'Customer location',
      lat: order.default_lat,
      lng: order.default_lng,
    },
    fee: order.delivery_fee || null,
  });

  // 4. Link back to order
  try {
    await db.query(
      'UPDATE ss_orders SET delivery_request_id = ? WHERE id = ?',
      [result.request_id, order.id]
    );
  } catch (e) { console.error('link delivery failed:', e.message); }

  // 5. Notify customer
  try {
    const pushSvc = require('./pushService');
    pushSvc.notifyCustomer(order.cust_id, {
      title: '🚴 Out for delivery',
      body: `Order ${order.order_number} on the way`,
      tag: `delivery-${order.order_number}`,
      data: { url: '/customer/pickups/' + result.request_id },
    }, db).catch(e => console.error('push customer failed:', e.message));

    if (order.cust_email) {
      const { sendEmail } = require('./emailService');
      let rider = null;
      if (result.rider_id) {
        const [r] = await db.query(
          'SELECT full_name, phone, vehicle_plate FROM ss_riders WHERE id = ? LIMIT 1',
          [result.rider_id]
        );
        rider = r[0] || null;
      }

      sendEmail({
        to: order.cust_email,
        subject: `Your order ${order.order_number} is on the way`,
        template: 'order-out-for-delivery',
        data: {
          customer: { full_name: order.cust_name, email: order.cust_email },
          order: { order_number: order.order_number, price: order.price },
          owner: { company_name: 'SpinSpring Express' },
          rider: rider,
          eta_minutes: 20,
        },
        db,
      }).catch(e => console.error('delivery email failed:', e.message));
    }
  } catch (e) {
    console.error('delivery notify failed:', e.message);
  }

  return {
    ok: true,
    delivery_id: result.request_id,
    assigned: result.auto_assigned,
    rider_id: result.rider_id || null,
    distance_km: result.distance_km,
    reason: result.reason || null,
  };
}
module.exports = {
  createPickupRequest,
  createDeliveryRequest,
  dispatchDeliveryForOrder,
  dispatchDeliveryForOrder,
};
