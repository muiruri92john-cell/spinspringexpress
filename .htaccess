# SpinSpring Express — SAFE cPanel public_html/.htaccess (Apache 2.2 + 2.4 compatible)
# PASSENGER NOTE: when a Node.js app is registered for this domain in
# cPanel >> Setup Node.js App, Passenger handles routing BEFORE .htaccess.
# This file must NOT proxy/rewrite /health or / — doing so causes 403/404.
# It only forces HTTPS + protects files. Node serves /health and / itself.

# NOTE: "DirectoryIndex disabled" 500s on Apache 2.2 — keep the 2.4/2.2-safe form.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Protect sensitive files — Apache 2.2 + 2.4 compatible
<FilesMatch "^(\.env|\.git|server\.js|app\.js|package\.json|package-lock\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block direct access to app folders if wrongly uploaded inside public_html
<IfModule mod_rewrite.c>
  RewriteRule ^(node_modules|config|routes|views|tmp)/ - [R=404,L]
</IfModule>

# Disable directory listing (safe form)
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
